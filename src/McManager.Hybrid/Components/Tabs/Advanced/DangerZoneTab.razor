@inject AdvancedViewModel Vm
@inject Vm1ShapeScaleViewModel Scale
@inject JvmHeapViewModel Heap
@inject JvmExtraFlagsViewModel Flags
@inject DestroyInfrastructureViewModel Destroy
@implements IDisposable

<section class="mcm-danger-zone" aria-labelledby="mcm-danger-zone-title">
    <div>
        <h2 id="mcm-danger-zone-title" class="mcm-danger-zone-title">Danger Zone</h2>
        <p class="mcm-danger-zone-lede">
            Idle shutdown, VM size, server memory, extra JVM flags, and deleting the server. These settings can use up your free hours or delete the server for good. Emergency power is on Advanced → Status. Everyday Start and Stop stay in the sidebar.
        </p>
    </div>

    <div class="mcm-danger-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span class="mcm-danger-card-title">Idle shutdown</span>
            <button type="button"
                    class="mcm-help"
                    title="The idle timer shuts the server down when nobody is playing (or Minecraft is not running) so you stay on Always Free. Turn it off only for short tests. Starting Minecraft or restarting the game VM turns it back on.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About idle shutdown</span>
            </button>
        </div>
        <p style="margin:0 0 12px;font-size:13px;">
            For testing only. While off, the server is not stopped when empty or out of daily hours. It turns back on the next time Minecraft starts.
        </p>
        <label class="mcm-checkbox-row" style="margin:0;" for="mcm-dz-idle-enabled">
            <input id="mcm-dz-idle-enabled"
                   type="checkbox"
                   disabled="@Vm.IsBusy"
                   @bind="Vm.EditIdleAgentEnabled" />
            Automatically stop an empty or down server
        </label>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;">
            <button type="button"
                    disabled="@Vm.IsBusy"
                    @onclick="Vm.RefreshIdleFromOsAsync">
                Refresh from cloud
            </button>
            <button type="button"
                    class="mcm-primary"
                    disabled="@(!Vm.CanApplyIdleEnabled)"
                    @onclick="Vm.ApplyIdleEnabledAsync">
                Save changes
            </button>
        </div>

        <div style="display:grid;grid-template-columns:220px 1fr;gap:8px 12px;align-items:center;margin-top:16px;">
            <label for="mcm-dz-idle-timeout">Idle timeout (minutes)</label>
            <input id="mcm-dz-idle-timeout"
                   type="text"
                   class="mcm-num-input"
                   style="width:10rem;"
                   disabled="@Vm.IsBusy"
                   @bind="Vm.EditIdleTimeout"
                   @bind:event="oninput" />

            <label for="mcm-dz-budget-warn">Budget warning lead time (minutes)</label>
            <input id="mcm-dz-budget-warn"
                   type="text"
                   class="mcm-num-input"
                   style="width:10rem;"
                   disabled="@Vm.IsBusy"
                   @bind="Vm.EditBudgetWarn"
                   @bind:event="oninput" />
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;">
            <button type="button"
                    class="mcm-primary"
                    disabled="@(!Vm.CanApplyIdleTimeout)"
                    @onclick="Vm.ApplyIdleTimeoutSettingsAsync">
                Save timeout
            </button>
        </div>
    </div>

    <div class="mcm-danger-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span class="mcm-danger-card-title">Change VM size</span>
            <button type="button"
                    class="mcm-help"
                    title="CPUs and memory for the game VM. A bigger size uses Always Free hours faster. Shrinking to 12 GB sets server memory to 8G if it was higher. The server must be Stopped. Past usage keeps the size it was recorded at. Sizes above 4 OCPU / 24 GB are not offered yet.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About changing VM size</span>
            </button>
        </div>
        <p style="margin:0 0 12px;font-size:13px;">
            Current size: <strong>@Scale.CurrentSizeDisplay</strong>
            <span> · Game VM: @Scale.Vm1Lifecycle</span>
        </p>
        <p style="margin:0 0 10px;font-size:13px;">
            Stop the server from the sidebar before changing the size. Always Free sizes only, up to 4 OCPU / 24 GB.
        </p>
        <label class="mcm-radio-row">
            <input type="radio"
                   name="mcm-dz-vm1-shape"
                   disabled="@Scale.IsBusy"
                   checked="@Scale.TargetIsDefault"
                   @onchange="@(() => Scale.SelectDefaultShape())" />
            <span>
                4 OCPU / 24 GB (recommended)
                <span class="mcm-radio-note">More room for players and mods. Uses Always Free hours faster while the server is on.</span>
            </span>
        </label>
        <label class="mcm-radio-row">
            <input type="radio"
                   name="mcm-dz-vm1-shape"
                   disabled="@Scale.IsBusy"
                   checked="@(!Scale.TargetIsDefault)"
                   @onchange="@(() => Scale.SelectSmallerShape())" />
            <span>
                2 OCPU / 12 GB
                <span class="mcm-radio-note">Smaller Always Free size. More hours from the same CPU-hours; less room for mods or more players. Server memory above 8G becomes 8G.</span>
            </span>
        </label>
        <div class="mcm-shape-preview">@Scale.PreviewText</div>
        @if (!Scale.CanApply && !string.IsNullOrWhiteSpace(Scale.BlockedReason))
        {
            <p style="margin:0 0 12px;font-size:13px;color:var(--text-danger);">@Scale.BlockedReason</p>
        }
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;">
            <button type="button"
                    disabled="@Scale.IsBusy"
                    @onclick="Scale.RefreshAsync">
                Refresh size
            </button>
            <button type="button"
                    class="mcm-danger-btn"
                    disabled="@(!Scale.CanApply)"
                    @onclick="Scale.ApplyAsync">
                Apply size change
            </button>
        </div>
        <p style="margin:10px 0 0;font-size:13px;opacity:0.9;">@Scale.StatusMessage</p>
    </div>

    <div class="mcm-danger-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span class="mcm-danger-card-title">Server memory</span>
            <button type="button"
                    class="mcm-help"
                    title="Memory for Minecraft, not the whole VM. Default 4G for Vanilla. 8G still leaves about 4 GB for the OS. On the 24 GB size you can also pick 10G or 12G for heavier modpacks. Apply restarts Minecraft; the game VM stays on. Do not use /reload.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About server memory</span>
            </button>
        </div>
        <p style="margin:0 0 12px;font-size:13px;">
            Current server memory: <strong>@Heap.CurrentHeapDisplay</strong>
        </p>
        <p style="margin:0 0 10px;font-size:13px;">
            Apply works only while the server is Running. This does not change the VM size.
        </p>
        <label class="mcm-radio-row">
            <input type="radio"
                   name="mcm-dz-jvm-heap"
                   disabled="@Heap.IsBusy"
                   checked="@Heap.TargetIs4G"
                   @onchange="@(() => Heap.Select4G())" />
            <span>
                4G (default)
                <span class="mcm-radio-note">Enough for Vanilla and most Paper servers.</span>
            </span>
        </label>
        <label class="mcm-radio-row">
            <input type="radio"
                   name="mcm-dz-jvm-heap"
                   disabled="@Heap.IsBusy"
                   checked="@Heap.TargetIs6G"
                   @onchange="@(() => Heap.Select6G())" />
            <span>
                6G
                <span class="mcm-radio-note">More room for plugins or a larger world.</span>
            </span>
        </label>
        <label class="mcm-radio-row">
            <input type="radio"
                   name="mcm-dz-jvm-heap"
                   disabled="@Heap.IsBusy"
                   checked="@Heap.TargetIs8G"
                   @onchange="@(() => Heap.Select8G())" />
            <span>
                8G
                <span class="mcm-radio-note">Still leaves about 4 GB for the OS on the 12 GB size.</span>
            </span>
        </label>
        @if (Heap.ShowExtraPresets)
        {
            <label class="mcm-radio-row">
                <input type="radio"
                       name="mcm-dz-jvm-heap"
                       disabled="@Heap.IsBusy"
                       checked="@Heap.TargetIs10G"
                       @onchange="@(() => Heap.Select10G())" />
                <span>
                    10G
                    <span class="mcm-radio-note">More memory for heavier modpacks.</span>
                </span>
            </label>
            <label class="mcm-radio-row">
                <input type="radio"
                       name="mcm-dz-jvm-heap"
                       disabled="@Heap.IsBusy"
                       checked="@Heap.TargetIs12G"
                       @onchange="@(() => Heap.Select12G())" />
                <span>
                    12G
                    <span class="mcm-radio-note">More memory for heavier modpacks.</span>
                </span>
            </label>
        }
        @if (!Heap.CanApply && !string.IsNullOrWhiteSpace(Heap.BlockedReason))
        {
            <p style="margin:0 0 12px;font-size:13px;color:var(--text-danger);">@Heap.BlockedReason</p>
        }
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;">
            <button type="button"
                    class="mcm-danger-btn"
                    disabled="@(!Heap.CanApply)"
                    @onclick="Heap.ApplyAsync">
                Apply server memory
            </button>
        </div>
        <p style="margin:10px 0 0;font-size:13px;opacity:0.9;">@Heap.StatusMessage</p>
    </div>

    <div class="mcm-danger-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span class="mcm-danger-card-title">Extra JVM flags</span>
            <button type="button"
                    class="mcm-help"
                    title="Do not put -Xms or -Xmx here; set server memory on the card above. On Paper, saving an empty box restores the default flags. Save asks you to confirm, then restarts Minecraft. Do not use /reload.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About extra JVM flags</span>
            </button>
        </div>
        <p style="margin:0 0 10px;font-size:13px;">
            One flag per line (or spaces). Do not put -Xms or -Xmx here.
        </p>
        @if (!Flags.CanSave && !string.IsNullOrWhiteSpace(Flags.BlockedReason))
        {
            <p style="margin:0 0 12px;font-size:13px;color:var(--text-danger);">@Flags.BlockedReason</p>
        }
        <div class="mcm-field">
            <label for="mcm-dz-jvm-flags" class="sr-only">Extra JVM flags</label>
            <textarea id="mcm-dz-jvm-flags"
                      rows="6"
                      spellcheck="false"
                      disabled="@Flags.IsBusy"
                      @bind="Flags.FlagsText"
                      @bind:event="oninput"
                      style="font-family:var(--font-mono);font-size:12px;width:100%;"></textarea>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;">
            <button type="button"
                    disabled="@(!Flags.CanLoad)"
                    @onclick="Flags.LoadAsync">
                Reload from game VM
            </button>
            <button type="button"
                    class="mcm-danger-btn"
                    disabled="@(!Flags.CanSave)"
                    @onclick="Flags.SaveAsync">
                Save flags
            </button>
        </div>
        <p style="margin:10px 0 0;font-size:13px;opacity:0.9;">@Flags.StatusMessage</p>
    </div>

    <div class="mcm-danger-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span class="mcm-danger-card-title">Delete from Oracle Cloud</span>
            <button type="button"
                    class="mcm-help"
                    title="Deletes only what MCSTool created for this server. Nothing else in your Oracle account is deleted, and your account stays open.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About deleting from Oracle Cloud</span>
            </button>
        </div>
        <p style="margin:0 0 12px;font-size:13px;">
            Delete this server from Oracle Cloud, for example to run Setup again. World backups in cloud storage are deleted too. Your Oracle account stays open.
        </p>
        <button type="button"
                class="mcm-danger-btn"
                disabled="@Vm.IsBusy"
                title="Opens a confirm window. Type confirm to delete. The window stays open until Oracle finishes."
                @onclick="Destroy.Open">
            Delete from Oracle Cloud
        </button>
    </div>

    @* v1 later (do not implement here): Paid / spend mode — Step 8.1 *@
</section>

@code {
    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnVmChanged;
        Scale.PropertyChanged += OnScaleChanged;
        Heap.PropertyChanged += OnHeapChanged;
        Flags.PropertyChanged += OnFlagsChanged;
        _ = Scale.RefreshAsync();
        Flags.OnPaneSelected();
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnVmChanged;
        Scale.PropertyChanged -= OnScaleChanged;
        Heap.PropertyChanged -= OnHeapChanged;
        Flags.PropertyChanged -= OnFlagsChanged;
    }

    private void OnVmChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnScaleChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnHeapChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnFlagsChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);
}
