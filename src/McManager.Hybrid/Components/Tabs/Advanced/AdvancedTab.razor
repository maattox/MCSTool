@inject AdvancedViewModel Vm
@implements IDisposable

<div class="mcm-pane-stack">
    <nav class="mcm-subtabs" role="tablist" aria-label="Advanced sections">
        <button type="button"
                role="tab"
                class="mcm-subtab @PaneClass("status")"
                aria-selected="@(IsPane("status") ? "true" : "false")"
                @onclick="@(() => SelectPane("status"))">
            Status
        </button>
        <button type="button"
                role="tab"
                class="mcm-subtab @PaneClass("stack")"
                aria-selected="@(IsPane("stack") ? "true" : "false")"
                @onclick="@(() => SelectPane("stack"))">
            Stack
        </button>
        <button type="button"
                role="tab"
                class="mcm-subtab @PaneClass("danger")"
                aria-selected="@(IsPane("danger") ? "true" : "false")"
                @onclick="@(() => SelectPane("danger"))">
            Danger
        </button>
    </nav>

    @if (IsPane("status"))
    {
    <div class="mcm-pane-stack" role="tabpanel">
    <div class="mcm-section-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:10px;">
            <span style="font-size:14px;font-weight:600;">Technical status</span>
            <button type="button"
                    class="mcm-help"
                    title="The top of the window only shows whether Minecraft is Running or Stopped. Door / VM details live here.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About technical status</span>
            </button>
        </div>
        <div style="display:grid;grid-template-columns:180px 1fr;gap:8px 12px;align-items:center;">
            <span style="color:var(--text-muted);">Game VM (VM1)</span>
            <span style="font-family:var(--font-mono);">@Vm.GameVmLifecycle</span>
            <span style="color:var(--text-muted);">Door VM (VM2)</span>
            <span style="font-family:var(--font-mono);">@Vm.DoorVmLifecycle</span>
            <span style="color:var(--text-muted);">Door service</span>
            <span style="font-family:var(--font-mono);">@Vm.DoorServiceState</span>
        </div>
    </div>

    <div class="mcm-section-card">
        <div style="font-size:14px;font-weight:600;margin-bottom:6px;">Break-glass VM power</div>
        <p style="margin:0 0 10px;font-size:13px;color:var(--text-secondary);">
                    These start or stop the game VM in Oracle Cloud and do not move the play IP. Everyday Start / Stop in the left sidebar are the doorbell-aware path players should use.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
            <button type="button"
                    disabled="@Vm.IsBusy"
                    title="OCI Compute start only. Does not move the reserved play IP."
                    @onclick="Vm.BreakGlassStartAsync">
                Raw VM Start
            </button>
            <button type="button"
                    disabled="@Vm.IsBusy"
                    title="OCI Compute stop only. Does not move the reserved play IP."
                    @onclick="Vm.BreakGlassSoftStopAsync">
                Raw VM SoftStop
            </button>
        </div>
    </div>
    </div>
    }
    else if (IsPane("stack"))
    {
    <div class="mcm-pane-stack" role="tabpanel">
    <div class="mcm-section-card">
        <div style="font-size:14px;font-weight:600;margin-bottom:6px;">Infrastructure setup</div>
        <p style="margin:0 0 10px;font-size:13px;color:var(--text-secondary);">
            Deploy a new Always Free stack, repair an existing one, or attach this PC to a stack that is already in your tenancy. Auto-detect never runs by itself — only when you click the button.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
            <button type="button"
                    title="Opens Setup. Resume or re-run from here after a finished Deploy page (do not click Deploy twice on the same finished page). Does not run OpenTofu from this button."
                    @onclick="Vm.OpenSetup">
                Deploy / repair infrastructure
            </button>
            <button type="button"
                    disabled="@Vm.IsBusy"
                    title="Looks for a product compartment and shared storage, then asks before writing local config."
                    @onclick="Vm.AutoDetectAsync">
                Auto-detect infrastructure
            </button>
        </div>
    </div>

    <div class="mcm-section-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span style="font-size:14px;font-weight:600;">SSH keys (this PC)</span>
            <button type="button"
                    class="mcm-help"
                    title="@Vm.SshKeyHelp">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About SSH keys</span>
            </button>
        </div>
        <p style="margin:0 0 10px;font-size:13px;color:var(--text-secondary);">
            Game VM and doorbell can use different private keys. Paths stay on this PC. Changing a path does not install a new key on the VM.
        </p>
        @if (Vm.SshKeysUseSameFile)
        {
            <p style="margin:0 0 10px;font-size:12px;color:var(--text-muted);">Both VMs currently use the same file.</p>
        }
        <ul class="mcm-path-list">
            <li class="mcm-path-row">
                <div class="mcm-path-copy">
                    <span class="mcm-path-label">Game VM (VM1)</span>
                    <span class="mcm-path-hint">Used for Minecraft, world, pack, and idle-agent SSH.</span>
                    <code class="mcm-path-value @(Vm.Vm1SshKeyMissing ? "is-missing" : null)">
                        @(string.IsNullOrWhiteSpace(Vm.EditVm1SshKeyPath) ? "—" : Vm.EditVm1SshKeyPath)
                    </code>
                </div>
                <div class="mcm-path-actions">
                    <button type="button"
                            disabled="@Vm.IsBusy"
                            title="Choose a private key file for the game VM"
                            @onclick="Vm.BrowseVm1SshKeyAsync">
                        Browse
                    </button>
                    <button type="button"
                            disabled="@(Vm.IsBusy || Vm.Vm1SshKeyMissing)"
                            title="Try SSH with the selected key. The game VM must be Running."
                            @onclick="Vm.TestVm1SshAsync">
                        Test
                    </button>
                    @if (Vm.CanCopyDoorKeyToVm1)
                    {
                        <button type="button"
                                title="Use the doorbell private key for the game VM too"
                                @onclick="Vm.CopyDoorKeyToVm1">
                            Use door key
                        </button>
                    }
                </div>
            </li>
            <li class="mcm-path-row">
                <div class="mcm-path-copy">
                    <span class="mcm-path-label">Door VM</span>
                    <span class="mcm-path-hint">Used for doorbell troubleshooting and repair SSH.</span>
                    <code class="mcm-path-value @(Vm.DoorSshKeyMissing ? "is-missing" : null)">
                        @(string.IsNullOrWhiteSpace(Vm.EditDoorSshKeyPath) ? "—" : Vm.EditDoorSshKeyPath)
                    </code>
                </div>
                <div class="mcm-path-actions">
                    <button type="button"
                            disabled="@Vm.IsBusy"
                            title="Choose a private key file for the doorbell VM"
                            @onclick="Vm.BrowseDoorSshKeyAsync">
                        Browse
                    </button>
                    <button type="button"
                            disabled="@(Vm.IsBusy || Vm.DoorSshKeyMissing)"
                            title="Try SSH with the selected key. The doorbell VM is usually always on."
                            @onclick="Vm.TestDoorSshAsync">
                        Test
                    </button>
                    @if (Vm.CanCopyVm1KeyToDoor)
                    {
                        <button type="button"
                                title="Use the game VM private key for the doorbell too"
                                @onclick="Vm.CopyVm1KeyToDoor">
                            Use game VM key
                        </button>
                    }
                </div>
            </li>
        </ul>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;">
            <button type="button"
                    class="mcm-primary"
                    disabled="@(!Vm.CanSaveSshKeys)"
                    @onclick="Vm.SaveSshKeysAsync">
                Save SSH keys
            </button>
        </div>
    </div>

    <div class="mcm-section-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span style="font-size:14px;font-weight:600;">Stack identity (shared storage)</span>
            <button type="button"
                    class="mcm-help"
                    title="Publishes a description of this stack so another PC can Auto-detect it. Never includes SSH keys, API keys, or the RCON password.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About stack identity</span>
            </button>
        </div>
        <p style="margin:0 0 12px;font-size:12px;opacity:0.85;font-family:var(--font-mono);white-space:pre-wrap;">@Vm.InfraSummary</p>
        <div style="display:grid;grid-template-columns:200px 1fr;gap:8px 12px;align-items:center;">
            <label for="mcm-adv-stack-version">stack_version</label>
            <input id="mcm-adv-stack-version"
                   type="text"
                   disabled="@Vm.IsBusy"
                   @bind="Vm.EditStackVersion"
                   @bind:event="oninput" />

            <label for="mcm-adv-server-kind">server_kind</label>
            <input id="mcm-adv-server-kind"
                   type="text"
                   disabled="@Vm.IsBusy"
                   @bind="Vm.EditServerKind"
                   @bind:event="oninput" />

            <label for="mcm-adv-mc-version">minecraft_version</label>
            <input id="mcm-adv-mc-version"
                   type="text"
                   disabled="@Vm.IsBusy"
                   @bind="Vm.EditMinecraftVersion"
                   @bind:event="oninput" />
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;">
            <button type="button"
                    disabled="@Vm.IsBusy"
                    @onclick="Vm.RefreshInfraMetaAsync">
                Refresh infra meta
            </button>
            <button type="button"
                    class="mcm-primary"
                    disabled="@(!Vm.CanPublishInfra)"
                    @onclick="Vm.PublishInfraMetaAsync">
                Save changes
            </button>
        </div>
    </div>

    @if (UiHostProbes.Enabled)
    {
        <div class="mcm-section-card">
            <div style="font-size:14px;font-weight:600;margin-bottom:6px;">DEBUG host probes</div>
            <p style="margin:0 0 8px;font-size:13px;color:var(--text-secondary);">
                Debug builds only. Confirms the confirm modal, clipboard, native file picker, local .mrpack / server-pack zip analyze (no install), spend-brake overlay fixture, and a fake bell notification still work.
            </p>
            <HostServiceProbes />
        </div>
    }
    </div>
    }
    else
    {
    <div class="mcm-pane-stack" role="tabpanel">
        <DangerZoneTab />
    </div>
    }
</div>

@code {
    private string _pane = "status";

    private bool IsPane(string id) => string.Equals(_pane, id, StringComparison.Ordinal);

    private string PaneClass(string id) => IsPane(id) ? "is-active" : "";

    private void SelectPane(string pane) => _pane = pane;

    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnVmChanged;
        Vm.OnTabSelected();
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnVmChanged;
        Vm.OnTabLeft();
    }

    private void OnVmChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);
}
