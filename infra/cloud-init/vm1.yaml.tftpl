#cloud-config
# VM1 OS baseline only. Do not install Minecraft, a Java major, loaders, or RCON.
# Directory ownership SoT is onbox/mcmgr/common/layout.sh (blueprint §5).
# Never chown -R /opt/mcmgr — server/ is mcmgr:mcmgr, parent is root:mcmgr.
hostname: mcmgr-vm1
fqdn: mcmgr-vm1
manage_etc_hosts: localhost
package_update: true
# Same as door: update indexes only. Kernel "restart required" is not a Setup reboot.
package_upgrade: false

groups:
  - mcmgr

users:
  - default
  - name: mcmgr
    system: true
    primary_group: mcmgr
    homedir: /opt/mcmgr/server
    shell: /usr/sbin/nologin
    lock_passwd: true

packages:
  - jq
  - unzip
  - curl
  - ca-certificates
  - firewalld
  - gnupg

runcmd:
  - mkdir -p /opt/mcmgr/server /opt/mcmgr/backups-work /opt/mcmgr/bin /etc/mcmgr /var/lib/mcmgr
  - chown root:mcmgr /opt/mcmgr /opt/mcmgr/bin /etc/mcmgr
  - chmod 0750 /opt/mcmgr /opt/mcmgr/bin /etc/mcmgr
  - chown mcmgr:mcmgr /opt/mcmgr/server /opt/mcmgr/backups-work
  - chmod 0750 /opt/mcmgr/server /opt/mcmgr/backups-work
  - chown root:root /var/lib/mcmgr
  - chmod 0750 /var/lib/mcmgr
  - curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg
  - echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb jammy main" > /etc/apt/sources.list.d/adoptium.list
  - apt-get update
  # Oracle Ubuntu images enable netfilter-persistent (SSH-only INPUT REJECT).
  # That Conflicts= with firewalld, so after the first reboot firewalld stays
  # dead and :25565 is closed (wait_forge + public play). Disable it first.
  - systemctl disable --now netfilter-persistent || true
  - systemctl mask netfilter-persistent || true
  - systemctl unmask firewalld || true
  - systemctl enable --now firewalld
  - firewall-cmd --permanent --add-service=ssh
  - firewall-cmd --permanent --add-port=25565/tcp
  - firewall-cmd --permanent --add-port=25565/udp
  - firewall-cmd --reload
  # Marker last. /etc/mcmgr is 0750 root:mcmgr (blueprint §5) — ubuntu cannot test -f
  # this path. Setup WaitCloudInitAsync uses sudo -n (SETUP-ISSUE-5). Do not chmod 0755.
  - date -u +%Y-%m-%dT%H:%M:%SZ > /etc/mcmgr/cloud-init-done
