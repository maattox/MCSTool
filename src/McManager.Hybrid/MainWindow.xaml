<Window x:Class="McManager.Hybrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:components="clr-namespace:McManager.Hybrid.Components"
        mc:Ignorable="d"
        Title="MC Server Manager"
        WindowStyle="None"
        ResizeMode="CanResize"
        Height="720"
        Width="1280"
        MinHeight="560"
        MinWidth="920"
        Background="#161A21">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="10"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- WebView fills the client so the 6px painted strips are gone. WindowChrome
         ResizeBorderThickness (outer) plus WM_NCHITTEST in WpfWindowChromeService
         (inner ~10 DIP) keep CanResize working over the WebView2 HWND. -->
    <blazor:BlazorWebView x:Name="HostView"
                          HostPage="wwwroot\index.html"
                          Services="{DynamicResource services}"
                          BlazorWebViewInitialized="OnBlazorWebViewInitialized">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:App}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
