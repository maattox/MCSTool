@inject ServerManagementViewModel Vm
@implements IDisposable

<div>
    <div style="display:grid;grid-template-columns:repeat(4, minmax(0,1fr));gap:12px;margin-bottom:1.25rem;">
        <div class="mcm-info-card">
            <div style="font-size:13px;color:var(--text-muted);">Server name</div>
            <div style="font-size:16px;font-weight:500;margin-top:4px;">@Vm.ServerNameDisplay</div>
        </div>
        <div class="mcm-info-card">
            <div style="font-size:13px;color:var(--text-muted);">Minecraft version</div>
            <div style="font-size:16px;font-weight:500;margin-top:4px;">@Vm.MinecraftVersionDisplay</div>
        </div>
        <div class="mcm-info-card">
            <div style="font-size:13px;color:var(--text-muted);">Last backup</div>
            <div style="font-size:16px;font-weight:500;margin-top:4px;">@Vm.LastBackupDisplay</div>
        </div>
        <div class="mcm-info-card">
            <div style="font-size:13px;color:var(--text-muted);">Backup storage</div>
            <div style="font-size:16px;font-weight:500;margin-top:4px;">@Vm.BackupStorageDisplay</div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
    {
        <p style="margin:0 0 8px;opacity:0.85;font-size:13px;white-space:pre-wrap;">@Vm.StatusMessage</p>
    }
    @if (!string.IsNullOrWhiteSpace(Vm.ProgressDisplay))
    {
        <p style="margin:0 0 12px;opacity:0.65;font-size:12px;">@Vm.ProgressDisplay</p>
    }

    <div class="mcm-section-card" style="margin-bottom:1.25rem;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:8px;">
            <div style="display:flex;align-items:center;gap:4px;">
                <span style="font-size:14px;font-weight:500;">Modding</span>
                <button type="button"
                        class="mcm-help"
                        title="@Vm.ModdingHelpTitle">
                    <i class="ti ti-help" aria-hidden="true"></i>
                    <span class="sr-only">About Modding</span>
                </button>
            </div>
            @if (Vm.IsModdedServer)
            {
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <button type="button"
                            disabled="@(!Vm.CanDownloadPack)"
                            title="@Vm.DownloadPackTitle"
                            @onclick="Vm.DownloadPackAsync">
                        <i class="ti ti-download" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                        Download pack
                    </button>
                    <button type="button"
                            disabled="@Vm.AnyBusy"
                            title="List server-side mods on the game VM. Requires the VM running."
                            @onclick="Vm.RefreshLiveModsAsync">
                        <i class="ti ti-refresh" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                        Refresh list
                    </button>
                </div>
            }
        </div>

        @if (!Vm.IsModdedServer)
        {
            <p style="margin:0;font-size:13px;color:var(--text-muted);">@Vm.VanillaEmptyState</p>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(Vm.PackIdentityDisplay))
            {
                <p style="margin:0 0 8px;font-size:13px;">@Vm.PackIdentityDisplay</p>
            }
            @if (!Vm.HasLocalPackArchive)
            {
                <p style="margin:0 0 8px;font-size:13px;color:var(--text-muted);">@Vm.MissingArchiveMessage</p>
            }
            @if (!string.IsNullOrWhiteSpace(Vm.ModdingSummary))
            {
                <p style="margin:0 0 8px;font-size:13px;color:var(--text-secondary);">@Vm.ModdingSummary</p>
            }
            @if (!string.IsNullOrWhiteSpace(Vm.ModdingHint))
            {
                <p style="margin:0 0 8px;font-size:13px;color:var(--text-muted);">@Vm.ModdingHint</p>
            }
            @if (Vm.ModFiles.Count > 0)
            {
                <div class="mcm-mod-list">
                    @foreach (var name in Vm.ModFiles)
                    {
                        <div class="mcm-mod-row">@name</div>
                    }
                </div>
            }
        }
    </div>

    <div class="mcm-section-card">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:8px;">
            <div style="display:flex;align-items:center;gap:4px;">
                <span style="font-size:14px;font-weight:500;">World backups</span>
                <button type="button"
                        class="mcm-help"
                        title="@Vm.WorldBackupsHelpTitle">
                    <i class="ti ti-help" aria-hidden="true"></i>
                    <span class="sr-only">About World backups</span>
                </button>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <button type="button"
                        disabled="@Vm.AnyBusy"
                        title="Store a zip in cloud storage. This does not replace the live world until you use Replace."
                        @onclick="Vm.UploadAsync">
                    <i class="ti ti-upload" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                    Upload backup
                </button>
                <button type="button"
                        disabled="@Vm.AnyBusy"
                        title="@Vm.DownloadLatestTitle"
                        @onclick="Vm.DownloadLatestAsync">
                    <i class="ti ti-download" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                    @Vm.DownloadLatestButtonLabel
                </button>
                <button type="button"
                        class="mcm-danger-btn"
                        disabled="@Vm.AnyBusy"
                        title="Deletes the live world on the game VM. Cloud backups, mods, and server.properties stay. Requires the server running. Download a world save first if you might want this world back."
                        @onclick="Vm.WipeWorldAsync">
                    Wipe world
                </button>
                <button type="button"
                        disabled="@Vm.AnyBusy"
                        title="Requires the server to be running. Stops Minecraft, replaces the world, then starts it again."
                        @onclick="Vm.ReplaceWorldAsync">
                    Replace world
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Vm.OversizedBanner))
        {
            <div class="mcm-oversized-banner" role="status">
                <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                <p>@Vm.OversizedBanner</p>
            </div>
        }

        @foreach (var backup in Vm.Backups)
        {
            <div class="mcm-bk-row">
                <div>
                    <div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@backup.FileName</div>
                    <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">@backup.TimeDisplayLocal</div>
                </div>
                <div style="color:var(--text-muted);">@backup.SizeDisplay</div>
                <div class="mcm-bk-actions">
                    <button type="button"
                            style="font-size:12px;padding:3px 8px;"
                            disabled="@Vm.AnyBusy"
                            @onclick="@(() => Vm.DownloadBackupAsync(backup))">
                        Download
                    </button>
                </div>
            </div>
        }

        @if (Vm.HasObjectStorage && !string.IsNullOrWhiteSpace(Vm.SoftCapDisplay) && Vm.SoftCapDisplay != "—")
        {
            <p style="margin:10px 0 0;font-size:12px;color:var(--text-muted);">@Vm.SoftCapDisplay</p>
        }
    </div>

    <p style="margin:12px 0 0;font-size:12px;color:var(--text-muted);">
        Replace and Wipe world need the server running. Wipe deletes only the live save — cloud backups stay. Download a world save first if you might want this world back. Upload while stopped only stores a zip — Start, then Replace to apply it. If a world is too large for cloud backup, Download latest copies the live world over SSH instead.
    </p>
</div>

@code {
    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnVmChanged;
        Vm.Backups.CollectionChanged += OnBackupsChanged;
        Vm.ModFiles.CollectionChanged += OnModsChanged;
        _ = Vm.RefreshAsync();
        _ = Vm.RefreshMinecraftVersionAsync();
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnVmChanged;
        Vm.Backups.CollectionChanged -= OnBackupsChanged;
        Vm.ModFiles.CollectionChanged -= OnModsChanged;
    }

    private void OnVmChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnBackupsChanged(object? sender, NotifyCollectionChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnModsChanged(object? sender, NotifyCollectionChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);
}
