@inject HybridShell Shell
@inject AppUpdateCheckHost UpdateCheck
@implements IDisposable

@if (Shell.Page == HybridShell.PageKind.FirstRun)
{
    <FirstRun />
}
else if (Shell.Page == HybridShell.PageKind.Setup)
{
    <SetupWizard />
}
else
{
    <MainLayout />
}
<ModalHost />
@* Destroy dialog is Manage-only so first-run/Setup do not construct MainViewModel
   before config.local.json exists. ReloadFromDisk still rebinds if they already were. *@
@if (Shell.Page == HybridShell.PageKind.Manage)
{
    <DestroyInfrastructureDialog />
    <SpendBrakeLockOverlay />
}

@code {
    protected override void OnInitialized()
    {
        Shell.PropertyChanged += OnShellChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _ = UpdateCheck.RunOnceAsync();
    }

    public void Dispose()
    {
        Shell.PropertyChanged -= OnShellChanged;
    }

    private void OnShellChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);
}
