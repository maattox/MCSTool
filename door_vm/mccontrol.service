[Unit]
Description=MCControl doorbell and budget control plane (VM2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mccontrol
Environment=TZ=America/Los_Angeles
EnvironmentFile=-/etc/mccontrol/oci.env
ExecStart=/opt/mccontrol/build/mccontrol /etc/mccontrol/config.json
# Player map static HTTP binds TCP 80 from this root process (User=root).
# If User= is ever dropped, add AmbientCapabilities=CAP_NET_BIND_SERVICE.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
