[Unit]
Description=Minecraft server
After=network-online.target mc-boot-ledger.service
Wants=network-online.target mc-boot-ledger.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=mcmgr
Group=mcmgr
WorkingDirectory={{WORKING_DIRECTORY}}
ExecStart={{EXECUTABLE}} {{ARGS_JOINED}}
ExecStop=+{{BIN_DIR}}/rcon-graceful-stop.sh
TimeoutStopSec=120
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=200
Environment=LANG=C.UTF-8
Environment=JAVA_TOOL_OPTIONS=-Djava.net.preferIPv4Stack=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=minecraft

# Light sandboxing — does not block legitimate mod/plugin file access under server_dir
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{WORKING_DIRECTORY}}
ProtectHome=true
# ImageIO writes /tmp/imageio*.tmp when encoding the 64x64 list favicon.
# Without a private tmp, ProtectSystem=strict makes that a read-only filesystem
# ("Couldn't load server icon" / "Can't create cache file!").
PrivateTmp=true

[Install]
WantedBy=multi-user.target
