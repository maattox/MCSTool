@inject TroubleshootingViewModel Vm
@implements IDisposable

<div class="mcm-pane-stack">
    <p style="margin:0;font-size:13px;color:var(--text-secondary);">
        One-click fixes for common problems.
    </p>

    <div class="mcm-card-grid">
    <div class="mcm-section-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span style="font-size:14px;font-weight:600;">Play IP</span>
            <button type="button"
                    class="mcm-help"
                    title="The play IP is the address players use to join. It moves between the doorbell VM and the game VM, and sometimes ends up on the wrong one.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About the play IP</span>
            </button>
        </div>
        <p style="margin:0 0 10px;font-size:13px;color:var(--text-secondary);">
            Use Fix play IP if the server is running but players can't connect, or the server is off but the play IP is still on the game VM. Also use it after the $1 spending limit stops both VMs.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
            <button type="button"
                    disabled="@Vm.IsBusy"
                    title="Moves the play IP to the game VM if it is running, otherwise to the doorbell VM."
                    @onclick="Vm.ParkPlayIpAsync">
                Fix play IP
            </button>
            <button type="button"
                    disabled="@Vm.IsBusy"
                    title="Restores the play IP network settings on each running VM."
                    @onclick="Vm.ReapplyNetplanAsync">
                Restore play IP network settings
            </button>
        </div>
    </div>

    <div class="mcm-section-card">
        <div style="font-size:14px;font-weight:600;margin-bottom:6px;">Doorbell state</div>
        <p style="margin:0 0 10px;font-size:13px;color:var(--text-secondary);">
            Use Check doorbell wake if the doorbell VM is stuck on Starting after Minecraft is up. Checking changes nothing. Reset doesn't move the play IP.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
            <button type="button" disabled="@Vm.IsBusy" @onclick="Vm.DiagnoseWaitForgeAsync">
                Check doorbell wake
            </button>
            <button type="button" disabled="@Vm.IsBusy" @onclick="Vm.ResetDoorStateAsync">
                Reset doorbell
            </button>
            <button type="button" disabled="@Vm.IsBusy" @onclick="Vm.UnstickDoorAsync">
                Unstick after game is up
            </button>
        </div>
    </div>

    <div class="mcm-section-card">
        <div style="font-size:14px;font-weight:600;margin-bottom:6px;">Budget and hours</div>
        <p style="margin:0 0 10px;font-size:13px;color:var(--text-secondary);">
            Refresh doorbell hours reloads the budget and hours on the doorbell VM. Use Fix hours record only when the game VM is already stopped.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
            <button type="button" disabled="@Vm.IsBusy" @onclick="Vm.RefreshOsBudgetAsync">
                Refresh doorbell hours
            </button>
            <button type="button" disabled="@Vm.IsBusy" @onclick="Vm.HealLedgerAsync">
                Fix hours record
            </button>
        </div>
    </div>

    <div class="mcm-section-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span style="font-size:14px;font-weight:600;">Game VM / idle timer</span>
            <button type="button"
                    class="mcm-help"
                    title="The idle timer turns back on whenever the game VM boots or Minecraft starts.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About Game VM / idle timer</span>
            </button>
        </div>
        <p style="margin:0 0 10px;font-size:13px;color:var(--text-secondary);">
            Repair game permissions sets folder access the same way Setup does. Turning the idle timer back on doesn't start Minecraft. Restarting the game VM also turns it back on.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px;">
            <button type="button" disabled="@Vm.IsBusy" @onclick="Vm.ShowIdleStatusAsync">
                Idle timer status
            </button>
            <button type="button" disabled="@Vm.IsBusy" @onclick="Vm.ForceEnableIdleAsync">
                Turn idle timer back on
            </button>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
            <button type="button" disabled="@Vm.IsBusy" @onclick="Vm.DiagnoseMinecraftAsync">
                Check Minecraft folder access
            </button>
            <button type="button" disabled="@Vm.IsBusy" @onclick="Vm.RepairPermissionsAsync">
                Repair game permissions
            </button>
        </div>
        <p style="margin:10px 0 0;font-size:12px;color:var(--text-muted);">
            If the game VM is stuck on Stopping, MCSTool has no button for that. In the Oracle Cloud Console use Stop → Reset (or Force stop), then Fix play IP. Use Fix hours record only after the game VM is Stopped.
        </p>
    </div>
    </div>

    <div>
        <div style="font-size:14px;font-weight:600;margin-bottom:4px;">Result log</div>
        <div class="mcm-section-card" style="position:relative;padding:0.75rem 1rem;">
            <button type="button"
                    class="mcm-copy-inline"
                    disabled="@Vm.IsBusy"
                    title="Copy result log"
                    style="position:absolute;top:8px;right:8px;"
                    @onclick="Vm.CopyResultLogAsync">
                Copy
            </button>
            <pre style="margin:0;padding-right:4.5rem;font-family:var(--font-mono);font-size:11px;white-space:pre-wrap;word-break:break-word;max-height:160px;overflow:auto;">@Vm.ResultLog</pre>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnVmChanged;
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnVmChanged;
    }

    private void OnVmChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);
}
