@inject AdvancedViewModel Vm
@inject Vm1ShapeScaleViewModel Scale
@inject DestroyInfrastructureViewModel Destroy
@implements IDisposable

<section class="mcm-danger-zone" aria-labelledby="mcm-danger-zone-title">
    <div>
        <h2 id="mcm-danger-zone-title" class="mcm-danger-zone-title">Danger Zone</h2>
        <p class="mcm-danger-zone-lede">
            Idle shutdown, server size, and deleting the cloud stack. These can turn off Always Free brakes or tear the stack down. Break-glass VM power stays above. Everyday Start / Stop stay on the top bar.
        </p>
    </div>

    <div class="mcm-danger-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span class="mcm-danger-card-title">Idle shutdown</span>
            <button type="button"
                    class="mcm-help"
                    title="The idle timer shuts the server down when nobody is playing (or Minecraft is not running) so you stay on Always Free. Disable only for short tests. Starting Minecraft or rebooting the VM turns the timer back on.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About idle shutdown</span>
            </button>
        </div>
        <p style="margin:0 0 12px;font-size:13px;">
            Testing / troubleshooting only. Unchecking this stops empty-server and daily-budget SoftStop until the next Minecraft boot. Boot force-enables idle (OS-ISSUE-7).
        </p>
        <label class="mcm-checkbox-row" style="margin:0;" for="mcm-dz-idle-enabled">
            <input id="mcm-dz-idle-enabled"
                   type="checkbox"
                   disabled="@Vm.IsBusy"
                   @bind="Vm.EditIdleAgentEnabled" />
            Automatically stop an empty or down server
        </label>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;">
            <button type="button"
                    disabled="@Vm.IsBusy"
                    @onclick="Vm.RefreshIdleFromOsAsync">
                Refresh from cloud
            </button>
            <button type="button"
                    class="mcm-primary"
                    disabled="@(!Vm.CanApplyIdleEnabled)"
                    @onclick="Vm.ApplyIdleEnabledAsync">
                Save changes
            </button>
        </div>

        <div style="display:grid;grid-template-columns:220px 1fr;gap:8px 12px;align-items:center;margin-top:16px;">
            <label for="mcm-dz-idle-timeout">Idle timeout (minutes)</label>
            <input id="mcm-dz-idle-timeout"
                   type="text"
                   class="mcm-num-input"
                   style="width:10rem;"
                   disabled="@Vm.IsBusy"
                   @bind="Vm.EditIdleTimeout"
                   @bind:event="oninput" />

            <label for="mcm-dz-budget-warn">Budget warning lead time (minutes)</label>
            <input id="mcm-dz-budget-warn"
                   type="text"
                   class="mcm-num-input"
                   style="width:10rem;"
                   disabled="@Vm.IsBusy"
                   @bind="Vm.EditBudgetWarn"
                   @bind:event="oninput" />
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;">
            <button type="button"
                    class="mcm-primary"
                    disabled="@(!Vm.CanApplyIdleTimeout)"
                    @onclick="Vm.ApplyIdleTimeoutSettingsAsync">
                Save timeout
            </button>
        </div>
    </div>

    <div class="mcm-danger-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span class="mcm-danger-card-title">Change game computer size</span>
            <button type="button"
                    class="mcm-help"
                    title="Ampere A1 Flex OCPU and memory. Changing size changes how fast Always Free hours burn. The game computer and Minecraft must be Stopped. Past usage rows keep the size they were recorded at. Sizes above 4 OCPU / 24 GB are not offered yet.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About changing game computer size</span>
            </button>
        </div>
        <p style="margin:0 0 12px;font-size:13px;">
            Current size: <strong>@Scale.CurrentSizeDisplay</strong>
            <span> · VM1 @Scale.Vm1Lifecycle</span>
        </p>
        <p style="margin:0 0 10px;font-size:13px;">
            Apply is disabled until the game computer is Stopped (top-bar Stop). Minecraft stops with it. Always Free sizes only — not larger than 4 OCPU / 24 GB.
        </p>
        <label class="mcm-radio-row">
            <input type="radio"
                   name="mcm-dz-vm1-shape"
                   disabled="@Scale.IsBusy"
                   checked="@Scale.TargetIsDefault"
                   @onchange="@(() => Scale.SelectDefaultShape())" />
            <span>
                4 OCPU / 24 GB (recommended)
                <span class="mcm-radio-note">More room for players and mods. Uses Always Free hours faster while the game computer is on.</span>
            </span>
        </label>
        <label class="mcm-radio-row">
            <input type="radio"
                   name="mcm-dz-vm1-shape"
                   disabled="@Scale.IsBusy"
                   checked="@(!Scale.TargetIsDefault)"
                   @onchange="@(() => Scale.SelectSmallerShape())" />
            <span>
                2 OCPU / 12 GB
                <span class="mcm-radio-note">Smaller Always Free size. More wall-clock hours from the same OCPU-hour budget; less room if you add mods or more players.</span>
            </span>
        </label>
        <div class="mcm-shape-preview">@Scale.PreviewText</div>
        @if (!Scale.CanApply && !string.IsNullOrWhiteSpace(Scale.BlockedReason))
        {
            <p style="margin:0 0 12px;font-size:13px;color:var(--text-danger);">@Scale.BlockedReason</p>
        }
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;">
            <button type="button"
                    disabled="@Scale.IsBusy"
                    @onclick="Scale.RefreshAsync">
                Refresh size
            </button>
            <button type="button"
                    class="mcm-danger-btn"
                    disabled="@(!Scale.CanApply)"
                    @onclick="Scale.ApplyAsync">
                Apply size change
            </button>
        </div>
        <p style="margin:10px 0 0;font-size:13px;opacity:0.9;">@Scale.StatusMessage</p>
    </div>

    <div class="mcm-danger-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span class="mcm-danger-card-title">Delete infrastructure</span>
            <button type="button"
                    class="mcm-help"
                    title="Removes only the product stack this Manager deployed (OpenTofu state on this PC). Does not delete your Oracle tenancy or Oracle’s default account resources.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About delete infrastructure</span>
            </button>
        </div>
        <p style="margin:0 0 12px;font-size:13px;">
            Tear down the Always Free stack so you can run Setup again on this tenancy. World backups in shared storage are deleted. This does not close your Oracle account.
        </p>
        <button type="button"
                class="mcm-danger-btn"
                disabled="@Vm.IsBusy"
                title="Opens a confirm window. Type confirm, then watch OpenTofu delete the stack. The window stays open until Oracle finishes."
                @onclick="Destroy.Open">
            Delete infrastructure
        </button>
    </div>

    @* v1 later (do not implement here): Paid / spend mode — Step 8.1 *@
</section>

@code {
    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnVmChanged;
        Scale.PropertyChanged += OnScaleChanged;
        _ = Scale.RefreshAsync();
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnVmChanged;
        Scale.PropertyChanged -= OnScaleChanged;
    }

    private void OnVmChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnScaleChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);
}
