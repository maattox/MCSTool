<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:McManager.App.ViewModels"
        xmlns:tabs="using:McManager.App.Views.Tabs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
        x:Class="McManager.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="960"
        Height="640"
        MinWidth="800"
        MinHeight="480">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="16,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding Status}"
                               TextWrapping="Wrap"
                               Opacity="0.85" />
                    <TextBlock Text="{Binding ActionFeedback}"
                               TextWrapping="Wrap"
                               Opacity="0.7"
                               FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Button Content="Start"
                            Command="{Binding StartCommand}"
                            IsEnabled="{Binding CanStart}"
                            MinWidth="72" />
                    <Button Content="Stop"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding CanStop}"
                            MinWidth="72" />
                    <Button Content="Restart"
                            Command="{Binding RestartCommand}"
                            IsEnabled="{Binding CanRestart}"
                            MinWidth="72" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Spacing="24"
                            Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Play IP:" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PlayIp}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Content="Copy"
                                Command="{Binding CopyPlayIpCommand}"
                                Padding="8,2"
                                MinWidth="56" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Players:" Opacity="0.7" />
                        <TextBlock Text="{Binding PlayersDisplay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Today:" Opacity="0.7" />
                        <TextBlock Text="{Binding TodayUsageDisplay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Name="MainTabs" Margin="8" SelectionChanged="OnMainTabsSelectionChanged">
            <TabItem Header="Whitelist">
                <tabs:WhitelistView DataContext="{Binding Whitelist}" />
            </TabItem>
            <TabItem Header="Usage">
                <tabs:UsageView DataContext="{Binding Usage}" />
            </TabItem>
            <TabItem Header="Server Management">
                <tabs:ServerManagementView DataContext="{Binding ServerManagement}" />
            </TabItem>
            <TabItem Header="Advanced / Danger Zone">
                <tabs:AdvancedView DataContext="{Binding Advanced}" />
            </TabItem>
        </TabControl>
    </DockPanel>

</Window>
