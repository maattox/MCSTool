@inject FirstRunViewModel Vm
@implements IDisposable

<div class="mcm-app">
    <CaptionBar />

    <div class="mcm-firstrun">
        <header class="mcm-firstrun-intro">
            <h1>Welcome</h1>
            <p class="mcm-firstrun-lead">
                MCSTool creates a vanilla, Paper, or modded Minecraft server on Oracle Always Free,
                then lets you manage it from this app. Players join one address. When nobody is playing,
                the game server sleeps; a small always-on doorbell can still wake it.
            </p>
        </header>

        <div class="mcm-firstrun-actions">
            <button type="button"
                    class="mcm-firstrun-choice mcm-firstrun-choice-primary"
                    disabled="@Vm.IsBusy"
                    @onclick="Vm.OpenSetup">
                <span class="mcm-firstrun-choice-title">Deploy a new stack</span>
                <span class="mcm-firstrun-choice-copy">Walk through setup and create the cloud computers.</span>
            </button>
            <button type="button"
                    class="mcm-firstrun-choice"
                    disabled="@Vm.IsBusy"
                    @onclick="Vm.DetectAsync">
                <span class="mcm-firstrun-choice-title">Find an existing stack</span>
                <span class="mcm-firstrun-choice-copy">Reads your saved cloud logins, finds the product compartment, and fills this app from shared storage after you confirm.</span>
            </button>
            <button type="button"
                    class="mcm-firstrun-choice"
                    disabled="@Vm.IsBusy"
                    @onclick="Vm.OpenExistingStack">
                <span class="mcm-firstrun-choice-title">I already have a stack</span>
                <span class="mcm-firstrun-choice-copy">Opens Manager without scanning the cloud. Use this if you already copied a config file onto this PC.</span>
            </button>
        </div>

        @if (Vm.CanCancelAdd)
        {
            <button type="button"
                    class="mcm-firstrun-cancel"
                    disabled="@Vm.IsBusy"
                    title="Go back and delete this new empty server folder. Other servers on this PC are kept."
                    @onclick="Vm.CancelAdd">
                Cancel
            </button>
        }

        @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
        {
            <p class="mcm-firstrun-status">@Vm.StatusMessage</p>
        }

        @if (Vm.ConfigHost.LoadFailed)
        {
            <p class="mcm-firstrun-error">@Vm.ConfigHost.LoadResult.Error</p>
        }
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnVmChanged;
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnVmChanged;
    }

    private void OnVmChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);
}
