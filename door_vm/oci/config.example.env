# Example OCI identifiers for door_vm /opt/mccontrol wrappers.
#
# On the live door, copy to /etc/mccontrol/oci.env (mode 600) and fill real values
# from data/Infrastructure-Deployment-Private.md — never commit a filled oci.env.
# systemd EnvironmentFile=-/etc/mccontrol/oci.env loads these for mccontrol + scripts.
#
#   set -a
#   source /etc/mccontrol/oci.env
#   set +a
#   /opt/mccontrol/oci/start_vm1.sh

OCI_CLI_AUTH=instance_principal

# VM1 (primary Ampere) compute instance OCID.
INSTANCE_ID=ocid1.instance.oc1.example

# Compartment OCID — optional for the wrappers below; keep for lookups / IAM scoping.
# COMPARTMENT_ID=ocid1.compartment.oc1.example

# Reserved public IP OCID (the address friends always connect to).
RESERVED_PUBLIC_IP_ID=ocid1.publicip.oc1.example

# Private IP OCIDs used when reassigning the reserved public IP.
VM1_PRIVATE_IP_ID=ocid1.privateip.oc1.example
VM2_PRIVATE_IP_ID=ocid1.privateip.oc1.example

# VM1 private IPv4 address — used by wait_forge.sh for TCP / status checks.
VM1_PRIVATE_IP=10.0.0.42

# Seconds to wait for Forge on VM1 :25565 (default 600).
WAIT_TIMEOUT_SEC=600

# Shared Object Storage (door wake-gate / Phase 3–4)
OBJECT_STORAGE_NAMESPACE=<OBJECT_STORAGE_NAMESPACE>
OBJECT_STORAGE_BUCKET=minecraft-shared-data
OS_CACHE_DIR=/var/lib/mccontrol/os-cache

# Ensure `oci` is on PATH for root/systemd (typical install location).
PATH=/home/ubuntu/bin:/usr/local/bin:/usr/bin:/bin
