@inject IWindowChromeService WindowChrome
@inject ChromeViewModel Chrome
@inject AdvancedViewModel Advanced
@implements IDisposable

<header class="mcm-caption">
    <div class="mcm-caption-drag"
         @onpointerdown="OnDragPointerDown">
        @if (Chrome.ShowCaptionServerSelect)
        {
            <select class="mcm-caption-server-select"
                    aria-label="Server"
                    disabled="@Advanced.IsBusy"
                    @bind="Advanced.SelectedServerId"
                    @bind:event="onchange"
                    @onpointerdown:stopPropagation="true">
                @foreach (var server in Advanced.Servers)
                {
                    <option value="@server.Id">@CaptionName(server)</option>
                }
            </select>
        }
    </div>
    <div class="mcm-caption-actions">
        @AppActions
        <div class="mcm-caption-win">
            <button type="button"
                    class="mcm-caption-winbtn"
                    aria-label="Minimize"
                    @onclick="WindowChrome.Minimize"
                    @onclick:stopPropagation="true">
                <i class="ti ti-minus" aria-hidden="true"></i>
            </button>
            <button type="button"
                    class="mcm-caption-winbtn"
                    aria-label="@MaximizeTitle"
                    @onclick="WindowChrome.ToggleMaximize"
                    @onclick:stopPropagation="true">
                <i class="ti @(WindowChrome.IsMaximized ? "ti-box-multiple" : "ti-square")" aria-hidden="true"></i>
            </button>
            <button type="button"
                    class="mcm-caption-winbtn is-close"
                    aria-label="Close"
                    @onclick="WindowChrome.Close"
                    @onclick:stopPropagation="true">
                <i class="ti ti-x" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</header>

@code {
    [Parameter]
    public RenderFragment? AppActions { get; set; }

    private string MaximizeTitle => WindowChrome.IsMaximized ? "Restore" : "Maximize";

    protected override void OnInitialized()
    {
        WindowChrome.Changed += OnChromeChanged;
        Chrome.PropertyChanged += OnChromeChanged;
        Advanced.PropertyChanged += OnChromeChanged;
    }

    public void Dispose()
    {
        WindowChrome.Changed -= OnChromeChanged;
        Chrome.PropertyChanged -= OnChromeChanged;
        Advanced.PropertyChanged -= OnChromeChanged;
    }

    private void OnChromeChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnDragPointerDown(PointerEventArgs e)
    {
        if (e.Button != 0)
            return;
        WindowChrome.DragMove();
    }

    private static string CaptionName(ServerIndexEntry server)
    {
        var name = (server.DisplayName ?? "").Trim();
        return name.Length > 0 ? name : server.Id;
    }
}
