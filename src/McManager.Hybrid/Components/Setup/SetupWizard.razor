@inject SetupWizardViewModel Vm
@inject HybridShell Shell
@inject ManageSession Session
@inject IJSRuntime JS
@implements IDisposable

<div class="mcm-app mcm-wizard-app">
    <CaptionBar />

    <div class="mcm-wizard">
        <header class="mcm-wizard-header">
            <h1>@Vm.StepTitle</h1>
            <p>@Vm.StepSubtitle</p>
        </header>

        <div class="mcm-wizard-body mcm-slim-scroll @(Vm.IsStepAlwaysFree || Vm.IsStepOci || Vm.IsStepSsh || Vm.IsStepEula || Vm.IsStepAuthToken ? "is-sparse" : null) @(Vm.IsStepAlwaysFree ? "is-alwaysfree" : null) @(Vm.IsStepSummary && Vm.ShowDeployProgress ? "is-deploying" : null)">
            @if (Vm.IsStepAlwaysFree)
            {
                <div class="mcm-wizard-alwaysfree">
                    <p class="mcm-wizard-alwaysfree-lead">@SetupWizardViewModel.AlwaysFreeLeadCopy</p>
                    <button type="button"
                            class="mcm-wizard-text-link"
                            @onclick="Vm.OpenAlwaysFreeDocs">
                        Always Free compute docs
                    </button>
                    <div class="mcm-wizard-alwaysfree-acks">
                        <label class="mcm-wizard-ack">
                            <input type="checkbox"
                                   disabled="@(!Vm.CanMutateWizard)"
                                   @bind="Vm.AlwaysFreeConfirmed" />
                            <span class="mcm-wizard-ack-text">
                                <span class="mcm-wizard-ack-title">Stay on Always Free–eligible compute</span>
                                <span class="mcm-wizard-ack-copy">@SetupWizardViewModel.AlwaysFreeStayHelp</span>
                            </span>
                        </label>
                        <label class="mcm-wizard-ack">
                            <input type="checkbox"
                                   disabled="@(!Vm.CanMutateWizard)"
                                   @bind="Vm.ResidualChargeDisclosed" />
                            <span class="mcm-wizard-ack-text">
                                <span class="mcm-wizard-ack-title">I understand the $1 brake and a possible ~$1–$2 residual</span>
                                <span class="mcm-wizard-ack-copy">@SetupWizardViewModel.AlwaysFreeResidualHelp</span>
                            </span>
                        </label>
                        <label class="mcm-wizard-ack">
                            <input type="checkbox"
                                   disabled="@(!Vm.CanMutateWizard)"
                                   @bind="Vm.CapacityWaitConsent" />
                            <span class="mcm-wizard-ack-text">
                                <span class="mcm-wizard-ack-title">I understand capacity wait</span>
                                <span class="mcm-wizard-ack-copy">@SetupWizardViewModel.AlwaysFreeCapacityHelp</span>
                            </span>
                        </label>
                    </div>
                    @if (Vm.IsTofuDryRun)
                    {
                        <p class="mcm-wizard-hint">This session has MCMANAGER_TOFU_DRY_RUN set. Deploy will not create Oracle resources.</p>
                    }
                </div>
            }
            else if (Vm.IsStepOci)
            {
                <div class="mcm-wizard-pane">
                    <p class="mcm-wizard-pane-lead">Region and account come from ~/.oci/config on this PC. Prefer the tenancy home region.</p>
                    <div class="mcm-wizard-card">
                        <div class="mcm-field mcm-field-short">
                            <label for="mcm-setup-profile" class="mcm-wizard-ack-title">OCI profile</label>
                            <select id="mcm-setup-profile"
                                    disabled="@(!Vm.CanMutateWizard)"
                                    @bind="Vm.OciProfile">
                                @foreach (var profile in Vm.Profiles)
                                {
                                    <option value="@profile.Name">@profile</option>
                                }
                            </select>
                        </div>
                        <span class="mcm-wizard-ack-copy">@SetupWizardViewModel.OciProfileHelp</span>
                        <pre id="mcm-setup-profile-details"
                             class="mcm-wizard-mono mcm-wizard-profile-pre">@Vm.ProfileDetailsText</pre>
                    </div>
                    <div class="mcm-wizard-card">
                        <div class="mcm-field mcm-field-short">
                            <label for="mcm-setup-email" class="mcm-wizard-ack-title">Budget alert email</label>
                            <input id="mcm-setup-email"
                                   type="email"
                                   name="alert-email"
                                   autocomplete="email"
                                   placeholder="you@example.com"
                                   disabled="@(!Vm.CanMutateWizard)"
                                   @bind="Vm.AlertEmail"
                                   @bind:event="oninput" />
                        </div>
                        <span class="mcm-wizard-ack-copy">@SetupWizardViewModel.AlertEmailHelp</span>
                    </div>
                </div>
            }
            else if (Vm.IsStepSsh)
            {
                <div class="mcm-wizard-pane">
                    <p class="mcm-wizard-pane-lead">Generate a new key, or import a .pub. Both VMs use this key unless you pick a different one for the door.</p>
                    <label class="mcm-wizard-ack">
                        <input type="radio"
                               name="mcm-setup-ssh"
                               disabled="@(!Vm.CanMutateWizard)"
                               checked="@Vm.SshGenerateMode"
                               @onchange="@(() => Vm.SshGenerateMode = true)" />
                        <span class="mcm-wizard-ack-text">
                            <span class="mcm-wizard-ack-title">Generate a new key</span>
                            <span class="mcm-wizard-ack-copy">Creates a new key on this PC. The private key stays on disk and is not saved in Setup’s resume file.</span>
                        </span>
                    </label>
                    <label class="mcm-wizard-ack">
                        <input type="radio"
                               name="mcm-setup-ssh"
                               disabled="@(!Vm.CanMutateWizard)"
                               checked="@Vm.SshImportMode"
                               @onchange="@(() => Vm.SshGenerateMode = false)" />
                        <span class="mcm-wizard-ack-text">
                            <span class="mcm-wizard-ack-title">Import an existing .pub</span>
                            <span class="mcm-wizard-ack-copy">Use an existing public key. This is not the Oracle API key.</span>
                        </span>
                    </label>
                    <div class="mcm-wizard-actions">
                        <button type="button"
                                disabled="@(!Vm.CanMutateWizard)"
                                @onclick="Vm.GenerateSshKeyAsync">
                            Generate key
                        </button>
                        <button type="button"
                                disabled="@(!Vm.CanMutateWizard)"
                                @onclick="Vm.ImportSshKeyAsync">
                            Import .pub…
                        </button>
                    </div>
                    <div class="mcm-field">
                        <label for="mcm-setup-ssh-pub">Game VM (VM1) public key</label>
                        <textarea id="mcm-setup-ssh-pub"
                                  class="mcm-wizard-mono"
                                  name="ssh-public-key"
                                  autocomplete="off"
                                  spellcheck="false"
                                  rows="3"
                                  disabled="@(!Vm.CanMutateWizard)"
                                  @bind="Vm.SshPublicKey"
                                  @bind:event="oninput"></textarea>
                        @if (!string.IsNullOrWhiteSpace(Vm.SshPublicKeyPath))
                        {
                            <p class="mcm-wizard-hint mcm-wizard-mono">@Vm.SshPublicKeyPath</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Vm.SshFingerprint))
                        {
                            <p class="mcm-wizard-hint mcm-wizard-mono">@Vm.SshFingerprint</p>
                        }
                    </div>
                    <label class="mcm-wizard-ack">
                        <input type="checkbox"
                               disabled="@(!Vm.CanMutateWizard)"
                               @bind="Vm.SshSplitDoorKey" />
                        <span class="mcm-wizard-ack-text">
                            <span class="mcm-wizard-ack-title">Use a different key for the door VM</span>
                            <span class="mcm-wizard-ack-copy">@SetupWizardViewModel.DoorSshHelp</span>
                        </span>
                    </label>
                    @if (Vm.SshSplitDoorKey)
                    {
                        <div class="mcm-wizard-actions">
                            <button type="button"
                                    disabled="@(!Vm.CanMutateWizard)"
                                    @onclick="Vm.GenerateDoorSshKeyAsync">
                                Generate door key
                            </button>
                            <button type="button"
                                    disabled="@(!Vm.CanMutateWizard)"
                                    @onclick="Vm.ImportDoorSshKeyAsync">
                                Import door .pub…
                            </button>
                        </div>
                        <div class="mcm-field">
                            <label for="mcm-setup-door-ssh-pub">Door VM public key</label>
                            <textarea id="mcm-setup-door-ssh-pub"
                                      class="mcm-wizard-mono"
                                      name="door-ssh-public-key"
                                      autocomplete="off"
                                      spellcheck="false"
                                      rows="3"
                                      disabled="@(!Vm.CanMutateWizard)"
                                      @bind="Vm.DoorSshPublicKey"
                                      @bind:event="oninput"></textarea>
                            @if (!string.IsNullOrWhiteSpace(Vm.DoorSshPublicKeyPath))
                            {
                                <p class="mcm-wizard-hint mcm-wizard-mono">@Vm.DoorSshPublicKeyPath</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(Vm.DoorSshFingerprint))
                            {
                                <p class="mcm-wizard-hint mcm-wizard-mono">@Vm.DoorSshFingerprint</p>
                            }
                        </div>
                    }
                </div>
            }
            else if (Vm.IsStepGame)
            {
                <div class="mcm-wizard-game @(Vm.ShowModdedGameOptions ? "is-modded" : null)">
                    <div class="mcm-wizard-game-layout">
                        <fieldset class="mcm-wizard-fieldset mcm-wizard-game-kind">
                            <legend class="sr-only">Server type</legend>
                            <div class="mcm-radio-row mcm-wizard-game-kind-hit @(Vm.ServerTypeIsVanilla ? "is-selected" : null)">
                                <label class="mcm-check-hit">
                                    <input type="radio"
                                           name="mcm-setup-server-type"
                                           disabled="@(!Vm.CanMutateWizard)"
                                           checked="@Vm.ServerTypeIsVanilla"
                                           @onchange="@(() => Vm.SelectVanillaServer())" />
                                    <span>
                                        <span class="mcm-wizard-game-kind-title">Vanilla</span>
                                        <span class="mcm-wizard-game-kind-copy">@SetupWizardViewModel.VanillaHelp</span>
                                    </span>
                                </label>
                            </div>
                            <div class="mcm-radio-row mcm-wizard-game-kind-hit @(Vm.ServerTypeIsModded ? "is-selected" : null)">
                                <label class="mcm-check-hit">
                                    <input type="radio"
                                           name="mcm-setup-server-type"
                                           disabled="@(!Vm.CanMutateWizard)"
                                           checked="@Vm.ServerTypeIsModded"
                                           @onchange="@(() => Vm.SelectModdedServer())" />
                                    <span>
                                        <span class="mcm-wizard-game-kind-title">Modded</span>
                                        <span class="mcm-wizard-game-kind-copy">@SetupWizardViewModel.ModdedHelp</span>
                                    </span>
                                </label>
                            </div>
                        </fieldset>

                        <div class="mcm-wizard-game-options">
                            @if (Vm.ShowVanillaGameOptions)
                            {
                                <label class="mcm-wizard-ack mcm-wizard-ack-sm">
                                    <input type="radio"
                                           name="mcm-setup-vanilla-flavor"
                                           disabled="@(!Vm.CanMutateWizard)"
                                           checked="@Vm.VanillaFlavorIsDefault"
                                           @onchange="@(() => Vm.SelectDefaultVanilla())" />
                                    <span class="mcm-wizard-ack-text">
                                        <span class="mcm-wizard-ack-title">Default Vanilla</span>
                                        <span class="mcm-wizard-ack-copy">@SetupWizardViewModel.DefaultVanillaHelp</span>
                                    </span>
                                </label>
                                <label class="mcm-wizard-ack mcm-wizard-ack-sm">
                                    <input type="radio"
                                           name="mcm-setup-vanilla-flavor"
                                           disabled="@(!Vm.CanMutateWizard)"
                                           checked="@Vm.VanillaFlavorIsOptimized"
                                           @onchange="@(() => Vm.SelectOptimizedVanilla())" />
                                    <span class="mcm-wizard-ack-text">
                                        <span class="mcm-wizard-ack-title">Optimized Vanilla (Paper)</span>
                                        <span class="mcm-wizard-ack-copy">@SetupWizardViewModel.OptimizedVanillaHelp</span>
                                    </span>
                                </label>
                                @if (Vm.ShowSnapshotToggle)
                                {
                                    <label class="mcm-checkbox-row">
                                        <input type="checkbox"
                                               disabled="@(!Vm.CanMutateWizard)"
                                               @bind="Vm.IncludeSnapshots" />
                                        <span>Advanced: include snapshots</span>
                                    </label>
                                }
                                <div class="mcm-field">
                                    <label for="mcm-setup-mc-version">Minecraft version</label>
                                    <select id="mcm-setup-mc-version"
                                            disabled="@(!Vm.CanMutateWizard || Vm.VersionIds.Count == 0)"
                                            value="@Vm.MinecraftVersion"
                                            @onchange="OnMinecraftVersionPicked">
                                        @if (!string.IsNullOrWhiteSpace(Vm.MinecraftVersion)
                                             && !Vm.VersionIds.Contains(Vm.MinecraftVersion))
                                        {
                                            <option value="@Vm.MinecraftVersion">@Vm.MinecraftVersion</option>
                                        }
                                        @foreach (var id in Vm.VersionIds)
                                        {
                                            <option value="@id">@id</option>
                                        }
                                    </select>
                                </div>
                                <p class="mcm-wizard-hint">@Vm.VersionCatalogNotes</p>
                            }

                            @if (Vm.ShowModdedGameOptions)
                            {
                                <div class="mcm-wizard-game-ingest">
                                    <div class="mcm-pack-drop @(Vm.IsAnalyzingPack ? "is-busy" : "")"
                                         aria-label="Drop a modpack file">
                                        <InputFile class="mcm-pack-drop-input"
                                                   OnChange="OnPackInputAsync"
                                                   accept=".mrpack,.zip"
                                                   disabled="@(!Vm.CanMutateWizard || Vm.IsAnalyzingPack)" />
                                        <i class="ti ti-file-zip" aria-hidden="true"></i>
                                        <p class="mcm-pack-drop-title">Drop a .mrpack or Server Files zip</p>
                                    </div>
                                    <div class="mcm-wizard-game-ingest-actions">
                                        <div class="mcm-wizard-actions mcm-wizard-game-ingest-pick">
                                            <button type="button"
                                                    disabled="@(!Vm.CanMutateWizard || Vm.IsAnalyzingPack)"
                                                    @onclick="Vm.PickPackAsync">
                                                Choose pack file…
                                            </button>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(Vm.PackPath))
                                        {
                                            <button type="button"
                                                    disabled="@(!Vm.CanMutateWizard || Vm.IsAnalyzingPack)"
                                                    @onclick="Vm.ClearPack">
                                                Clear pack
                                            </button>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(Vm.PackFileNameDisplay))
                                    {
                                        <p class="mcm-wizard-hint mcm-wizard-mono mcm-wizard-game-file"
                                           title="@Vm.PackFileNameDisplay">@Vm.PackFileNameDisplay</p>
                                    }
                                    <p class="mcm-wizard-hint mcm-wizard-game-pack-help">@SetupWizardViewModel.PackFileHelp</p>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mcm-field mcm-field-short">
                        <label for="mcm-setup-world-seed">World seed (optional)</label>
                        <input id="mcm-setup-world-seed"
                               @key="@("mcm-setup-world-seed")"
                               type="text"
                               name="mc-world-seed"
                               maxlength="256"
                               spellcheck="false"
                               autocomplete="off"
                               autocorrect="off"
                               autocapitalize="off"
                               placeholder="Leave blank for a random world"
                               disabled="@(!Vm.CanMutateWizard)"
                               @bind="Vm.WorldSeed"
                               @bind:event="oninput" />
                        <p class="mcm-wizard-hint">Used when Minecraft generates a new world. Leave blank for a random seed.</p>
                    </div>

                    @if (Vm.ShowModdedGameOptions)
                    {
                        <div class="mcm-wizard-game-follow">
                            @if (Vm.IsAnalyzingPack)
                            {
                                <div class="mcm-wizard-progress">
                                    <div class="mcm-wizard-progress-row">
                                        <span>@Vm.PackAnalyzeCaption</span>
                                    </div>
                                    <div class="mcm-progress-track" role="progressbar" aria-busy="true" aria-valuemin="0" aria-valuemax="100">
                                        <div class="mcm-progress-fill mcm-progress-indeterminate"></div>
                                    </div>
                                </div>
                            }
                            @if (Vm.ShowPackSummary)
                            {
                                @if (!string.IsNullOrWhiteSpace(Vm.PackBlockReason))
                                {
                                    <p class="mcm-wizard-error">@Vm.PackBlockReason</p>
                                }
                                @if (Vm.ShowSkipListWarning)
                                {
                                    <aside class="mcm-pack-list-warning" role="status">
                                        <p>@Vm.SkipWarningBody</p>
                                    </aside>
                                }
                                @if (!Vm.ShowPackAssistedReview)
                                {
                                    <pre class="mcm-wizard-log mcm-wizard-mono mcm-slim-scroll mcm-pack-summary">@Vm.PackSummary</pre>
                                }
                            }
                            @if (Vm.ShowPackIdentityFields)
                            {
                                <PackIdentityFields IdPrefix="setup-pack"
                                                    Disabled="@(!Vm.CanMutateWizard)"
                                                    @bind-MinecraftVersion="Vm.MinecraftVersion"
                                                    @bind-Loader="Vm.PackLoader"
                                                    @bind-LoaderVersion="Vm.PackLoaderVersion"
                                                    @bind-JavaMajorText="Vm.PackJavaMajorText"
                                                    ShowDetectionMismatch="@Vm.ShowDetectionMismatch"
                                                    DetectionMismatchWarning="@Vm.DetectionMismatchWarning" />
                            }
                            @if (Vm.ShowPackAssistedReview)
                            {
                                <PackAssistedReviewPanel IdPrefix="setup-pack"
                                                         Disabled="@(!Vm.CanMutateWizard)"
                                                         Review="@Vm.AssistedReview"
                                                         JarOrder="@Vm.PackJarOrder"
                                                         FreezeBlockReason="@Vm.PackFreezeBlockReason"
                                                         LooksLikeLauncherInstance="@Vm.PackLooksLikeLauncherInstance"
                                                         ShowHeading="true"
                                                         IsSkipped="@Vm.IsOperatorSkipped"
                                                         SkipChanged="Vm.OnAssistedSkipChanged" />
                            }
                            @if (Vm.ShowPackConfirmChecks)
                            {
                                @if (Vm.PackNeedsIdentityConfirm)
                                {
                                    <label class="mcm-wizard-ack mcm-wizard-ack-sm">
                                        <input type="checkbox"
                                               disabled="@(!Vm.CanMutateWizard)"
                                               @bind="Vm.PackConfirmed" />
                                        <span class="mcm-wizard-ack-text">
                                            <span class="mcm-wizard-ack-title">@Vm.ClientOnlyMarksConfirmLabel</span>
                                        </span>
                                    </label>
                                }
                                else
                                {
                                    <label class="mcm-wizard-ack mcm-wizard-ack-sm">
                                        <input type="checkbox"
                                               disabled="@(!Vm.CanMutateWizard)"
                                               @bind="Vm.PackConfirmed" />
                                        <span class="mcm-wizard-ack-text">
                                            <span class="mcm-wizard-ack-title">Use this pack on the server (server-side mods only; client-only files are skipped).</span>
                                        </span>
                                    </label>
                                }
                            }
                        </div>
                    }
                </div>
            }
            else if (Vm.IsStepIdentity)
            {
                <div class="mcm-wizard-identity">
                    <p class="mcm-wizard-inline-help">
                        Players see this in Minecraft’s server list.
                        <WizardHelp Title="@SetupWizardViewModel.IdentityHelp" AriaLabel="About the server name and icon" />
                    </p>
                    <p class="mcm-wizard-hint mcm-wizard-motd-tip">Highlight some text and click the effect buttons to style your server’s MOTD</p>
                    <div class="mcm-identity-grid">
                        <MotdEditor IdPrefix="mcm-setup-server"
                                    Disabled="@(!Vm.CanMutateWizard)"
                                    @bind-ServerName="Vm.IdentityName"
                                    @bind-Description="Vm.IdentityDescription" />
                        <div class="mcm-wizard-identity-icon">
                            <ServerIconPreviewStrip ColorUrl="@Vm.IconPreviewDataUrl"
                                                    IdleUrl="@Vm.IdleIconPreviewDataUrl"
                                                    StartingUrl="@Vm.StartingIconPreviewDataUrl"
                                                    ExhaustedUrl="@Vm.ExhaustedIconPreviewDataUrl" />
                            <div class="mcm-wizard-actions">
                                <button type="button"
                                        disabled="@(!Vm.CanMutateWizard)"
                                        title="Any PNG. Manager fits it to 64×64."
                                        @onclick="Vm.PickIdentityIconAsync">
                                    Choose PNG
                                </button>
                                <button type="button"
                                        disabled="@(!Vm.CanMutateWizard || !Vm.CanClearIdentityIcon)"
                                        @onclick="Vm.ClearIdentityIcon">
                                    Use default
                                </button>
                                <span class="mcm-wizard-hint">Optional PNG — default if you skip</span>
                                <WizardHelp Title="@SetupWizardViewModel.IconStatesHelp" AriaLabel="About doorbell list icons" />
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Vm.IdentityHint))
                    {
                        <p class="mcm-wizard-error" role="status" aria-live="polite">@Vm.IdentityHint</p>
                    }
                </div>
            }
            else if (Vm.IsStepEula)
            {
                <div class="mcm-wizard-pane">
                    <p class="mcm-wizard-pane-lead">You must accept Mojang’s Minecraft EULA.</p>
                    <button type="button"
                            class="mcm-wizard-text-link"
                            @onclick="Vm.OpenEula">
                        Open Minecraft EULA
                    </button>
                    <label class="mcm-wizard-ack">
                        <input type="checkbox"
                               disabled="@(!Vm.CanMutateWizard)"
                               @bind="Vm.EulaAccepted" />
                        <span class="mcm-wizard-ack-text">
                            <span class="mcm-wizard-ack-title">I accept the Minecraft EULA</span>
                            <span class="mcm-wizard-ack-copy">@SetupWizardViewModel.EulaHelp</span>
                        </span>
                    </label>
                </div>
            }
            else if (Vm.IsStepAuthToken)
            {
                <div class="mcm-wizard-pane">
                    <div class="mcm-wizard-card">
                        <div class="mcm-field mcm-field-short">
                            <label for="mcm-setup-token" class="mcm-wizard-ack-title">Auth Token</label>
                            <input id="mcm-setup-token"
                                   type="password"
                                   name="ocir-auth-token"
                                   autocomplete="off"
                                   spellcheck="false"
                                   placeholder="Paste token…"
                                   disabled="@(!Vm.CanMutateWizard)"
                                   @bind="Vm.AuthTokenInput"
                                   @bind:event="oninput" />
                        </div>
                        <span class="mcm-wizard-ack-copy">@SetupWizardViewModel.AuthTokenHelp</span>
                    </div>
                    <div class="mcm-wizard-actions">
                        <button type="button" class="mcm-primary" @onclick="Vm.StoreAuthToken">Store token</button>
                        <button type="button" class="mcm-wizard-text-link" @onclick="Vm.ClearAuthToken">Clear stored token</button>
                    </div>
                    <p class="mcm-wizard-hint">@Vm.AuthTokenStoredDisplay</p>
                </div>
            }
            else if (Vm.IsStepSummary)
            {
                <aside class="mcm-pack-list-warning" role="note">
                    <p>@SetupWizardViewModel.IncompleteDeployWarning</p>
                </aside>
                @if (Vm.ShowDeploySuccess)
                {
                    <aside class="mcm-wizard-complete" role="status">
                        <p class="mcm-wizard-kicker">Play IP</p>
                        @if (Vm.HasReservedPlayIp)
                        {
                            <div class="mcm-wizard-play-ip">
                                <span class="mcm-wizard-play-ip-value mcm-wizard-mono">@Vm.ReservedPlayIp</span>
                                <button type="button"
                                        class="mcm-copy-inline"
                                        title="Copy play IP"
                                        @onclick="Vm.CopyReservedPlayIpAsync">
                                    <i class="ti ti-copy" aria-hidden="true"></i>
                                    Copy
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="mcm-wizard-hint">The reserved play IP was not found in local config. Close and copy Play IP from the Manager sidebar.</p>
                        }
                        <p>
                            Close this wizard to continue to the Manager app. Give players the play IP above so they can join (Minecraft port 25565).
                        </p>
                    </aside>
                    @if (!string.IsNullOrWhiteSpace(Vm.DeployLog))
                    {
                        <details class="mcm-wizard-log-details">
                            <summary>Deploy log</summary>
                            <div class="mcm-wizard-log-label">
                                <span></span>
                                <button type="button" title="Copy deploy log" @onclick="Vm.CopyDeployLogAsync">Copy</button>
                            </div>
                            <pre id="mcm-deploy-log" class="mcm-wizard-log mcm-wizard-mono mcm-slim-scroll">@Vm.DeployLog</pre>
                        </details>
                    }
                }
                else
                {
                <div class="mcm-wizard-review-split">
                <div class="mcm-wizard-review-form">
                <fieldset class="mcm-wizard-fieldset" disabled="@(!Vm.CanMutateWizard)">
                    <div class="mcm-wizard-card mcm-wizard-card-sm">
                        <div class="mcm-field mcm-field-short">
                            <label for="mcm-setup-admin-cidr" class="mcm-wizard-ack-title">Your public IP</label>
                            <input id="mcm-setup-admin-cidr"
                                   type="text"
                                   name="admin-cidr"
                                   autocomplete="off"
                                   spellcheck="false"
                                   placeholder="203.0.113.10/32"
                                   @bind="Vm.AdminCidr"
                                   @bind:event="oninput" />
                        </div>
                        <span class="mcm-wizard-ack-copy">@SetupWizardViewModel.AdminCidrHelp</span>
                    </div>
                    <label class="mcm-wizard-ack mcm-wizard-ack-sm">
                        <input type="radio"
                               name="mcm-setup-vm1-shape"
                               disabled="@(!Vm.CanMutateWizard)"
                               checked="@Vm.Vm1ShapeIsDefault"
                               @onchange="@(() => Vm.SelectDefaultVm1Shape())" />
                        <span class="mcm-wizard-ack-text">
                            <span class="mcm-wizard-ack-title">4 OCPU / 24 GB (recommended)</span>
                            <span class="mcm-wizard-ack-copy">@SetupWizardViewModel.ShapeDefaultHelp</span>
                        </span>
                    </label>
                    <label class="mcm-wizard-ack mcm-wizard-ack-sm">
                        <input type="radio"
                               name="mcm-setup-vm1-shape"
                               disabled="@(!Vm.CanMutateWizard)"
                               checked="@Vm.Vm1ShapeIsSmaller"
                               @onchange="@(() => Vm.SelectSmallerVm1Shape())" />
                        <span class="mcm-wizard-ack-text">
                            <span class="mcm-wizard-ack-title">2 OCPU / 12 GB</span>
                            <span class="mcm-wizard-ack-copy">@SetupWizardViewModel.ShapeSmallerHelp</span>
                        </span>
                    </label>
                    <div class="mcm-wizard-card mcm-wizard-card-sm">
                        <span class="mcm-wizard-ack-title">Minecraft memory</span>
                        <span class="mcm-wizard-ack-copy">@SetupWizardViewModel.HeapHelp</span>
                        <div class="mcm-wizard-review-heap">
                            <label class="mcm-radio-row">
                                <input type="radio"
                                       name="mcm-setup-jvm-heap"
                                       disabled="@(!Vm.CanMutateWizard)"
                                       checked="@Vm.JvmHeapIs4G"
                                       @onchange="@(() => Vm.SelectJvmHeap4G())" />
                                <span>4G (default)</span>
                            </label>
                            <label class="mcm-radio-row">
                                <input type="radio"
                                       name="mcm-setup-jvm-heap"
                                       disabled="@(!Vm.CanMutateWizard)"
                                       checked="@Vm.JvmHeapIs6G"
                                       @onchange="@(() => Vm.SelectJvmHeap6G())" />
                                <span>6G</span>
                            </label>
                            <label class="mcm-radio-row">
                                <input type="radio"
                                       name="mcm-setup-jvm-heap"
                                       disabled="@(!Vm.CanMutateWizard)"
                                       checked="@Vm.JvmHeapIs8G"
                                       @onchange="@(() => Vm.SelectJvmHeap8G())" />
                                <span>8G</span>
                            </label>
                        </div>
                    </div>
                    <label class="mcm-checkbox-row">
                        <input type="checkbox" @bind="Vm.CreateResourcesConfirmed" />
                        <span>@Vm.CreateResourcesConfirmText</span>
                    </label>
                    @if (Vm.ShowReplaceConfigConfirm)
                    {
                        <label class="mcm-checkbox-row">
                            <input type="checkbox" @bind="Vm.ReplaceConfigConfirmed" />
                            <span>Replace config.local.json in this data folder after a successful deploy.</span>
                        </label>
                    }
                </fieldset>

                @if (Vm.IsPollingCapacity)
                {
                    <div class="mcm-section-card">@Vm.AutoRetryBannerText</div>
                }

                <p class="mcm-wizard-duration">@SetupWizardViewModel.DeployDurationHint</p>
                </div>

                <div class="mcm-wizard-review-plan">
                    <div class="mcm-wizard-log-label">
                        <span>Plan summary</span>
                        <button type="button" title="Copy plan summary" @onclick="Vm.CopyPlanSummaryAsync">Copy</button>
                    </div>
                    <pre class="mcm-wizard-log mcm-wizard-mono mcm-slim-scroll">@Vm.PlanSummaryText</pre>
                </div>
                </div>

                @if (Vm.ShowDeployProgress)
                {
                    <div class="mcm-wizard-log-stack">
                        <div class="mcm-wizard-log-block mcm-wizard-log-grow">
                            <div class="mcm-wizard-log-label">
                                <span>Deploy log</span>
                                <button type="button" title="Copy deploy log" @onclick="Vm.CopyDeployLogAsync">Copy</button>
                            </div>
                            <pre id="mcm-deploy-log" class="mcm-wizard-log mcm-wizard-mono mcm-slim-scroll">@Vm.DeployLog</pre>
                        </div>
                    </div>
                }
                }
            }
        </div>

        <ProgressDock AriaLabel="Setup"
                      Status="@Vm.DockStatus"
                      ShowProgress="@Vm.ShowDeployProgress"
                      Percent="@Vm.DeployProgressPercent"
                      PercentDisplay="@Vm.DeployProgressPercentDisplay"
                      ElapsedDisplay="@(Vm.ShowDeployElapsed ? Vm.DeployElapsedDisplay : null)"
                      RemainingDisplay="@(Vm.ShowDeployRemaining ? Vm.DeployRemainingDisplay : null)">
            <button type="button"
                    disabled="@(!Vm.CanGoBack)"
                    title="Go to the previous step. Disabled after Deploy starts."
                    @onclick="Vm.Back">
                Back
            </button>
            @if (!Vm.IsLastStep)
            {
                <button type="button"
                        class="mcm-primary"
                        disabled="@(!Vm.CanGoNext)"
                        title="@Vm.NextButtonTitle"
                        @onclick="Vm.NextAsync">
                    Next
                </button>
            }
            @if (Vm.ShowDeployButton)
            {
                <button type="button"
                        class="mcm-primary"
                        disabled="@(!Vm.CanDeploy)"
                        title="@Vm.DeployToolTip"
                        @onclick="Vm.DeployAsync">
                    Deploy
                </button>
            }
            @if (Vm.ShowCapacityOptionsButton)
            {
                <button type="button" @onclick="Vm.ShowCapacityOptionsAsync">Retry options…</button>
            }
            @if (Vm.IsPollingCapacity)
            {
                <button type="button" @onclick="Vm.StopCapacityPoll">Pause auto-retry</button>
            }
            <button type="button"
                    class="@(Vm.ShowDeploySuccess ? "mcm-primary" : null)"
                    disabled="@(!Vm.CanCloseWizard)"
                    title="@(Vm.ShowDeploySuccess ? "Close Setup and continue to the Manager app." : "You can close while a deploy is not running. Resume later from Advanced → Deploy / repair.")"
                    @onclick="Close">
                Close
            </button>
        </ProgressDock>
    </div>
</div>

@if (Vm.CapacityDialogOpen)
{
    <div class="mcm-modal-overlay open"
         role="dialog"
         aria-modal="true"
         aria-labelledby="mcm-capacity-title"
         @onclick="@(() => Vm.CompleteCapacityDialog(CapacityWaitChoice.Dismissed))">
        <div class="mcm-modal-card is-wide" @onclick:stopPropagation="true">
            <h2 id="mcm-capacity-title" class="mcm-modal-title">Always Free capacity unavailable</h2>
            <p class="mcm-modal-body">@SetupWizardViewModel.CapacityWaitExplanation</p>
            <div class="mcm-modal-actions mcm-capacity-actions">
                <button type="button"
                        class="mcm-primary"
                        @onclick="@(() => Vm.CompleteCapacityDialog(CapacityWaitChoice.RetryNow))">
                    Try again now
                </button>
                <button type="button"
                        @onclick="@(() => Vm.CompleteCapacityDialog(CapacityWaitChoice.AutoRetry))">
                    Auto-retry every 5 minutes
                </button>
                <button type="button"
                        @onclick="@(() => Vm.CompleteCapacityDialog(CapacityWaitChoice.Dismissed))">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _initialized;

    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnVmChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await Vm.InitializeAsync();
            StateHasChanged();
        }

        if (Vm.IsStepSummary)
        {
            try
            {
                await JS.InvokeVoidAsync("mcmSetupLog.attach", "mcm-deploy-log");
                await JS.InvokeVoidAsync("mcmSetupLog.scrollIfStuck", "mcm-deploy-log");
            }
            catch (Exception)
            {
                // WebView/script not ready yet.
            }
        }
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnVmChanged;
        Vm.PrepareToClose();
    }

    private void OnMinecraftVersionPicked(ChangeEventArgs e) =>
        Vm.ApplyMinecraftVersionFromPicker(e.Value?.ToString());

    private async Task OnPackInputAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        try
        {
            await using var stream = file.OpenReadStream(SetupWizardViewModel.PackDropMaxBytes);
            await Vm.ImportDroppedPackAsync(file.Name, stream);
        }
        catch (IOException ex)
        {
            Vm.StatusMessage = "Could not read the dropped file. Use Choose pack file for large packs. " + ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            Vm.StatusMessage = "Drop failed. Use Choose pack file. " + ex.Message;
        }
    }

    private void OnVmChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void Close()
    {
        if (!Vm.CanCloseWizard)
            return;
        Vm.PrepareToClose();
        Session.ReloadFromDisk();
        Shell.CloseSetup();
    }
}
