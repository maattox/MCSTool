@using System.Linq
@using McManager.Core.Setup
@using McManager.Hybrid.Components.Setup

<section class="mcm-pack-review" aria-labelledby="@HeadingId">
    <h2 id="@HeadingId" class="mcm-pack-review-title">Review unknown jars</h2>
    <p class="mcm-pack-review-lead">@SetupPackImport.AssistedReviewLead</p>
    @if (LooksLikeLauncherInstance)
    {
        <p class="mcm-wizard-hint">@SetupPackImport.PrismExportHint</p>
    }
    @if (!string.IsNullOrWhiteSpace(FreezeBlockReason))
    {
        <p class="mcm-wizard-error" role="alert">@FreezeBlockReason Unmark Skip on that jar to continue.</p>
    }

    @if (ShowSearch)
    {
        <div class="mcm-field mcm-pack-review-search">
            <label for="@SearchId">Find a jar</label>
            <input id="@SearchId"
                   type="search"
                   name="@(IdPrefix)-review-search"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="Filename…"
                   value="@_query"
                   disabled="@Disabled"
                   @oninput="OnSearchInput" />
        </div>
    }

    <div class="mcm-pack-review-group">
        <h3 class="mcm-pack-review-heading" id="@NeedsHeadingId">
            Needs your call
            <span class="mcm-pack-review-count">@FilteredCallRows.Count</span>
        </h3>
        <p class="mcm-pack-review-help">Default is Keep. Mark Skip on server only for jars you do not want installed.</p>
        @if (FilteredCallRows.Count == 0)
        {
            <p class="mcm-wizard-hint">@(CallRows.Count == 0 ? "Nothing left to decide." : "No jars match that name.")</p>
        }
        else
        {
            <ul class="mcm-pack-review-list mcm-slim-scroll" aria-labelledby="@NeedsHeadingId">
                @foreach (var item in FilteredCallRows)
                {
                    var inputId = RowId("call", item);
                    var skipped = IsPathSkipped(item.Path);
                    <li class="mcm-pack-review-item">
                        <label class="mcm-check-hit mcm-pack-review-hit" for="@inputId" title="@item.Path">
                            <input id="@inputId"
                                   type="checkbox"
                                   name="@(IdPrefix)-skip"
                                   autocomplete="off"
                                   disabled="@Disabled"
                                   checked="@skipped"
                                   @onchange="e => OnSkipChange(item, e)" />
                            <span class="mcm-pack-review-meta">
                                <span class="mcm-pack-review-file" translate="no">@item.FileName</span>
                                <span class="mcm-pack-review-why">@CallWhy(item, skipped)</span>
                            </span>
                        </label>
                        <span class="mcm-pack-review-action">Skip on server</span>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="mcm-pack-review-group">
        <h3 class="mcm-pack-review-heading" id="@MustHeadingId">
            Must keep
            <span class="mcm-pack-review-count">@Review.MustKeep.Count</span>
        </h3>
        @if (Review.MustKeep.Count == 0)
        {
            <p class="mcm-wizard-hint">No required-dependency locks.</p>
        }
        else
        {
            <ul class="mcm-pack-review-list mcm-slim-scroll" aria-labelledby="@MustHeadingId">
                @foreach (var item in Review.MustKeep)
                {
                    <li class="mcm-pack-review-item is-locked" title="@item.Path">
                        <i class="ti ti-lock" aria-hidden="true"></i>
                        <span class="mcm-pack-review-meta">
                            <span class="mcm-pack-review-file" translate="no">@item.FileName</span>
                            <span class="mcm-pack-review-why">@item.Reason</span>
                        </span>
                        <span class="sr-only">Locked</span>
                    </li>
                }
            </ul>
        }
    </div>

    @{
        var willSkip = AutomaticWillSkip;
    }
    <details class="mcm-pack-review-details" open="@OpenWillSkip">
        <summary class="mcm-pack-review-heading">
            Will skip
            <span class="mcm-pack-review-count">@willSkip.Count</span>
        </summary>
        @if (willSkip.Count == 0)
        {
            <p class="mcm-wizard-hint">No automatic skips.</p>
        }
        else
        {
            <ul class="mcm-pack-review-list mcm-slim-scroll" aria-label="Jars this pack will skip">
                @foreach (var item in willSkip)
                {
                    <li class="mcm-pack-review-item is-readonly" title="@item.Path">
                        <span class="mcm-pack-review-meta">
                            <span class="mcm-pack-review-file" translate="no">@item.FileName</span>
                            <span class="mcm-pack-review-why">@WillSkipWhy(item)</span>
                        </span>
                    </li>
                }
            </ul>
        }
    </details>
</section>

@code {
    [Parameter] public string IdPrefix { get; set; } = "pack";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public PackAssistedReview Review { get; set; } = PackAssistedReview.Empty;
    [Parameter] public string? FreezeBlockReason { get; set; }
    [Parameter] public bool LooksLikeLauncherInstance { get; set; }
    [Parameter] public Func<string, bool>? IsSkipped { get; set; }
    [Parameter] public EventCallback<PackAssistedReviewActions.OperatorSkipChange> SkipChanged { get; set; }

    private string _query = "";

    private string HeadingId => $"{IdPrefix}-review-heading";
    private string SearchId => $"{IdPrefix}-review-search";
    private string NeedsHeadingId => $"{IdPrefix}-review-needs";
    private string MustHeadingId => $"{IdPrefix}-review-must";

    private List<PackReviewItem> CallRows
    {
        get
        {
            var rows = new List<PackReviewItem>();
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            void Add(PackReviewItem item)
            {
                if (seen.Add(item.Path))
                    rows.Add(item);
            }

            foreach (var item in Review.NeedsYourCall)
                Add(item);
            foreach (var item in Review.WillSkip)
            {
                if (item.SkipReason == PackFileSkipReason.OperatorSkip || IsPathSkipped(item.Path))
                    Add(item);
            }

            foreach (var item in Review.MustKeep)
            {
                if (IsPathSkipped(item.Path))
                    Add(item);
            }

            return rows;
        }
    }

    private List<PackReviewItem> AutomaticWillSkip =>
        Review.WillSkip
            .Where(i => i.SkipReason != PackFileSkipReason.OperatorSkip && !IsPathSkipped(i.Path))
            .ToList();

    private List<PackReviewItem> FilteredCallRows
    {
        get
        {
            var q = _query.Trim();
            if (q.Length == 0)
                return CallRows;
            return CallRows
                .Where(i => i.FileName.Contains(q, StringComparison.OrdinalIgnoreCase)
                            || i.Path.Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private bool ShowSearch => CallRows.Count >= SetupPackImport.UnclearSideHighCountThreshold;

    private bool OpenWillSkip => AutomaticWillSkip.Count > 0 && AutomaticWillSkip.Count < SetupPackImport.UnclearSideHighCountThreshold;

    private bool IsPathSkipped(string path) => IsSkipped?.Invoke(path) == true;

    private string RowId(string group, PackReviewItem item)
    {
        var hash = StringComparer.OrdinalIgnoreCase.GetHashCode(item.Path);
        return $"{IdPrefix}-{group}-{unchecked((uint)hash):x}";
    }

    private static string CallWhy(PackReviewItem _, bool skipped) =>
        skipped ? "Will skip on the server" : "Unknown side · Keep";

    private static string WillSkipWhy(PackReviewItem item) =>
        item.SkipReason switch
        {
            PackFileSkipReason.PackDeclared => "Pack env.server",
            PackFileSkipReason.OverrideList => "Exclude list",
            PackFileSkipReason.InJarMetadata => "Client-only in the jar",
            PackFileSkipReason.OperatorSkip => "You marked Skip",
            _ => string.IsNullOrWhiteSpace(item.Reason) ? "Will skip" : item.Reason,
        };

    private void OnSearchInput(ChangeEventArgs e) =>
        _query = e.Value?.ToString() ?? "";

    private async Task OnSkipChange(PackReviewItem item, ChangeEventArgs e)
    {
        var skip = e.Value is bool b
            ? b
            : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        await SkipChanged.InvokeAsync(new PackAssistedReviewActions.OperatorSkipChange(item.Path, skip));
    }
}
