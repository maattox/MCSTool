@inject MainViewModel Vm
@implements IDisposable

@if (!Vm.SpendBrakeOverlayVisible)
{
    return;
}

<div class="mcm-spend-brake"
     role="alertdialog"
     aria-modal="true"
     aria-labelledby="mcm-spend-brake-title"
     aria-describedby="mcm-spend-brake-copy">
    <div class="mcm-spend-brake-panel">
        <p class="mcm-spend-brake-kicker">Server stopped</p>
        <h1 id="mcm-spend-brake-title" class="mcm-spend-brake-title">$1 spending limit reached</h1>

        <div id="mcm-spend-brake-copy" class="mcm-spend-brake-copy">
            <p>
                Your free monthly usage ran out, so the $1 spending limit stopped the game VM.
            </p>
            <p>
                It is not instant, so you might see about $1–$2 this month. The doorbell VM stays on.
            </p>
            <p>
                Wait for a new calendar month before turning the server back on. Clearing this lock does not start the server, and the lock does not clear itself.
            </p>
        </div>

        <p class="mcm-spend-brake-prompt">
            Type this statement exactly
        </p>
        <div class="mcm-spend-brake-sentence-row">
            <blockquote class="mcm-spend-brake-sentence">@Vm.SpendBrakeConfirmationSentence</blockquote>
            <button type="button"
                    class="mcm-spend-brake-copy-btn"
                    disabled="@Vm.SpendBrakeUnlockInFlight"
                    title="Copy confirmation sentence"
                    @onclick="Vm.CopySpendBrakeConfirmationAsync">
                <i class="ti ti-copy" aria-hidden="true"></i>
                Copy
            </button>
        </div>

        <label class="mcm-spend-brake-label" for="mcm-spend-brake-typed">Confirmation</label>
        <textarea id="mcm-spend-brake-typed"
                  class="mcm-spend-brake-input"
                  rows="4"
                  autocomplete="off"
                  spellcheck="false"
                  disabled="@Vm.SpendBrakeUnlockInFlight"
                  @bind="Vm.SpendBrakeTypedConfirm"
                  @bind:event="oninput"></textarea>

        @if (!string.IsNullOrWhiteSpace(Vm.SpendBrakeUnlockStatus))
        {
            <p class="mcm-spend-brake-status" role="status">@Vm.SpendBrakeUnlockStatus</p>
        }

        <p class="mcm-spend-brake-footnote">
            Use Start in the sidebar when you're ready. The idle timer and your daily and monthly hours limits still apply.
        </p>

        <div class="mcm-spend-brake-actions">
            <button type="button"
                    class="mcm-action-btn mcm-action-btn-start"
                    disabled="@(!Vm.CanConfirmSpendBrakeUnlock)"
                    @onclick="Vm.ConfirmSpendBrakeUnlockAsync">
                <i class="ti ti-lock-open" aria-hidden="true"></i>
                Clear lock
            </button>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnVmChanged;
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnVmChanged;
    }

    private void OnVmChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);
}
