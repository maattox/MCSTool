@using System.Collections.Generic
@using System.Linq
@using McManager.Core.Setup
@using McManager.Hybrid.Components.Setup

<section class="mcm-pack-review" aria-label="Client-only review">
    @if (ShowHeading)
    {
        <h2 id="@HeadingId" class="mcm-pack-review-title">Review jars</h2>
    }
    @if (LooksLikeLauncherInstance)
    {
        <p class="mcm-wizard-hint">@SetupPackImport.PrismExportHint</p>
    }
    @if (!string.IsNullOrWhiteSpace(FreezeBlockReason))
    {
        <p class="mcm-wizard-error" role="alert">@FreezeBlockReason Unmark Client-only on that jar to continue.</p>
    }

    @if (ShowSearch)
    {
        <div class="mcm-field mcm-pack-review-search">
            <label for="@SearchId">Find a jar</label>
            <input id="@SearchId"
                   type="search"
                   name="@(IdPrefix)-review-search"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="Filename…"
                   value="@_query"
                   disabled="@Disabled"
                   @oninput="OnSearchInput" />
        </div>
    }

    @if (FilteredRows.Count == 0)
    {
        <p class="mcm-wizard-hint">@(AllRows.Count == 0 ? "No jars to review." : "No jars match that name.")</p>
    }
    else
    {
        <div class="mcm-pack-review-head" aria-hidden="true">
            <span class="mcm-pack-review-client-head">Client-only</span>
            <span class="mcm-pack-review-note">Note</span>
        </div>
        <ul class="mcm-pack-review-list mcm-slim-scroll" aria-label="Mods in this pack">
            @foreach (var item in FilteredRows)
            {
                var inputId = RowId(item);
                var mustKeep = IsMustKeep(item.Path);
                var skipped = IsClientOnly(item);
                var locked = mustKeep && !IsPathSkipped(item.Path);
                var note = RowNote(item);
                <li class="mcm-pack-review-item @(locked ? "is-locked" : "")">
                    <label class="mcm-check-hit mcm-pack-review-hit" for="@inputId" title="@item.Path">
                        <input id="@inputId"
                               type="checkbox"
                               name="@(IdPrefix)-client-only"
                               autocomplete="off"
                               disabled="@(Disabled || locked)"
                               checked="@skipped"
                               aria-label="@($"Client-only, {item.FileName}")"
                               @onchange="e => OnSkipChange(item, e)" />
                        <span class="mcm-pack-review-file" translate="no">@item.FileName</span>
                    </label>
                    <span class="mcm-pack-review-note">@note</span>
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter] public string IdPrefix { get; set; } = "pack";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public PackAssistedReview Review { get; set; } = PackAssistedReview.Empty;
    [Parameter] public IReadOnlyList<string>? JarOrder { get; set; }
    [Parameter] public string? FreezeBlockReason { get; set; }
    [Parameter] public bool LooksLikeLauncherInstance { get; set; }
    [Parameter] public bool ShowHeading { get; set; }
    [Parameter] public Func<string, bool>? IsSkipped { get; set; }
    [Parameter] public EventCallback<PackAssistedReviewActions.OperatorSkipChange> SkipChanged { get; set; }

    private string _query = "";
    private PackAssistedReview? _mustKeepSource;
    private HashSet<string>? _mustKeepPaths;

    private string HeadingId => $"{IdPrefix}-review-heading";
    private string SearchId => $"{IdPrefix}-review-search";

    private HashSet<string> MustKeepPaths
    {
        get
        {
            if (_mustKeepSource != Review || _mustKeepPaths is null)
            {
                _mustKeepSource = Review;
                _mustKeepPaths = Review.MustKeep
                    .Select(i => i.Path)
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);
            }

            return _mustKeepPaths;
        }
    }

    private IReadOnlyList<PackReviewItem> AllRows => Review.UnifiedRows(JarOrder);

    private IReadOnlyList<PackReviewItem> FilteredRows
    {
        get
        {
            var q = _query.Trim();
            if (q.Length == 0)
                return AllRows;
            return AllRows
                .Where(i => i.FileName.Contains(q, StringComparison.OrdinalIgnoreCase)
                            || i.Path.Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private bool ShowSearch => AllRows.Count >= SetupPackImport.UnclearSideHighCountThreshold;

    private bool IsPathSkipped(string path) => IsSkipped?.Invoke(path) == true;

    private bool IsMustKeep(string path) => MustKeepPaths.Contains(path);

    private bool IsClientOnly(PackReviewItem item)
    {
        if (IsMustKeep(item.Path) && !IsPathSkipped(item.Path))
            return false;
        if (IsPathSkipped(item.Path))
            return true;
        return IsAutomaticClientOnly(item);
    }

    private static bool IsAutomaticClientOnly(PackReviewItem item) =>
        item.SkipReason is PackFileSkipReason.PackDeclared
            or PackFileSkipReason.OverrideList
            or PackFileSkipReason.InJarMetadata;

    private string RowNote(PackReviewItem item)
    {
        if (IsMustKeep(item.Path))
        {
            if (!string.IsNullOrWhiteSpace(item.RequiredByName))
                return "required by " + item.RequiredByName;
            return item.Reason;
        }

        if (IsAutomaticClientOnly(item))
        {
            return item.SkipReason switch
            {
                PackFileSkipReason.PackDeclared => "env.server",
                PackFileSkipReason.OverrideList => "exclude list",
                PackFileSkipReason.InJarMetadata => "in-jar client",
                _ => string.IsNullOrWhiteSpace(item.Reason) ? "" : item.Reason,
            };
        }

        return "";
    }

    private string RowId(PackReviewItem item)
    {
        var hash = StringComparer.OrdinalIgnoreCase.GetHashCode(item.Path);
        return $"{IdPrefix}-row-{unchecked((uint)hash):x}";
    }

    private void OnSearchInput(ChangeEventArgs e) =>
        _query = e.Value?.ToString() ?? "";

    private async Task OnSkipChange(PackReviewItem item, ChangeEventArgs e)
    {
        var skip = e.Value is bool b
            ? b
            : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        await SkipChanged.InvokeAsync(new PackAssistedReviewActions.OperatorSkipChange(item.Path, skip));
    }
}
