@inject AdvancedViewModel Vm
@implements IDisposable

<div class="mcm-pane-stack">
    <nav class="mcm-subtabs" role="tablist" aria-label="Advanced sections">
        <button type="button"
                role="tab"
                class="mcm-subtab @PaneClass("status")"
                aria-selected="@(IsPane("status") ? "true" : "false")"
                @onclick="@(() => SelectPane("status"))">
            Status
        </button>
        <button type="button"
                role="tab"
                class="mcm-subtab @PaneClass("stack")"
                aria-selected="@(IsPane("stack") ? "true" : "false")"
                @onclick="@(() => SelectPane("stack"))">
            Setup
        </button>
        <button type="button"
                role="tab"
                class="mcm-subtab @PaneClass("danger")"
                aria-selected="@(IsPane("danger") ? "true" : "false")"
                @onclick="@(() => SelectPane("danger"))">
            Danger Zone
        </button>
    </nav>

    @if (IsPane("status"))
    {
    <div class="mcm-pane-stack" role="tabpanel">
    <div class="mcm-section-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:10px;">
            <span style="font-size:14px;font-weight:600;">VM status</span>
            <button type="button"
                    class="mcm-help"
                    title="The sidebar only shows whether the server is Running or Stopped. Details for each VM are here.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About VM status</span>
            </button>
        </div>
        <div style="display:grid;grid-template-columns:180px 1fr;gap:8px 12px;align-items:center;">
            <span style="color:var(--text-muted);">Game VM</span>
            <span style="font-family:var(--font-mono);">@Vm.GameVmLifecycle</span>
            <span style="color:var(--text-muted);">Doorbell VM</span>
            <span style="font-family:var(--font-mono);">@Vm.DoorVmLifecycle</span>
            <span style="color:var(--text-muted);">Doorbell service</span>
            <span style="font-family:var(--font-mono);">@Vm.DoorServiceState</span>
        </div>
    </div>

    <div class="mcm-section-card">
        <div style="font-size:14px;font-weight:600;margin-bottom:6px;">Emergency power</div>
        <p style="margin:0 0 10px;font-size:13px;color:var(--text-secondary);">
                    Starts or stops the game VM directly in Oracle Cloud. Doesn't move the play IP. Use Start and Stop in the sidebar for normal use.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
            <button type="button"
                    disabled="@Vm.IsBusy"
                    title="Starts the game VM only. Doesn't move the play IP."
                    @onclick="Vm.BreakGlassStartAsync">
                Start game VM
            </button>
            <button type="button"
                    disabled="@Vm.IsBusy"
                    title="Stops the game VM only. Doesn't move the play IP."
                    @onclick="Vm.BreakGlassSoftStopAsync">
                Stop game VM
            </button>
        </div>
    </div>
    </div>
    }
    else if (IsPane("stack"))
    {
    <div class="mcm-pane-stack" role="tabpanel">
    <div class="mcm-section-card">
        <div style="font-size:14px;font-weight:600;margin-bottom:6px;">This PC's servers</div>
        @if (Vm.ShowServerSwitcher)
        {
            <p style="margin:0 0 10px;font-size:13px;color:var(--text-secondary);">
                Each server is a separate folder on this PC. Switching reloads MCSTool from that folder. Add server opens the Welcome screen for a new empty folder.
            </p>
            <div class="mcm-field">
                <label for="mcm-adv-server">Switch server</label>
                <select id="mcm-adv-server"
                        disabled="@Vm.IsBusy"
                        @bind="Vm.SelectedServerId"
                        @bind:event="onchange">
                    @foreach (var server in Vm.Servers)
                    {
                        <option value="@server.Id">@server.DisplayName</option>
                    }
                </select>
            </div>
            <div class="mcm-field mcm-field-short">
                <label for="mcm-adv-server-rename">Rename</label>
                <input id="mcm-adv-server-rename"
                       type="text"
                       disabled="@Vm.IsBusy"
                       @bind="Vm.RenameServerName"
                       @bind:event="oninput" />
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;">
                <button type="button"
                        disabled="@Vm.IsBusy"
                        @onclick="Vm.RenameServerAsync">
                    Save name
                </button>
            </div>
            <div class="mcm-field mcm-field-short">
                <label for="mcm-adv-server-add">Add server</label>
                <input id="mcm-adv-server-add"
                       type="text"
                       disabled="@Vm.IsBusy"
                       placeholder="My Server"
                       @bind="Vm.NewServerName"
                       @bind:event="oninput" />
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:4px;">
                <button type="button"
                        class="mcm-primary"
                        disabled="@Vm.IsBusy"
                        title="Creates an empty folder and opens the Welcome screen. Nothing is created in Oracle Cloud until you Deploy."
                        @onclick="Vm.AddServerAsync">
                    Add server
                </button>
            </div>
        }
        else
        {
            <p style="margin:0;font-size:13px;color:var(--text-secondary);">
                Using env override. Server switching is off. OpenTofu state for this process is in this folder, not a sibling server.
            </p>
        }
    </div>

    <div class="mcm-section-card">
        <div style="font-size:14px;font-weight:600;margin-bottom:6px;">Cloud setup</div>
        <p style="margin:0 0 10px;font-size:13px;color:var(--text-secondary);">
            Set up a new server, repair this one, or connect this PC to a server already in your Oracle account. Find existing server only runs when you click it.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
            <button type="button"
                    title="Opens Setup so you can resume or run it again. Don't click Deploy twice on the same finished page."
                    @onclick="Vm.OpenSetup">
                Deploy / repair
            </button>
            <button type="button"
                    disabled="@Vm.IsBusy"
                    title="Looks in your Oracle account for a server made with MCSTool and asks before saving anything."
                    @onclick="Vm.AutoDetectAsync">
                Find existing server
            </button>
        </div>
    </div>

    <div class="mcm-section-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span style="font-size:14px;font-weight:600;">SSH addresses</span>
            <button type="button"
                    class="mcm-help"
                    title="The public IPs MCSTool uses for SSH (PuTTY, WinSCP). Players join with the play IP in the sidebar. Refresh reads the current IPs from Oracle and saves them on this PC.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About SSH addresses</span>
            </button>
        </div>
        <p style="margin:0 0 10px;font-size:13px;color:var(--text-secondary);">
            Players use the play IP@(string.IsNullOrWhiteSpace(Vm.PlayReservedIp) ? "" : " (" + Vm.PlayReservedIp + ")"). These addresses are for SSH tools.
        </p>
        <ul class="mcm-path-list">
            <li class="mcm-path-row">
                <div class="mcm-path-copy">
                    <span class="mcm-path-label">Game VM</span>
                    <span class="mcm-path-hint">Public IP for SSH to the game VM.</span>
                    <code class="mcm-path-value">@Vm.Vm1SshHostDisplay</code>
                </div>
                <div class="mcm-path-actions">
                    <button type="button"
                            class="mcm-copy-inline"
                            disabled="@(!Vm.HasVm1SshHost)"
                            title="Copy game VM SSH IP"
                            aria-label="Copy game VM SSH IP"
                            @onclick="Vm.CopyVm1SshHostAsync">
                        <i class="ti ti-copy" aria-hidden="true"></i>
                    </button>
                </div>
            </li>
            <li class="mcm-path-row">
                <div class="mcm-path-copy">
                    <span class="mcm-path-label">Doorbell VM</span>
                    <span class="mcm-path-hint">Public IP for SSH to the doorbell VM.</span>
                    <code class="mcm-path-value">@Vm.DoorSshHostDisplay</code>
                </div>
                <div class="mcm-path-actions">
                    <button type="button"
                            class="mcm-copy-inline"
                            disabled="@(!Vm.HasDoorSshHost)"
                            title="Copy doorbell VM SSH IP"
                            aria-label="Copy doorbell VM SSH IP"
                            @onclick="Vm.CopyDoorSshHostAsync">
                        <i class="ti ti-copy" aria-hidden="true"></i>
                    </button>
                </div>
            </li>
        </ul>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;">
            <button type="button"
                    disabled="@(!Vm.CanRefreshSshHosts)"
                    @onclick="Vm.RefreshSshHostsFromOciAsync">
                Refresh from Oracle
            </button>
        </div>
    </div>

    <div class="mcm-section-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span style="font-size:14px;font-weight:600;">Player map</span>
            <button type="button"
                    class="mcm-help"
                    title="Players open this in a browser. It uses the doorbell VM's address, not the play IP. Players must be on the whitelist.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About the player map URL</span>
            </button>
        </div>
        <p style="margin:0 0 10px;font-size:13px;color:var(--text-secondary);">
            Explored areas of the world. Works while the game VM is off.
        </p>
        <ul class="mcm-path-list">
            <li class="mcm-path-row">
                <div class="mcm-path-copy">
                    <span class="mcm-path-label">Map URL</span>
                    <span class="mcm-path-hint">Refresh from Oracle above updates this if the address changes.</span>
                    <code class="mcm-path-value">@Vm.PlayerMapUrlDisplay</code>
                </div>
                <div class="mcm-path-actions">
                    <button type="button"
                            class="mcm-copy-inline"
                            disabled="@(!Vm.HasPlayerMapUrl)"
                            title="Copy player map URL"
                            aria-label="Copy player map URL"
                            @onclick="Vm.CopyPlayerMapUrlAsync">
                        <i class="ti ti-copy" aria-hidden="true"></i>
                    </button>
                </div>
            </li>
        </ul>
    </div>

    <div class="mcm-section-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span style="font-size:14px;font-weight:600;">SSH keys (this PC)</span>
            <button type="button"
                    class="mcm-help"
                    title="@Vm.SshKeyHelp">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About SSH keys</span>
            </button>
        </div>
        <p style="margin:0 0 10px;font-size:13px;color:var(--text-secondary);">
            Game VM and doorbell VM can use different private keys. Paths stay on this PC. Changing a path does not install a new key on the VM.
        </p>
        @if (Vm.SshKeysUseSameFile)
        {
            <p style="margin:0 0 10px;font-size:12px;color:var(--text-muted);">Both VMs currently use the same file.</p>
        }
        <ul class="mcm-path-list">
            <li class="mcm-path-row">
                <div class="mcm-path-copy">
                    <span class="mcm-path-label">Game VM</span>
                    <span class="mcm-path-hint">Used for Minecraft, world, modpack, and idle timer changes.</span>
                    <code class="mcm-path-value @(Vm.Vm1SshKeyMissing ? "is-missing" : null)">
                        @(string.IsNullOrWhiteSpace(Vm.EditVm1SshKeyPath) ? "—" : Vm.EditVm1SshKeyPath)
                    </code>
                </div>
                <div class="mcm-path-actions">
                    <button type="button"
                            disabled="@Vm.IsBusy"
                            title="Choose a private key file for the game VM"
                            @onclick="Vm.BrowseVm1SshKeyAsync">
                        Browse
                    </button>
                    <button type="button"
                            disabled="@(Vm.IsBusy || Vm.Vm1SshKeyMissing)"
                            title="Try SSH with the selected key. The game VM must be Running."
                            @onclick="Vm.TestVm1SshAsync">
                        Test
                    </button>
                    @if (Vm.CanCopyDoorKeyToVm1)
                    {
                        <button type="button"
                                title="Use the doorbell VM private key for the game VM too"
                                @onclick="Vm.CopyDoorKeyToVm1">
                            Use doorbell VM key
                        </button>
                    }
                </div>
            </li>
            <li class="mcm-path-row">
                <div class="mcm-path-copy">
                    <span class="mcm-path-label">Doorbell VM</span>
                    <span class="mcm-path-hint">Used for Troubleshooting and repairs on the doorbell VM.</span>
                    <code class="mcm-path-value @(Vm.DoorSshKeyMissing ? "is-missing" : null)">
                        @(string.IsNullOrWhiteSpace(Vm.EditDoorSshKeyPath) ? "—" : Vm.EditDoorSshKeyPath)
                    </code>
                </div>
                <div class="mcm-path-actions">
                    <button type="button"
                            disabled="@Vm.IsBusy"
                            title="Choose a private key file for the doorbell VM"
                            @onclick="Vm.BrowseDoorSshKeyAsync">
                        Browse
                    </button>
                    <button type="button"
                            disabled="@(Vm.IsBusy || Vm.DoorSshKeyMissing)"
                            title="Try SSH with the selected key. The doorbell VM is usually always on."
                            @onclick="Vm.TestDoorSshAsync">
                        Test
                    </button>
                    @if (Vm.CanCopyVm1KeyToDoor)
                    {
                        <button type="button"
                                title="Use the game VM private key for the doorbell VM too"
                                @onclick="Vm.CopyVm1KeyToDoor">
                            Use game VM key
                        </button>
                    }
                </div>
            </li>
        </ul>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;">
            <button type="button"
                    class="mcm-primary"
                    disabled="@(!Vm.CanSaveSshKeys)"
                    @onclick="Vm.SaveSshKeysAsync">
                Save SSH keys
            </button>
        </div>
    </div>

    <div class="mcm-section-card">
        <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px;">
            <span style="font-size:14px;font-weight:600;">Server details for other PCs</span>
            <button type="button"
                    class="mcm-help"
                    title="Saves this server's details to cloud storage so another PC can find it with Find existing server. Never includes SSH keys, API keys, or the console password.">
                <i class="ti ti-help" aria-hidden="true"></i>
                <span class="sr-only">About server details</span>
            </button>
        </div>
        <p style="margin:0 0 12px;font-size:12px;opacity:0.85;font-family:var(--font-mono);white-space:pre-wrap;">@Vm.InfraSummary</p>
        <div style="display:grid;grid-template-columns:200px 1fr;gap:8px 12px;align-items:center;">
            <label for="mcm-adv-stack-version">Setup version</label>
            <input id="mcm-adv-stack-version"
                   type="text"
                   disabled="@Vm.IsBusy"
                   @bind="Vm.EditStackVersion"
                   @bind:event="oninput" />

            <label for="mcm-adv-server-kind">Server type</label>
            <input id="mcm-adv-server-kind"
                   type="text"
                   disabled="@Vm.IsBusy"
                   @bind="Vm.EditServerKind"
                   @bind:event="oninput" />

            <label for="mcm-adv-mc-version">Minecraft version</label>
            <input id="mcm-adv-mc-version"
                   type="text"
                   disabled="@Vm.IsBusy"
                   @bind="Vm.EditMinecraftVersion"
                   @bind:event="oninput" />
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;">
            <button type="button"
                    disabled="@Vm.IsBusy"
                    @onclick="Vm.RefreshInfraMetaAsync">
                Refresh
            </button>
            <button type="button"
                    class="mcm-primary"
                    disabled="@(!Vm.CanPublishInfra)"
                    @onclick="Vm.PublishInfraMetaAsync">
                Save changes
            </button>
        </div>
    </div>

    @if (UiHostProbes.Enabled)
    {
        <div class="mcm-section-card">
            <div style="font-size:14px;font-weight:600;margin-bottom:6px;">DEBUG host probes</div>
            <p style="margin:0 0 8px;font-size:13px;color:var(--text-secondary);">
                Debug builds only. Confirms the confirm modal, clipboard, native file picker, local .mrpack / server-pack zip analyze (no install), spend-brake overlay fixture, and a fake bell notification still work.
            </p>
            <HostServiceProbes />
        </div>
    }
    </div>
    }
    else
    {
    <div class="mcm-pane-stack" role="tabpanel">
        <DangerZoneTab />
    </div>
    }
</div>

@code {
    private string _pane = "status";

    private bool IsPane(string id) => string.Equals(_pane, id, StringComparison.Ordinal);

    private string PaneClass(string id) => IsPane(id) ? "is-active" : "";

    private void SelectPane(string pane) => _pane = pane;

    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnVmChanged;
        Vm.OnTabSelected();
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnVmChanged;
        Vm.OnTabLeft();
    }

    private void OnVmChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);
}
