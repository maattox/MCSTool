@inject FirstRunViewModel Vm
@implements IDisposable

<div class="mcm-app">
    <CaptionBar />

    <div class="mcm-firstrun">
        <header class="mcm-firstrun-intro">
            <h1>Welcome</h1>
            <p class="mcm-firstrun-lead">
                MCSTool creates a Vanilla (Paper) or modded Minecraft server on Oracle Always Free
                and lets you manage it from this app. Players join one address. When nobody is playing,
                the game VM sleeps and a small always-on doorbell VM can wake it.
            </p>
        </header>

        <div class="mcm-firstrun-actions">
            <button type="button"
                    class="mcm-firstrun-choice mcm-firstrun-choice-primary"
                    disabled="@Vm.IsBusy"
                    @onclick="Vm.OpenSetup">
                <span class="mcm-firstrun-choice-title">Set up a new server</span>
                <span class="mcm-firstrun-choice-copy">Walk through Setup and create both VMs in Oracle Cloud.</span>
            </button>
            <button type="button"
                    class="mcm-firstrun-choice"
                    disabled="@Vm.IsBusy"
                    @onclick="Vm.DetectAsync">
                <span class="mcm-firstrun-choice-title">Find an existing server</span>
                <span class="mcm-firstrun-choice-copy">Looks in your Oracle account for a server made with MCSTool and asks before saving anything.</span>
            </button>
            <button type="button"
                    class="mcm-firstrun-choice"
                    disabled="@Vm.IsBusy"
                    @onclick="Vm.OpenExistingStack">
                <span class="mcm-firstrun-choice-title">Use settings on this PC</span>
                <span class="mcm-firstrun-choice-copy">Opens MCSTool without checking Oracle Cloud. Use this if you already copied this server's settings onto this PC.</span>
            </button>
        </div>

        @if (Vm.CanCancelAdd)
        {
            <button type="button"
                    class="mcm-firstrun-cancel"
                    disabled="@Vm.IsBusy"
                    title="Go back and delete this new empty server folder. Other servers on this PC are kept."
                    @onclick="Vm.CancelAdd">
                Cancel
            </button>
        }

        @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
        {
            <p class="mcm-firstrun-status">@Vm.StatusMessage</p>
        }

        @if (Vm.ConfigHost.LoadFailed)
        {
            <p class="mcm-firstrun-error">@Vm.ConfigHost.LoadResult.Error</p>
        }
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnVmChanged;
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnVmChanged;
    }

    private void OnVmChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);
}
