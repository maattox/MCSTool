@using McManager.Core.Services
@implements IDisposable
@inject IJSRuntime JS
@inject IClipboard Clipboard

<div class="mcm-motd-editor">
    <div class="mcm-motd-toolbar"
         role="toolbar"
         aria-label="MOTD formatting"
         @onmousedown:preventDefault="true">
        <div class="mcm-motd-swatches" role="group" aria-label="Colors">
            @foreach (var color in MotdFormatting.VanillaColors)
            {
                <button type="button"
                        class="mcm-motd-swatch"
                        style="background:@color.Hex"
                        disabled="@Disabled"
                        title="@($"{color.Name} (§{color.Code})")"
                        aria-label="@($"{color.Name} (§{color.Code})")"
                        @onclick="@(() => WrapAsync(color.Code))">
                </button>
            }
        </div>
        <div class="mcm-motd-formats" role="group" aria-label="Formats">
            @foreach (var fmt in MotdFormatting.Formats)
            {
                <button type="button"
                        class="mcm-motd-fmt @(string.IsNullOrEmpty(fmt.IconClass) ? "mcm-motd-fmt-label" : null)"
                        disabled="@Disabled"
                        title="@($"{fmt.Name} (§{fmt.Code})")"
                        aria-label="@($"{fmt.Name} (§{fmt.Code})")"
                        @onclick="@(() => WrapAsync(fmt.Code))">
                    @if (string.IsNullOrEmpty(fmt.IconClass))
                    {
                        <span>@fmt.Name</span>
                    }
                    else
                    {
                        <i class="ti @fmt.IconClass" aria-hidden="true"></i>
                    }
                </button>
            }
        </div>
    </div>
    <div class="mcm-field mcm-motd-field">
        <label class="mcm-field-head" for="@NameId">Server name</label>
        <div @ref="_nameEl"
             id="@NameId"
             class="mcm-motd-surface mcm-motd-surface-name"
             role="textbox"
             aria-multiline="false"
             aria-label="Server name"
             contenteditable="@(Disabled ? "false" : "true")"
             spellcheck="false"
             @onfocus="@(() => _focused = "name")"></div>
    </div>
    <div class="mcm-field mcm-motd-field">
        <label class="mcm-field-head" for="@DescId">Description</label>
        <div @ref="_descEl"
             id="@DescId"
             class="mcm-motd-surface mcm-motd-surface-desc"
             role="textbox"
             aria-multiline="false"
             aria-label="Description"
             contenteditable="@(Disabled ? "false" : "true")"
             spellcheck="false"
             @onfocus="@(() => _focused = "desc")"></div>
    </div>
    <p class="mcm-motd-preview" aria-live="polite">
        <span class="mcm-motd-preview-label">Server list preview</span>
        @((MarkupString)PreviewHtml)
    </p>
    <p class="mcm-motd-counters" aria-live="polite">
        @foreach (var metric in LineMetrics)
        {
            <span>@metric.Label</span>
        }
    </p>
    <div class="mcm-field mcm-motd-field mcm-motd-raw">
        <label class="mcm-field-head" for="@RawId">Raw motd= string</label>
        <div class="mcm-motd-raw-row">
            <textarea id="@RawId"
                      class="mcm-motd-raw-input"
                      rows="2"
                      spellcheck="false"
                      autocomplete="off"
                      disabled="@Disabled"
                      value="@RawBoxValue"
                      @onfocus="OnRawFocus"
                      @onblur="OnRawBlur"
                      @oninput="OnRawInput"></textarea>
            <button type="button"
                    class="mcm-motd-copy"
                    disabled="@Disabled"
                    @onclick="CopyRawAsync">
                @(_copied ? "Copied" : "Copy")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string ServerName { get; set; } = "";
    [Parameter] public EventCallback<string> ServerNameChanged { get; set; }
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public EventCallback<string> DescriptionChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string IdPrefix { get; set; } = "mcm-motd";

    private ElementReference _nameEl;
    private ElementReference _descEl;
    private DotNetObjectReference<MotdEditor>? _net;
    private bool _copied;
    private bool _nameSync = true;
    private bool _descSync = true;
    private int? _nameCaretStart;
    private int? _nameCaretEnd;
    private int? _descCaretStart;
    private int? _descCaretEnd;
    private string _nameRaw = "";
    private string _descRaw = "";
    private string _focused = "desc";
    private bool _rawFocused;
    private string? _rawOverride;

    private string NameId => IdPrefix + "-name";
    private string DescId => IdPrefix + "-desc";
    private string RawId => IdPrefix + "-raw";

    private string RawEditText =>
        string.Join('\n', MotdFormatting.SplitListLines(RawMotd));

    private string RawBoxValue => _rawFocused && _rawOverride is not null ? _rawOverride : RawEditText;

    private string RawMotd =>
        ServerIdentityUx.BuildMotd(ServerName, Description);

    private string PreviewHtml => MotdFormatting.ToPreviewHtml(RawMotd);

    private IReadOnlyList<MotdFormatting.MotdLineMetric> LineMetrics =>
        MotdFormatting.MeasureIdentityLines(ServerName, Description);

    protected override void OnParametersSet()
    {
        var name = MotdFormatting.ClipToListLine(ServerName);
        if (name != _nameRaw)
        {
            _nameRaw = name;
            _nameSync = true;
        }

        var desc = MotdFormatting.ClipToListLine(Description);
        if (desc != _descRaw)
        {
            _descRaw = desc;
            _descSync = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _net ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("mcmMotd.bind", _nameEl, _net, "name", true);
            await JS.InvokeVoidAsync("mcmMotd.bind", _descEl, _net, "desc", true);
            if (_nameSync)
            {
                await JS.InvokeVoidAsync(
                    "mcmMotd.setHtml",
                    _nameEl,
                    MotdFormatting.ToEditorHtml(_nameRaw),
                    _nameCaretStart,
                    _nameCaretEnd);
                _nameSync = false;
                _nameCaretStart = null;
                _nameCaretEnd = null;
            }

            if (_descSync)
            {
                await JS.InvokeVoidAsync(
                    "mcmMotd.setHtml",
                    _descEl,
                    MotdFormatting.ToEditorHtml(_descRaw),
                    _descCaretStart,
                    _descCaretEnd);
                _descSync = false;
                _descCaretStart = null;
                _descCaretEnd = null;
            }
        }
        catch (Exception)
        {
            // WebView JS may not be ready on the first frame.
        }
    }

    [JSInvokable]
    public Task MotdFocus(string field)
    {
        if (field is "name" or "desc")
            _focused = field;
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task MotdTyped(string field, string text)
    {
        if (Disabled)
            return;
        var clipped = MotdFormatting.ClipToListLine(text);
        var vis = MotdFormatting.RawToVisible(clipped, clipped.Length);
        if (clipped != (text ?? ""))
            await SetFieldAsync(field, clipped, vis, vis);
        else
            await SetFieldAsync(field, clipped, syncHtml: false);
    }

    [JSInvokable]
    public async Task MotdPaste(string field, string raw, int start, int end)
    {
        if (Disabled)
            return;
        var insert = MotdFormatting.ClipToListLine(MotdFormatting.NormalizePaste(raw));
        await InsertAsync(field, insert, start, end);
    }

    [JSInvokable]
    public Task MotdEnter(string field, int start, int end) =>
        Task.CompletedTask;

    private async Task WrapAsync(char code)
    {
        if (Disabled)
            return;
        var field = _focused is "name" or "desc" ? _focused : "desc";
        var el = field == "name" ? _nameEl : _descEl;
        var text = field == "name" ? _nameRaw : _descRaw;
        var visStart = MotdFormatting.RawToVisible(text, text.Length);
        var visEnd = visStart;
        try
        {
            var range = await JS.InvokeAsync<MotdRange>("mcmMotd.getRange", el);
            visStart = range.Start;
            visEnd = range.End;
        }
        catch (Exception)
        {
            // Keep caret-at-end fallback.
        }

        var lo = MotdFormatting.VisibleToRaw(text, visStart);
        var hi = MotdFormatting.VisibleToRaw(text, visEnd);
        var result = MotdFormatting.ToggleSpan(text, lo, hi, code);
        var next = MotdFormatting.ClipToListLine(result.Text);
        var c0 = MotdFormatting.RawToVisible(next, Math.Min(result.InnerStart, next.Length));
        var c1 = MotdFormatting.RawToVisible(next, Math.Min(result.InnerEnd, next.Length));
        await SetFieldAsync(field, next, c0, c1);
    }

    private async Task InsertAsync(string field, string insert, int visStart, int visEnd)
    {
        var text = field == "name" ? _nameRaw : _descRaw;
        insert = MotdFormatting.ClipToListLine(insert);
        var lo = MotdFormatting.VisibleToRaw(text, visStart);
        var hi = MotdFormatting.VisibleToRaw(text, visEnd);
        var next = MotdFormatting.ClipToListLine(text[..lo] + insert + text[hi..]);
        var caretRaw = Math.Min(lo + insert.Length, next.Length);
        var caret = MotdFormatting.RawToVisible(next, caretRaw);
        await SetFieldAsync(field, next, caret, caret);
    }

    private async Task SetFieldAsync(string field, string next, int? caretStart = null, int? caretEnd = null, bool syncHtml = true)
    {
        if (field == "name")
        {
            _nameRaw = next;
            ServerName = next;
            if (syncHtml)
            {
                _nameSync = true;
                _nameCaretStart = caretStart;
                _nameCaretEnd = caretEnd;
            }
            await ServerNameChanged.InvokeAsync(next);
            StateHasChanged();
            return;
        }

        _descRaw = next;
        Description = next;
        if (syncHtml)
        {
            _descSync = true;
            _descCaretStart = caretStart;
            _descCaretEnd = caretEnd;
        }
        await DescriptionChanged.InvokeAsync(next);
        StateHasChanged();
    }

    private void OnRawFocus()
    {
        _rawFocused = true;
        _rawOverride ??= RawEditText;
    }

    private void OnRawBlur()
    {
        _rawFocused = false;
        _rawOverride = null;
    }

    private async Task OnRawInput(ChangeEventArgs e)
    {
        if (Disabled)
            return;
        var typed = e.Value?.ToString() ?? "";
        _rawOverride = typed;
        _rawFocused = true;
        await ApplyRawAsync(typed);
    }

    private async Task ApplyRawAsync(string raw)
    {
        var parsed = MotdFormatting.NormalizePaste(raw);
        var lines = MotdFormatting.SplitListLines(parsed);
        var name = MotdFormatting.ClipToListLine(lines.Count > 0 ? lines[0] : "");
        var desc = MotdFormatting.ClipToListLine(lines.Count > 1 ? lines[1] : "");
        _nameRaw = name;
        ServerName = name;
        _nameSync = true;
        _descRaw = desc;
        Description = desc;
        _descSync = true;
        await ServerNameChanged.InvokeAsync(name);
        await DescriptionChanged.InvokeAsync(desc);
        StateHasChanged();
    }

    private async Task CopyRawAsync()
    {
        try
        {
            await Clipboard.SetTextAsync(RawMotd);
            _copied = true;
        }
        catch (Exception)
        {
            _copied = false;
        }
    }

    public void Dispose() => _net?.Dispose();

    private sealed class MotdRange
    {
        public int Start { get; set; }
        public int End { get; set; }
    }
}
