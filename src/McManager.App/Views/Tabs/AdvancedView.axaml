<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:McManager.App.ViewModels"
             x:Class="McManager.App.Views.Tabs.AdvancedView"
             x:DataType="vm:AdvancedViewModel">
    <ScrollViewer Padding="16">
        <StackPanel Spacing="20" MaxWidth="720">
            <StackPanel Spacing="12">
                <TextBlock Text="Break-glass VM power"
                           FontWeight="SemiBold"
                           FontSize="16" />
                <TextBlock Text="These call OCI Compute directly and do NOT move the reserved play IP. Prefer the top-bar Start/Stop (door wake / idle-empty)."
                           TextWrapping="Wrap"
                           Opacity="0.8" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Raw VM Start"
                            Command="{Binding BreakGlassStartCommand}"
                            IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Raw VM SoftStop"
                            Command="{Binding BreakGlassSoftStopCommand}"
                            IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
            </StackPanel>

            <Border Padding="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    CornerRadius="4">
                <StackPanel Spacing="12">
                    <TextBlock Text="Danger Zone — Idle agent"
                               FontWeight="SemiBold"
                               FontSize="16" />
                    <TextBlock TextWrapping="Wrap"
                               Opacity="0.9"
                               Text="Disable is testing/troubleshooting only. Every VM1 boot / Minecraft start FORCE-ENABLES the idle timer and rewrites shared Object Storage budget to enabled if it was off (OS-ISSUE-7). A forgotten disable cannot leave Always Free brakes off after a restart. Prefer this tab (not Usage) for enable/disable + apply-to-VM." />

                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Idle timeout (min)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditIdleTimeout}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Budget warn (min)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditBudgetWarn}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Idle agent enabled" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="2" Grid.Column="1"
                                  Content="mc-idle-watch.timer active (empty + daily SoftStop)"
                                  IsChecked="{Binding EditIdleAgentEnabled}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Refresh from Object Storage"
                                Command="{Binding RefreshIdleFromOsCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                        <Button Content="Apply idle settings"
                                Command="{Binding ApplyIdleSettingsCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    CornerRadius="4">
                <StackPanel Spacing="12">
                    <TextBlock Text="Infrastructure meta (Object Storage)"
                               FontWeight="SemiBold"
                               FontSize="16" />
                    <TextBlock TextWrapping="Wrap"
                               Opacity="0.9"
                               Text="Publishes meta/infra.json for Connect existing / Setup (nested v2). Seeds from local config OCIDs — never SSH private keys, OCI API paths, or RCON. Game fields are recorded for support; lab Forge stacks may still use server_kind=vanilla until Setup records the real install." />
                    <TextBlock Text="{Binding InfraSummary}"
                               TextWrapping="Wrap"
                               Opacity="0.85"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="12" />
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="stack_version" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditStackVersion}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="server_kind" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditServerKind}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="minecraft_version" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditMinecraftVersion}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Refresh infra meta"
                                Command="{Binding RefreshInfraMetaCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                        <Button Content="Publish infra meta from local config"
                                Command="{Binding PublishInfraMetaCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Opacity="0.85" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
