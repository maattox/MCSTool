<Window x:Class="McManager.Hybrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:components="clr-namespace:McManager.Hybrid.Components"
        mc:Ignorable="d"
        Title="MC Server Manager"
        WindowStyle="None"
        ResizeMode="CanResize"
        Height="720"
        Width="1280"
        MinHeight="560"
        MinWidth="920"
        Background="#161A21">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- 6px WPF edges stay outside WebView2 so WindowChrome can resize.
         Top of the side strips matches CSS caption-bg / app-caption-height
         so the title bar looks flush with the window. -->
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom" Height="6" Background="#161A21"
                WindowChrome.IsHitTestVisibleInChrome="False" />
        <Grid DockPanel.Dock="Left" Width="6"
              WindowChrome.IsHitTestVisibleInChrome="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#10141A" />
            <Border Grid.Row="1" Background="#323A48" />
            <Border Grid.Row="2" Background="#161A21" />
        </Grid>
        <Grid DockPanel.Dock="Right" Width="6"
              WindowChrome.IsHitTestVisibleInChrome="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#10141A" />
            <Border Grid.Row="1" Background="#323A48" />
            <Border Grid.Row="2" Background="#161A21" />
        </Grid>
        <blazor:BlazorWebView x:Name="HostView" HostPage="wwwroot\index.html" Services="{DynamicResource services}">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:App}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </DockPanel>
</Window>
