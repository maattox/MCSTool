<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:McManager.App.ViewModels"
             x:Class="McManager.App.Views.Tabs.TroubleshootingView"
             x:DataType="vm:TroubleshootingViewModel">
    <UserControl.Styles>
        <Style Selector="Border.copyHost Button.copyBtn">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.copyHost:pointerover Button.copyBtn">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.copyBtn">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,6,22,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="ZIndex" Value="1" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Bottom" RowDefinitions="Auto,Auto,*" MinHeight="168">
            <TextBlock Text="Result log"
                       FontWeight="SemiBold"
                       Margin="0,12,0,4" />
            <TextBlock Grid.Row="1"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Margin="0,0,0,6" />
            <Border Grid.Row="2"
                    Classes="copyHost"
                    MinHeight="120"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Grid>
                    <TextBox Text="{Binding ResultLog, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             BorderThickness="0"
                             FontFamily="Consolas,Courier New,monospace"
                             FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <Button Classes="copyBtn"
                            Content="Copy"
                            Command="{Binding CopyResultLogCommand}"
                            ToolTip.Tip="Copy result log"
                            IsEnabled="{Binding !IsBusy}" />
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer>
            <StackPanel Spacing="16" MaxWidth="760">
                <StackPanel Spacing="6">
                    <TextBlock Text="Troubleshooting"
                               FontWeight="SemiBold"
                               FontSize="16" />
                    <TextBlock TextWrapping="Wrap"
                               Opacity="0.85"
                               Text="One-shot repairs for a stuck doorbell. Confirm before anything that moves the reserved IP or changes VM/door state. This is not Danger Zone — idle disable and raw VM SoftStop stay on Advanced." />
                </StackPanel>

                <Border Padding="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        CornerRadius="4">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Doorbell / reserved play IP"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <TextBlock TextWrapping="Wrap"
                                   Opacity="0.85"
                                   FontSize="12"
                                   Text="Preferred park: if VM1 is RUNNING, put the reserved IP on VM1; otherwise start the door if needed and park it there. Covers FN-ISSUE-1 after the $1 Function SoftStops both VMs." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Park reserved play IP"
                                    Command="{Binding ParkPlayIpCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                            <Button Content="Re-apply play netplan"
                                    Command="{Binding ReapplyNetplanCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        CornerRadius="4">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Door state"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <TextBlock TextWrapping="Wrap"
                                   Opacity="0.85"
                                   FontSize="12"
                                   Text="Sticky STARTING/DEGRADED after Minecraft is actually listening (DOOR-ISSUE-5 leftover). Diagnose is read-only. Reset does not move the IP." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Diagnose wait_forge"
                                    Command="{Binding DiagnoseWaitForgeCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                            <Button Content="Reset door state"
                                    Command="{Binding ResetDoorStateCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                            <Button Content="Unstick after game is up"
                                    Command="{Binding UnstickDoorCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        CornerRadius="4">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Budget / ledger"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <TextBlock TextWrapping="Wrap"
                                   Opacity="0.85"
                                   FontSize="12"
                                   Text="Refresh re-pulls Object Storage on the door. Heal runs only when VM1 is STOPPED." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Refresh door OS budget"
                                    Command="{Binding RefreshOsBudgetCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                            <Button Content="Heal open ledger"
                                    Command="{Binding HealLedgerCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        CornerRadius="4">
                    <StackPanel Spacing="10">
                        <TextBlock Text="VM1 game / idle"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <TextBlock TextWrapping="Wrap"
                                   Opacity="0.85"
                                   FontSize="12"
                                   Text="Minecraft Restart is on the top bar — not duplicated here. Repair uses the same 4.2 layout contract. Force-enable idle does not start Minecraft (OS-ISSUE-7: boot already re-enables)." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Idle timer status"
                                    Command="{Binding ShowIdleStatusCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                            <Button Content="Force-enable idle timer"
                                    Command="{Binding ForceEnableIdleCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Minecraft CHDIR diagnosis"
                                    Command="{Binding DiagnoseMinecraftCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                            <Button Content="Repair game permissions"
                                    Command="{Binding RepairPermissionsCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        CornerRadius="4">
                    <StackPanel Spacing="8">
                        <TextBlock Text="If VM1 hangs in STOPPING (OS-ISSUE-5)"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <TextBlock TextWrapping="Wrap"
                                   Opacity="0.85"
                                   FontSize="12"
                                   Text="Guest ACPI SoftStop hang is not a Manager button. In the OCI Console, open the VM1 instance and use Stop → Reset (or Force stop) if it stays STOPPING. Then Park play IP so the reserved address returns to the door. Heal the ledger only after lifecycle is STOPPED." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
