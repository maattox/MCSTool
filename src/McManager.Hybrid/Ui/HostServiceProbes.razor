@using System.IO
@using McManager.Core.Config
@using McManager.Core.Setup
@inject IUiDialogs Dialogs
@inject IClipboard Clipboard
@inject IFilePicker FilePicker
@inject IUiClock Clock
@inject MainViewModel Main
@implements IDisposable

<div class="mcm-host-probes" role="region" aria-label="DEBUG host service probes">
    <button type="button" @onclick="ProveConfirmAsync">Confirm modal</button>
    <button type="button" @onclick="ProveClipboardAsync">Copy clipboard</button>
    <button type="button" @onclick="ProvePickerAsync">Native file picker</button>
    <button type="button" @onclick="AnalyzeMrpackAsync">Analyze .mrpack</button>
    <button type="button" @onclick="InstallMrpackAsync">Install .mrpack (temp dir)</button>
    <button type="button" @onclick="AnalyzeManualZipAsync">Analyze server-pack zip</button>
    <button type="button" @onclick="InstallManualZipAsync">Install server-pack zip (temp dir)</button>
    <button type="button" @onclick="PutSpendBrakeAsync">Put spend-brake fixture</button>
    <span class="mcm-host-probes-status">@_status</span>
    <span class="mcm-host-probes-clock" title="IUiClock">@Clock.UtcNow.ToString("HH:mm:ss") UTC</span>
</div>

@code {
    private string _status = "idle";
    private CancellationTokenSource? _clockCts;

    protected override void OnInitialized()
    {
        _clockCts = new CancellationTokenSource();
        _ = TickClockAsync(_clockCts.Token);
    }

    public void Dispose()
    {
        _clockCts?.Cancel();
        _clockCts?.Dispose();
    }

    private async Task TickClockAsync(CancellationToken cancellationToken)
    {
        using var timer = Clock.CreatePeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task ProveConfirmAsync()
    {
        var ok = await Dialogs.ConfirmAsync(
            "Probe confirm",
            "This DEBUG confirm uses the Razor modal host. Cancel returns false; OK returns true.",
            "OK");
        _status = ok ? "Confirm: OK" : "Confirm: Cancel";
    }

    private async Task ProveClipboardAsync()
    {
        const string payload = "mc-manager-host-probe";
        await Clipboard.SetTextAsync(payload);
        var roundTrip = await Clipboard.GetTextAsync();
        _status = string.Equals(roundTrip, payload, StringComparison.Ordinal)
            ? "Clipboard: copied mc-manager-host-probe"
            : "Clipboard: wrote text (read-back differed)";
    }

    private async Task ProvePickerAsync()
    {
        var path = await FilePicker.OpenFileAsync(new FilePickRequest
        {
            Title = "DEBUG: pick any file (nothing is uploaded)",
            Filters =
            [
                new FileTypeFilter("All files", ".*"),
            ],
        });
        _status = path is null ? "Picker: cancelled" : "Picker: " + path;
    }

    private async Task AnalyzeMrpackAsync()
    {
        var path = await FilePicker.OpenFileAsync(new FilePickRequest
        {
            Title = "DEBUG: pick a local .mrpack (analyze only — nothing is uploaded or installed)",
            Filters =
            [
                new FileTypeFilter("Modrinth pack", ".mrpack"),
                new FileTypeFilter("Zip archives", ".zip"),
                new FileTypeFilter("All files", ".*"),
            ],
        });
        if (path is null)
        {
            _status = "mrpack: cancelled";
            return;
        }

        var result = MrpackAnalyzer.AnalyzeFile(path);
        if (!result.Succeeded)
        {
            _status = "mrpack: " + result.Error;
            await Dialogs.ShowInfoAsync("DEBUG: .mrpack analyze failed", result.Error ?? "Unknown error.");
            return;
        }

        var summary = result.Value!.ConfirmableSummary;
        _status = $"mrpack: {result.Value.PackName} / {result.Value.Loader} {result.Value.LoaderVersion} / MC {result.Value.MinecraftVersion}";
        await Dialogs.ShowInfoAsync("DEBUG: .mrpack summary (not installed)", summary);
    }

    private async Task InstallMrpackAsync()
    {
        var path = await FilePicker.OpenFileAsync(new FilePickRequest
        {
            Title = "DEBUG: pick a local .mrpack (server-side install into a temp folder)",
            Filters =
            [
                new FileTypeFilter("Modrinth pack", ".mrpack"),
                new FileTypeFilter("Zip archives", ".zip"),
                new FileTypeFilter("All files", ".*"),
            ],
        });
        if (path is null)
        {
            _status = "mrpack install: cancelled";
            return;
        }

        var ok = await Dialogs.ConfirmAsync(
            "DEBUG: install .mrpack?",
            "Downloads files already listed in the pack (plain GET — no catalog). "
            + "Client-only files are skipped. Unclear env.server fails the install. "
            + "Files go into a temp folder. A copy of this archive is kept in Manager local data "
            + "for later re-download. Friends still need the same exported pack.\n\n"
            + path,
            "Install");
        if (!ok)
        {
            _status = "mrpack install: cancelled";
            return;
        }

        var dest = Path.Combine(Path.GetTempPath(), "mcmgr-mrpack-install-" + Guid.NewGuid().ToString("N"));
        var dataDir = LocalConfigStore.TryFindDataDirectory();
        var installer = new MrpackInstaller();
        var result = await installer.InstallAsync(path, dest, dataDir);
        if (!result.Succeeded)
        {
            _status = "mrpack install: " + result.Error;
            await Dialogs.ShowInfoAsync("DEBUG: .mrpack install failed", result.Error ?? "Unknown error.");
            return;
        }

        _status = $"mrpack install: {result.Value!.InstalledRelativePaths.Count} files → {dest}";
        await Dialogs.ShowInfoAsync("DEBUG: .mrpack installed (temp dir)", result.Value.Summary);
    }

    private async Task AnalyzeManualZipAsync()
    {
        var path = await FilePicker.OpenFileAsync(new FilePickRequest
        {
            Title = "DEBUG: pick a local server-pack zip (analyze only — nothing is uploaded or installed)",
            Filters =
            [
                new FileTypeFilter("Zip archives", ".zip"),
                new FileTypeFilter("All files", ".*"),
            ],
        });
        if (path is null)
        {
            _status = "manual zip: cancelled";
            return;
        }

        var result = ManualServerPackAnalyzer.AnalyzeFile(path);
        if (!result.Succeeded)
        {
            _status = "manual zip: " + result.Error;
            await Dialogs.ShowInfoAsync("DEBUG: server-pack zip analyze failed", result.Error ?? "Unknown error.");
            return;
        }

        var a = result.Value!;
        _status = a.CanInstall
            ? $"manual zip: {a.Kind} / {a.PackName} / {a.Loader}"
            : "manual zip: refused " + a.Kind;
        await Dialogs.ShowInfoAsync(
            a.CanInstall ? "DEBUG: server-pack zip summary (not installed)" : "DEBUG: server-pack zip refused",
            a.ConfirmableSummary);
    }

    private async Task InstallManualZipAsync()
    {
        var path = await FilePicker.OpenFileAsync(new FilePickRequest
        {
            Title = "DEBUG: pick a local server-pack zip (unzip into a temp folder)",
            Filters =
            [
                new FileTypeFilter("Zip archives", ".zip"),
                new FileTypeFilter("All files", ".*"),
            ],
        });
        if (path is null)
        {
            _status = "manual zip install: cancelled";
            return;
        }

        var ok = await Dialogs.ConfirmAsync(
            "DEBUG: install server-pack zip?",
            "Unzips a generic server pack (mods/ + config/, or a CurseForge Server Files layout). "
            + "Client-only jars are skipped when fabric/quilt/Forge metadata says so. "
            + "Client packs and CurseForge client exports are refused. No catalog download. "
            + "Files go into a temp folder. A copy of this archive is kept in Manager local data "
            + "for later re-download. Friends still need the same exported pack.\n\n"
            + path,
            "Install");
        if (!ok)
        {
            _status = "manual zip install: cancelled";
            return;
        }

        var dest = Path.Combine(Path.GetTempPath(), "mcmgr-manual-zip-install-" + Guid.NewGuid().ToString("N"));
        var dataDir = LocalConfigStore.TryFindDataDirectory();
        var result = ManualServerPackInstaller.Install(path, dest, dataDir);
        if (!result.Succeeded)
        {
            _status = "manual zip install: " + result.Error;
            await Dialogs.ShowInfoAsync("DEBUG: server-pack zip install failed", result.Error ?? "Unknown error.");
            return;
        }

        _status = $"manual zip install: {result.Value!.InstalledRelativePaths.Count} files → {dest}";
        await Dialogs.ShowInfoAsync("DEBUG: server-pack zip installed (temp dir)", result.Value.Summary);
    }

    private async Task PutSpendBrakeAsync()
    {
        await Main.DebugPutSpendBrakeFixtureAsync();
        _status = "Spend-brake: fixture PUT (overlay if Object Storage succeeded)";
    }
}
