<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:McManager.App.ViewModels"
             xmlns:svc="using:McManager.Core.Services"
             x:Class="McManager.App.Views.Tabs.ServerManagementView"
             x:DataType="vm:ServerManagementViewModel">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16" RowSpacing="12">
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="World backups (Object Storage)"
                       FontWeight="SemiBold"
                       FontSize="16" />
            <TextBlock Text="{Binding SoftCapDisplay}" Opacity="0.8" />
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Opacity="0.85" />
            <TextBlock Text="{Binding ProgressDisplay}"
                       Opacity="0.65"
                       FontSize="12" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                CornerRadius="4"
                Padding="8">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,100,140"
                      Margin="0,0,0,8"
                      Opacity="0.7">
                    <TextBlock Grid.Column="0" Text="Object" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Size" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Created (UTC)" FontWeight="SemiBold" />
                </Grid>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Backups}"
                         SelectedItem="{Binding SelectedBackup}"
                         MinHeight="180">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="svc:WorldBackupInfo">
                            <Grid ColumnDefinitions="*,100,140">
                                <TextBlock Grid.Column="0" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" />
                                <TextBlock Grid.Column="2" Text="{Binding TimeDisplay}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding !IsBusy}" />
            <Button Content="Download World Save"
                    Command="{Binding DownloadCommand}"
                    IsEnabled="{Binding !IsBusy}" />
            <Button Content="Upload backup"
                    Command="{Binding UploadCommand}"
                    IsEnabled="{Binding !IsBusy}" />
            <Button Content="Replace world on VM1"
                    Command="{Binding ReplaceWorldCommand}"
                    IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="Replace requires VM1 RUNNING (SSH). Upload while stopped only stores a zip in Object Storage — Start then Replace to apply. Soft-cap eviction stays on-box SoftStop."
                   TextWrapping="Wrap"
                   Opacity="0.65"
                   FontSize="12" />
    </Grid>
</UserControl>
