<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:McManager.App.ViewModels"
        x:Class="McManager.App.Views.SetupWizardWindow"
        x:DataType="vm:SetupWizardViewModel"
        Title="Setup — deploy infrastructure"
        Width="760"
        Height="700"
        MinWidth="680"
        MinHeight="580"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Border.copyHost Button.copyBtn">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.copyHost:pointerover Button.copyBtn">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.copyBtn">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,6,22,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="ZIndex" Value="1" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="16,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding StepTitle}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StepSubtitle}" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="16,10"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           MaxHeight="40"
                           VerticalAlignment="Center"
                           Opacity="0.85"
                           Margin="0,0,12,0"
                           ToolTip.Tip="{Binding StatusMessage}" />
                <WrapPanel Grid.Column="1"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           ItemSpacing="8">
                    <Button Content="Back"
                            Command="{Binding BackCommand}"
                            MinWidth="80" />
                    <Button Content="Next"
                            Command="{Binding NextCommand}"
                            IsVisible="{Binding !IsLastStep}"
                            MinWidth="80"
                            IsDefault="True" />
                    <Button Content="Deploy"
                            Command="{Binding DeployCommand}"
                            IsEnabled="{Binding CanDeploy}"
                            IsVisible="{Binding ShowDeployButton}"
                            ToolTip.Tip="Creates Always Free resources. State is under LocalAppData, not repo terraform.tfvars."
                            MinWidth="80" />
                    <Button Content="Retry options…"
                            Command="{Binding ShowCapacityOptionsCommand}"
                            IsVisible="{Binding ShowCapacityOptionsButton}"
                            MinWidth="120" />
                    <Button Content="Pause auto-retry"
                            Command="{Binding StopCapacityPollCommand}"
                            IsVisible="{Binding IsPollingCapacity}"
                            MinWidth="130" />
                    <Button Content="Close"
                            IsCancel="True"
                            MinWidth="80"
                            Click="OnCloseClick" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Margin="16">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding !IsStepSummary}">
                <Grid>
                    <!-- 1 Always Free -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsStepAlwaysFree}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="This product targets Oracle Cloud Always Free resources (Ampere A1 + Micro door). Confirm you understand the limits before continuing." />
                        <Button Content="Open Always Free compute docs"
                                Command="{Binding OpenAlwaysFreeDocsCommand}"
                                HorizontalAlignment="Left" />
                        <CheckBox IsChecked="{Binding AlwaysFreeConfirmed}"
                                  Content="I will stay on Always Free–eligible compute and accept that A1 capacity may be unavailable." />
                        <TextBlock TextWrapping="Wrap" Opacity="0.9"
                                   Text="A $1 monthly budget is a last-resort brake (Function SoftStops the VMs). Oracle may still bill a small residual (~$1–$2) after the brake fires. This is not a hard $0 guarantee." />
                        <CheckBox IsChecked="{Binding ResidualChargeDisclosed}"
                                  Content="I understand the $1 brake and possible ~$1–$2 residual charge." />
                        <TextBlock TextWrapping="Wrap" Opacity="0.9"
                                   Text="If A1 Flex is out of capacity, a window will explain the options: try again now, auto-retry every 5 minutes, or resume later. It will not tight-loop the OCI API." />
                        <CheckBox IsChecked="{Binding CapacityWaitConsent}"
                                  Content="I understand capacity wait: try again now, auto-retry every 5 minutes, or resume later." />
                    </StackPanel>

                    <!-- 2 OCI -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsStepOci}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Choose the ~/.oci/config profile. Region and other key fields are read from that file (no live OCI calls) so you can confirm this is the right tenancy. Prefer the tenancy home region so Always Free A1 / Micro eligibility applies." />
                        <TextBlock Text="OCI profile" />
                        <ComboBox ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile}"
                                  MinWidth="280"
                                  HorizontalAlignment="Left" />
                        <TextBlock Text="Profile details (from ~/.oci/config)" Opacity="0.85" />
                        <TextBox Text="{Binding ProfileDetailsText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas,Courier New,monospace"
                                 FontSize="12"
                                 MinHeight="96" />
                    </StackPanel>

                    <!-- 3 Compartment -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsStepCompartment}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Greenfield deploy creates a dedicated compartment (OpenTofu variable existing_compartment_id is empty). Repair / disposable tests can target an existing empty compartment OCID." />
                        <RadioButton GroupName="Compartment"
                                     Content="Create compartment named mcmgr (default)"
                                     IsChecked="{Binding CreateCompartment}" />
                        <TextBox Text="{Binding CompartmentName}"
                                 IsEnabled="{Binding CreateCompartment}"
                                 PlaceholderText="mcmgr" />
                        <RadioButton GroupName="Compartment"
                                     Content="Use an existing empty compartment OCID"
                                     IsChecked="{Binding UseExistingCompartment}" />
                        <TextBox Text="{Binding ExistingCompartmentId}"
                                 IsEnabled="{Binding UseExistingCompartment}"
                                 PlaceholderText="ocid1.compartment.oc1.." />
                    </StackPanel>

                    <!-- 4 Alert email -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsStepAlertEmail}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Budget alert recipients (comma-separated if more than one). Used by the $1 compartment budget." />
                        <TextBox Text="{Binding AlertEmail}" PlaceholderText="you@example.com" />
                    </StackPanel>

                    <!-- 5 SSH -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsStepSsh}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Generate a new ed25519 key under %USERPROFILE%\.ssh\ with a timestamped name (mcmgr_ed25519_yyyyMMdd_HHmmss). Each Generate creates a new pair and does not reuse or overwrite an existing key. Or import a .pub. The private key stays on disk and is not saved in wizard JSON." />
                        <RadioButton GroupName="Ssh"
                                     Content="Generate a new key"
                                     IsChecked="{Binding SshGenerateMode}" />
                        <RadioButton GroupName="Ssh"
                                     Content="Import an existing .pub"
                                     IsChecked="{Binding SshImportMode}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Generate key"
                                    Command="{Binding GenerateSshKeyCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                            <Button Content="Import .pub…"
                                    Command="{Binding ImportSshKeyCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>
                        <TextBlock Text="Public key" Opacity="0.8" />
                        <Border Height="80"
                                HorizontalAlignment="Stretch"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                CornerRadius="3"
                                ClipToBounds="True">
                            <TextBox Text="{Binding SshPublicKey}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     BorderThickness="0"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Border>
                        <TextBlock Text="{Binding SshPublicKeyPath}" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SshFingerprint}" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 6 Game -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsStepGame}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="MVP Setup is Vanilla only (no Paper / Forge / modpacks). The list is display-only from Mojang piston-meta; bootstrap in 3.3 re-resolves the jar on the VM. Only the version id is saved." />
                        <CheckBox IsChecked="{Binding VanillaConfirmed}"
                                  Content="I want a Vanilla Minecraft server (not Paper or modded)." />
                        <CheckBox IsChecked="{Binding IncludeSnapshots}"
                                  Content="Advanced: include snapshots" />
                        <TextBlock Text="Minecraft version" />
                        <ComboBox ItemsSource="{Binding VersionIds}"
                                  SelectedItem="{Binding MinecraftVersion}"
                                  MinWidth="200"
                                  HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding VersionCatalogNotes}"
                                   TextWrapping="Wrap"
                                   Opacity="0.75"
                                   FontSize="12" />
                    </StackPanel>

                    <!-- 7 EULA -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsStepEula}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="You must accept Mojang's Minecraft EULA. Bootstrap (Step 3.3) writes eula.txt only if this is checked. This product will not auto-accept it for you." />
                        <Button Content="Open Minecraft EULA"
                                Command="{Binding OpenEulaCommand}"
                                HorizontalAlignment="Left" />
                        <CheckBox IsChecked="{Binding EulaAccepted}"
                                  Content="I accept the Minecraft EULA." />
                    </StackPanel>

                    <!-- 8 Auth Token -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsStepAuthToken}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Optional. Needed to push the spend-brake Function image to OCIR after the first apply. Stored in Windows Credential Manager (target McManager/ocir), not in wizard JSON. Setup still succeeds if this is skipped." />
                        <TextBox Text="{Binding AuthTokenInput}"
                                 PasswordChar="•"
                                 PlaceholderText="Auth Token (optional)" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Store token"
                                    Command="{Binding StoreAuthTokenCommand}" />
                            <Button Content="Clear stored token"
                                    Command="{Binding ClearAuthTokenCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding AuthTokenStoredDisplay}"
                                   Opacity="0.8" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 9 Summary: finite grid so log/plan stay above the footer and keep their scrollbars -->
            <Grid IsVisible="{Binding IsStepSummary}"
                  RowDefinitions="Auto,Auto,Auto,Auto,*,*"
                  RowSpacing="8">
                <TextBlock Grid.Row="0"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Text="Review the plan, confirm your public IP, check the boxes below, then Deploy. If A1 is out of capacity, a window will explain retry options." />
                <StackPanel Grid.Row="1" Spacing="8">
                    <TextBlock Text="Admin public IP (Security List /32)" />
                    <TextBox Text="{Binding AdminCidr}" PlaceholderText="203.0.113.10/32" />
                    <TextBlock Text="Your Minecraft username (Vanilla whitelist — required to join)" />
                    <TextBox Text="{Binding AdminMinecraftUsername}" PlaceholderText="Steve" />
                    <CheckBox IsChecked="{Binding CreateResourcesConfirmed}">
                        <TextBlock Text="{Binding CreateResourcesConfirmText}" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox IsVisible="{Binding ShowReplaceConfigConfirm}"
                              IsChecked="{Binding ReplaceConfigConfirmed}">
                        <TextBlock Text="Replace config.local.json in this data folder after a successful deploy."
                                   TextWrapping="Wrap" />
                    </CheckBox>
                </StackPanel>
                <Border Grid.Row="2"
                        IsVisible="{Binding IsPollingCapacity}"
                        Padding="10,8"
                        CornerRadius="3"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                    <TextBlock TextWrapping="Wrap"
                              Text="{Binding AutoRetryBannerText}" />
                </Border>

                <Grid Grid.Row="4" RowDefinitions="Auto,*">
                    <TextBlock Text="Plan summary" Opacity="0.85" Margin="0,0,0,4" />
                    <Border Grid.Row="1"
                            Classes="copyHost"
                            MinHeight="80"
                            HorizontalAlignment="Stretch"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                            CornerRadius="3"
                            ClipToBounds="True">
                        <Grid>
                            <TextBox Text="{Binding PlanSummaryText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     BorderThickness="0"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="12"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <Button Classes="copyBtn"
                                    Content="Copy"
                                    Command="{Binding CopyPlanSummaryCommand}"
                                    ToolTip.Tip="Copy plan summary" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="5" RowDefinitions="Auto,*">
                    <TextBlock Text="Deploy log" Opacity="0.85" Margin="0,0,0,4" />
                    <Border Grid.Row="1"
                            Classes="copyHost"
                            MinHeight="80"
                            HorizontalAlignment="Stretch"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                            CornerRadius="3"
                            ClipToBounds="True">
                        <Grid>
                            <TextBox Text="{Binding DeployLog, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     BorderThickness="0"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <Button Classes="copyBtn"
                                    Content="Copy"
                                    Command="{Binding CopyDeployLogCommand}"
                                    ToolTip.Tip="Copy deploy log" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
