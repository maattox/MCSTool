<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:McManager.App.ViewModels"
             x:Class="McManager.App.Views.Tabs.AdvancedView"
             x:DataType="vm:AdvancedViewModel">
    <StackPanel Margin="24" Spacing="12" MaxWidth="640">
        <TextBlock Text="Break-glass VM power"
                   FontWeight="SemiBold"
                   FontSize="16" />
        <TextBlock Text="These call OCI Compute directly and do NOT move the reserved play IP. Prefer the top-bar Start/Stop (door wake / idle-empty). Full idle / Danger Zone controls arrive in Step 1.7."
                   TextWrapping="Wrap"
                   Opacity="0.8" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Raw VM Start"
                    Command="{Binding BreakGlassStartCommand}"
                    IsEnabled="{Binding !IsBusy}" />
            <Button Content="Raw VM SoftStop"
                    Command="{Binding BreakGlassSoftStopCommand}"
                    IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Opacity="0.85" />
    </StackPanel>
</UserControl>
