<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="McManager.App.Views.FirstRunWindow"
        Title="OCI MC Server Manager"
        Width="580"
        Height="460"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="24" Spacing="14">
        <TextBlock Text="No local manage config"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap"
                   Opacity="0.9"
                   Text="data/config.local.json was not found. Deploy a new Always Free stack with Setup, auto-detect an existing stack from Object Storage meta, or open the Manager if you already seeded config by hand. Auto-detect never runs on launch — only when you click the button." />
        <Button x:Name="SetupButton"
                Content="Deploy a new stack (Setup)"
                HorizontalAlignment="Left"
                MinWidth="280"
                Click="OnSetupClick" />
        <Button x:Name="DetectButton"
                Content="Auto-detect infrastructure"
                HorizontalAlignment="Left"
                MinWidth="280"
                Click="OnDetectClick" />
        <Button x:Name="ExistingButton"
                Content="I already have a stack"
                HorizontalAlignment="Left"
                MinWidth="280"
                Click="OnExistingClick" />
        <TextBlock TextWrapping="Wrap"
                   Opacity="0.7"
                   FontSize="12"
                   Text="'I already have a stack' opens the manage UI without scanning OCI (for a hand-seeded config.local.json). Auto-detect reads ~/.oci profiles, finds a tagged or mcmgr compartment, and hydrates config from meta/infra.json after you confirm." />
        <TextBlock x:Name="StatusText"
                   TextWrapping="Wrap"
                   Opacity="0.85" />
    </StackPanel>
</Window>
