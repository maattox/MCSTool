# MCSTool override: do not order firewalld before network-pre.target.
# Distro /lib/systemd/system/firewalld.service has Before= + Wants= network-pre
# and After=dbus.service. That races cloud-init (Debian #1025618): systemd may
# delete dbus.socket/dbus.service to break the cycle. Guest then has no dbus;
# ACPI SoftStop hangs ~15–17 min (OS-ISSUE-9). systemd drop-ins cannot reset
# Before=/Wants= — this file replaces the unit. Security List is the IP allowlist.
[Unit]
Description=firewalld - dynamic firewall daemon
After=dbus.service
After=polkit.service
Conflicts=iptables.service ip6tables.service ebtables.service ipset.service nftables.service
Documentation=man:firewalld(1)

[Service]
ExecStart=/usr/sbin/firewalld --nofork --nopid
ExecReload=/bin/kill -HUP $MAINPID
StandardOutput=null
StandardError=null
Type=dbus
BusName=org.fedoraproject.FirewallD1
KillMode=mixed

[Install]
WantedBy=multi-user.target
