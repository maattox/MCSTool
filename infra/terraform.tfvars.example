# Copy to terraform.tfvars (gitignored) and fill in. Never commit real OCIDs.
# Then: tofu init && tofu validate && tofu plan
# Do NOT tofu apply on the live lab tenancy during Step 3.1.

tenancy_ocid = "ocid1.tenancy.oc1..REPLACE_ME" # must replace — tofu does not read ~/.oci tenancy= automatically
region       = "us-sanjose-1"
oci_profile  = "DEFAULT"

# Contents of ~/.ssh/id_ed25519.pub (or the key Setup will use for the game VM)
ssh_public_key = "ssh-ed25519 AAAA... comment"
# Optional: different public key for the door. Empty = same as ssh_public_key.
# door_ssh_public_key = ""

admin_cidr = "203.0.113.10/32"
admin_name = "admin"

alert_email = "you@example.com"

# Leave empty to create compartment display-name "mcmgr".
# Set to an empty disposable compartment OCID to skip create (plan experiments).
existing_compartment_id = ""

# Defaults (uncomment to override):
# compartment_name = "mcmgr"
# vcn_cidr         = "10.0.0.0/16"
# subnet_cidr      = "10.0.0.0/24"
# vm1_ocpus        = 4   # Setup picker: 4/24 (default) or 2/12
# vm1_memory_gb    = 24
# bucket_name      = "mcmgr-shared-data"
# function_image   = ""   # Step 3.3: region.ocir.io/<ns>/mcmgr-fn/softstop:<tag>
# softstop_instance_ids = []  # empty = VM1 only (do not add the door Micro)
