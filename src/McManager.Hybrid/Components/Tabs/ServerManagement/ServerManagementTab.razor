@inject ServerManagementViewModel Vm
@implements IDisposable

<div>
    <nav class="mcm-subtabs" role="tablist" aria-label="Server sections">
        <button type="button"
                role="tab"
                class="mcm-subtab @PaneClass("identity")"
                aria-selected="@(IsPane("identity") ? "true" : "false")"
                aria-controls="mcm-server-pane-identity"
                id="mcm-server-tab-identity"
                @onclick="@(() => SelectPane("identity"))">
            Identity
        </button>
        <button type="button"
                role="tab"
                class="mcm-subtab @PaneClass("settings")"
                aria-selected="@(IsPane("settings") ? "true" : "false")"
                aria-controls="mcm-server-pane-settings"
                id="mcm-server-tab-settings"
                @onclick="@(() => SelectPane(ServerManagementViewModel.PaneSettings))">
            Settings
        </button>
        <button type="button"
                role="tab"
                class="mcm-subtab @PaneClass("world")"
                aria-selected="@(IsPane("world") ? "true" : "false")"
                aria-controls="mcm-server-pane-world"
                id="mcm-server-tab-world"
                @onclick="@(() => SelectPane("world"))">
            World
        </button>
        <button type="button"
                role="tab"
                class="mcm-subtab @PaneClass("modding")"
                aria-selected="@(IsPane("modding") ? "true" : "false")"
                aria-controls="mcm-server-pane-modding"
                id="mcm-server-tab-modding"
                @onclick="@(() => SelectPane("modding"))">
            Mods
        </button>
        @if (Vm.ShowPluginsTab)
        {
            <button type="button"
                    role="tab"
                    class="mcm-subtab @PaneClass("plugins")"
                    aria-selected="@(IsPane("plugins") ? "true" : "false")"
                    aria-controls="mcm-server-pane-plugins"
                    id="mcm-server-tab-plugins"
                    @onclick="@(() => SelectPane("plugins"))">
                Plugins
            </button>
        }
    </nav>

    @if (IsPane("identity"))
    {
        <div class="mcm-section-card"
             id="mcm-server-pane-identity"
             role="tabpanel"
             aria-labelledby="mcm-server-tab-identity">
            <div class="mcm-server-pane-head">
                <div class="mcm-server-pane-title">
                    <span>Name, icon, and messages</span>
                    <button type="button"
                            class="mcm-help"
                            title="@Vm.IdentityHelpTitle">
                        <i class="ti ti-help" aria-hidden="true"></i>
                        <span class="sr-only">About name, icon, and messages</span>
                    </button>
                </div>
                <button type="button"
                        class="mcm-primary"
                        disabled="@(!Vm.CanSaveIdentity)"
                        title="Writes the shared copy. Restart Minecraft (or Start) to apply name, icon, and chat lines."
                        @onclick="Vm.SaveIdentityAsync">
                    Save
                </button>
            </div>
            <p class="mcm-server-facts">
                        Minecraft @Vm.MinecraftVersionDisplay. Server name, description, and icon are shown in the in-game server listing. To style name and description, highlight a text segment and use the toolbar to apply an effect. Offline / Starting / Unavailable icons are shown while the server is off.
            </p>
            <div class="mcm-identity-grid">
                <div>
                    <MotdEditor IdPrefix="mcm-server"
                                Disabled="@Vm.AnyBusy"
                                @bind-ServerName="Vm.IdentityName"
                                @bind-Description="Vm.IdentityDescription" />
                </div>
                <div>
                    <ServerIconPreviewStrip ColorUrl="@Vm.IconPreviewDataUrl"
                                            IdleUrl="@Vm.IdleIconPreviewDataUrl"
                                            StartingUrl="@Vm.StartingIconPreviewDataUrl"
                                            ExhaustedUrl="@Vm.ExhaustedIconPreviewDataUrl" />
                    <div class="mcm-server-actions" style="align-items:center;">
                        <button type="button"
                                disabled="@Vm.AnyBusy"
                                title="Any PNG. Manager fits it to 64×64."
                                @onclick="Vm.PickIconAsync">
                            Choose icon
                        </button>
                        <button type="button"
                                disabled="@(!Vm.CanClearIcon)"
                                @onclick="Vm.ClearIcon">
                            Use default
                        </button>
                        <button type="button"
                                class="mcm-help"
                                title="@Vm.IconStatesHelp">
                            <i class="ti ti-help" aria-hidden="true"></i>
                            <span class="sr-only">About doorbell list icons</span>
                        </button>
                    </div>
                    <p style="margin:6px 0 0;font-size:12px;color:var(--text-muted);">PNG — fitted to 64×64</p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Vm.IdentityStatus))
            {
                <p style="margin:0 0 8px;font-size:13px;color:var(--text-secondary);white-space:pre-wrap;">@Vm.IdentityStatus</p>
            }
            <button type="button"
                    class="mcm-advanced-toggle"
                    @onclick="() => Vm.ShowChatTemplates = !Vm.ShowChatTemplates">
                @(Vm.ShowChatTemplates ? "Hide automated chat" : "Automated chat")
            </button>
            @if (Vm.ShowChatTemplates)
            {
                <p style="margin:0 0 10px;font-size:12px;color:var(--text-muted);">
                    These lines are sent in-game before an idle or budget stop. Keep the placeholders such as <code>{minutes}</code> if the line uses them.
                </p>
                <div class="mcm-chat-templates">
                    @foreach (var row in Vm.ChatTemplates)
                    {
                        <div class="mcm-field">
                            <label>
                                @row.Label
                                @if (!string.IsNullOrWhiteSpace(row.Placeholders))
                                {
                                    <span style="font-weight:400;color:var(--text-muted);"> @row.Placeholders</span>
                                }
                            </label>
                            <textarea rows="2"
                                      disabled="@Vm.AnyBusy"
                                      @bind="row.Text"
                                      @bind:event="oninput"></textarea>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (IsPane("settings"))
    {
        <div class="mcm-pane-stack"
             id="mcm-server-pane-settings"
             role="tabpanel"
             aria-labelledby="mcm-server-tab-settings">
        <div class="mcm-section-card">
            <div class="mcm-server-pane-head">
                <div class="mcm-server-pane-title">
                    <span>Gameplay settings</span>
                    <button type="button"
                            class="mcm-help"
                            title="@Vm.SettingsHelpTitle">
                        <i class="ti ti-help" aria-hidden="true"></i>
                        <span class="sr-only">About gameplay settings</span>
                    </button>
                </div>
                <button type="button"
                        class="mcm-primary"
                        disabled="@(!Vm.CanSaveSettings)"
                        title="Writes the shared copy. Restart Minecraft (or Start) to apply."
                        @onclick="Vm.SaveSettingsAsync">
                    Save
                </button>
            </div>
            <p class="mcm-server-facts">
                Minecraft @Vm.MinecraftVersionDisplay. These values are stored in the cloud and applied the next time Minecraft starts. Name, icon, and MOTD stay on Identity.
            </p>
            <div class="mcm-settings-grid">
                <div>
                    <div class="mcm-field">
                        <label for="mcm-settings-difficulty">Difficulty</label>
                        <select id="mcm-settings-difficulty"
                                disabled="@Vm.AnyBusy"
                                @bind="Vm.SettingsDifficulty">
                            @foreach (var name in Vm.SettingsDifficulties)
                            {
                                <option value="@name">@name</option>
                            }
                        </select>
                    </div>
                    <div class="mcm-field">
                        <label for="mcm-settings-gamemode">Default game mode</label>
                        <select id="mcm-settings-gamemode"
                                disabled="@Vm.AnyBusy"
                                @bind="Vm.SettingsGamemode">
                            @foreach (var name in Vm.SettingsGamemodes)
                            {
                                <option value="@name">@name</option>
                            }
                        </select>
                    </div>
                    <div class="mcm-field">
                        <label for="mcm-settings-max-players">Max players</label>
                        <input id="mcm-settings-max-players"
                               class="mcm-num-input"
                               type="number"
                               min="1"
                               max="200"
                               disabled="@Vm.AnyBusy"
                               @bind="Vm.SettingsMaxPlayers"
                               @bind:event="oninput" />
                    </div>
                    <div class="mcm-field">
                        <label for="mcm-settings-spawn">Spawn protection</label>
                        <input id="mcm-settings-spawn"
                               class="mcm-num-input"
                               type="number"
                               min="0"
                               max="256"
                               disabled="@Vm.AnyBusy"
                               @bind="Vm.SettingsSpawnProtection"
                               @bind:event="oninput" />
                        <p class="mcm-wizard-hint">0 turns spawn protection off. Ops can always build at spawn.</p>
                    </div>
                </div>
                <div>
                    <div class="mcm-field">
                        <label for="mcm-settings-view">View distance</label>
                        <input id="mcm-settings-view"
                               class="mcm-num-input"
                               type="number"
                               min="3"
                               max="32"
                               disabled="@Vm.AnyBusy"
                               @bind="Vm.SettingsViewDistance"
                               @bind:event="oninput" />
                    </div>
                    @if (Vm.ShowSettingsSimulationDistance)
                    {
                        <div class="mcm-field">
                            <label for="mcm-settings-sim">Simulation distance</label>
                            <input id="mcm-settings-sim"
                                   class="mcm-num-input"
                                   type="number"
                                   min="3"
                                   max="32"
                                   disabled="@Vm.AnyBusy"
                                   @bind="Vm.SettingsSimulationDistance"
                                   @bind:event="oninput" />
                            <p class="mcm-wizard-hint">Cannot be higher than view distance. Lower values use less CPU.</p>
                        </div>
                    }
                    @if (Vm.ShowSettingsPvp)
                    {
                        <label class="mcm-checkbox-row">
                            <input type="checkbox"
                                   disabled="@Vm.AnyBusy"
                                   @bind="Vm.SettingsPvp" />
                            <span>Player vs player (PvP)</span>
                        </label>
                    }
                    <label class="mcm-checkbox-row">
                        <input type="checkbox"
                               disabled="@Vm.AnyBusy"
                               @bind="Vm.SettingsForceGamemode" />
                        <span>Force default game mode on join</span>
                    </label>
                    <label class="mcm-checkbox-row">
                        <input type="checkbox"
                               disabled="@Vm.AnyBusy"
                               @bind="Vm.SettingsAllowFlight" />
                        <span>Allow flight in Survival</span>
                    </label>
                    <label class="mcm-checkbox-row">
                        <input type="checkbox"
                               disabled="@Vm.AnyBusy"
                               @bind="Vm.SettingsHardcore" />
                        <span>Hardcore</span>
                    </label>
                    <p class="mcm-wizard-hint">Hardcore uses this world’s hardcore flag. Players who die become spectators. This does not wipe the world.</p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Vm.SettingsStatus))
            {
                <p style="margin:8px 0 0;font-size:13px;color:var(--text-secondary);white-space:pre-wrap;">@Vm.SettingsStatus</p>
            }
        </div>
        <div class="mcm-section-card">
            <div class="mcm-server-pane-head">
                <div class="mcm-server-pane-title">
                    <span>@ChangeServerTypeUx.SectionTitle</span>
                    <button type="button"
                            class="mcm-help"
                            title="@ChangeServerTypeUx.SectionHelp">
                        <i class="ti ti-help" aria-hidden="true"></i>
                        <span class="sr-only">About changing server type</span>
                    </button>
                </div>
                <button type="button"
                        disabled="@Vm.AnyBusy"
                        title="Opens a dialog to reinstall Vanilla, Paper, or a mod pack on this existing VM."
                        @onclick="OpenChangeTypeAsync">
                    @ChangeServerTypeUx.OpenButton
                </button>
            </div>
            <p class="mcm-server-facts">
                Now @Vm.ServerKindDisplay · Minecraft @Vm.MinecraftVersionDisplay. Reinstalls Minecraft on this VM. The cloud stack, doorbell, and play IP stay. This is not a Redeploy.
            </p>
        </div>
    </div>
    }
    else if (IsPane("world"))
    {
        <div class="mcm-section-card"
             id="mcm-server-pane-world"
             role="tabpanel"
             aria-labelledby="mcm-server-tab-world">
            <div class="mcm-server-pane-head">
                <div class="mcm-server-pane-title">
                    <span>World backups</span>
                    <button type="button"
                            class="mcm-help"
                            title="@Vm.WorldBackupsHelpTitle">
                        <i class="ti ti-help" aria-hidden="true"></i>
                        <span class="sr-only">About World backups</span>
                    </button>
                </div>
                <div class="mcm-server-actions">
                    <button type="button"
                            disabled="@Vm.AnyBusy"
                            title="Store a zip in cloud storage. This does not replace the live world until you use Replace."
                            @onclick="Vm.UploadAsync">
                        <i class="ti ti-upload" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                        Upload backup
                    </button>
                    <button type="button"
                            disabled="@Vm.AnyBusy"
                            title="@Vm.DownloadLatestTitle"
                            @onclick="Vm.DownloadLatestAsync">
                        <i class="ti ti-download" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                        @Vm.DownloadLatestButtonLabel
                    </button>
                    <button type="button"
                            class="mcm-danger-btn"
                            disabled="@Vm.AnyBusy"
                            title="Stops Minecraft, deletes the live world on the game VM, then starts it again. Cloud backups, mods, and server.properties stay. Requires the server running. Download a world save first if you might want this world back."
                            @onclick="Vm.WipeWorldAsync">
                        Wipe world
                    </button>
                    <button type="button"
                            disabled="@Vm.AnyBusy"
                            title="Requires the server to be running. Stops Minecraft, replaces the world, then starts it again."
                            @onclick="Vm.ReplaceWorldAsync">
                        Replace world
                    </button>
                </div>
            </div>
            <div class="mcm-field mcm-field-short">
                <label for="mcm-world-wipe-seed">World seed (Wipe world)</label>
                <input id="mcm-world-wipe-seed"
                       type="text"
                       maxlength="256"
                       spellcheck="false"
                       autocomplete="off"
                       placeholder="Leave blank for a random world"
                       disabled="@Vm.AnyBusy"
                       @bind="Vm.WipeWorldSeed"
                       @bind:event="oninput" />
                <p class="mcm-wizard-hint">Leave blank for a random seed. Used only when you Wipe world — not Replace.</p>
            </div>
            <p class="mcm-server-facts">
                Last backup @Vm.LastBackupDisplay · Backup storage @Vm.BackupStorageDisplay
                · <span title="@Vm.LiveWorldSizeHelpTitle">Live world @Vm.LiveWorldSizeDisplay</span>
                <button type="button"
                        class="mcm-help mcm-world-size-refresh"
                        disabled="@(!Vm.CanRefreshLiveWorldSize)"
                        title="@Vm.RefreshLiveWorldSizeTitle"
                        @onclick="Vm.RefreshLiveWorldSizeAsync">
                    <i class="ti ti-refresh" aria-hidden="true"></i>
                    <span class="sr-only">Refresh live world size</span>
                </button>
            </p>

            @if (!string.IsNullOrWhiteSpace(Vm.OversizedBanner))
            {
                <div class="mcm-oversized-banner" role="status">
                    <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                    <p>@Vm.OversizedBanner</p>
                </div>
            }

            <div class="mcm-bk-list mcm-slim-scroll">
                @foreach (var backup in Vm.Backups)
                {
                    <div class="mcm-bk-row">
                        <div>
                            <div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@backup.FileName</div>
                            <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">@backup.TimeDisplayLocal</div>
                        </div>
                        <div style="color:var(--text-muted);">@backup.SizeDisplay</div>
                        <div class="mcm-bk-actions">
                            <button type="button"
                                    style="font-size:12px;padding:3px 8px;"
                                    disabled="@Vm.AnyBusy"
                                    @onclick="@(() => Vm.DownloadBackupAsync(backup))">
                                Download
                            </button>
                        </div>
                    </div>
                }
            </div>

            @if (Vm.HasObjectStorage && !string.IsNullOrWhiteSpace(Vm.SoftCapDisplay) && Vm.SoftCapDisplay != "—")
            {
                <p style="margin:10px 0 0;font-size:12px;color:var(--text-muted);">@Vm.SoftCapDisplay</p>
            }
            <p style="margin:12px 0 0;font-size:12px;color:var(--text-muted);">
                Replace and Wipe world need the server running. Wipe deletes only the live save — cloud backups stay. Download a world save first if you might want this world back. Upload while stopped only stores a zip — Start, then Replace to apply it. If a world is too large for cloud backup, Download latest copies the live world over SSH instead.
            </p>
        </div>
    }
    else if (IsPane("modding"))
    {
        <div class="mcm-section-card mcm-change-pack"
             id="mcm-server-pane-modding"
             role="tabpanel"
             aria-labelledby="mcm-server-tab-modding">
            <div class="mcm-server-pane-head">
                <div class="mcm-server-pane-title">
                    <span>Mods</span>
                    <button type="button"
                            class="mcm-help"
                            title="@Vm.ModdingHelpTitle">
                        <i class="ti ti-help" aria-hidden="true"></i>
                        <span class="sr-only">About Mods</span>
                    </button>
                </div>
                @if (Vm.IsModdedServer)
                {
                    <div class="mcm-server-actions">
                        <button type="button"
                                disabled="@(!Vm.CanDownloadPack)"
                                title="@Vm.DownloadPackTitle"
                                @onclick="Vm.DownloadPackAsync">
                            <i class="ti ti-download" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                            Download pack
                        </button>
                    </div>
                }
            </div>
            <div class="mcm-change-pack-ingest">
                <div class="mcm-pack-drop @(Vm.IsAnalyzingPack ? "is-busy" : "")"
                     aria-label="@PackReplaceUx.DropTitle">
                    <InputFile class="mcm-pack-drop-input"
                               OnChange="OnPackInputAsync"
                               accept=".mrpack,.zip"
                               disabled="@(!Vm.CanPickPack || Vm.IsAnalyzingPack)" />
                    <i class="ti ti-file-zip" aria-hidden="true"></i>
                    <p class="mcm-pack-drop-title">@PackReplaceUx.DropTitle</p>
                    <p class="mcm-change-pack-drop-sub">@PackReplaceUx.DropFormats</p>
                    <p class="mcm-change-pack-drop-sub">@PackReplaceUx.DropLargeHint</p>
                </div>
                <div class="mcm-change-pack-ingest-actions">
                    <button type="button"
                            disabled="@(!Vm.CanPickPack || Vm.IsAnalyzingPack)"
                            title="@Vm.ChangePackTitle"
                            @onclick="Vm.PickPackAsync">
                        Choose pack file…
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Vm.PackFileNameDisplay))
                    {
                        <p class="mcm-wizard-hint mcm-wizard-mono mcm-change-pack-file">@Vm.PackFileNameDisplay</p>
                    }
                </div>
            </div>
            @if (Vm.ShowPackSummary)
            {
                @if (!string.IsNullOrWhiteSpace(Vm.PackBlockReason))
                {
                    <p class="mcm-wizard-error">@Vm.PackBlockReason</p>
                }
                @if (Vm.ShowSkipListWarning || Vm.ShowSaveCompatibilityWarning)
                {
                    <div class="mcm-change-pack-warnings">
                        @if (Vm.ShowSkipListWarning)
                        {
                            <aside class="mcm-pack-list-warning" role="status">
                                <p>@Vm.SkipWarningBody</p>
                            </aside>
                        }
                        @if (Vm.ShowSaveCompatibilityWarning)
                        {
                            <aside class="mcm-pack-list-warning" role="status">
                                <p>@Vm.SaveCompatibilityWarning</p>
                            </aside>
                        }
                    </div>
                }
            }
            @if (Vm.ShowPackIdentityFields)
            {
                <PackIdentityFields IdPrefix="change-pack"
                                    Disabled="@Vm.AnyBusy"
                                    @bind-MinecraftVersion="Vm.PackMinecraftVersion"
                                    @bind-Loader="Vm.PackLoader"
                                    @bind-LoaderVersion="Vm.PackLoaderVersion"
                                    @bind-JavaMajorText="Vm.PackJavaMajorText"
                                    ShowDetectionMismatch="@Vm.ShowDetectionMismatch"
                                    DetectionMismatchWarning="@Vm.DetectionMismatchWarning" />
            }
            @if (Vm.ShowPackAssistedReview)
            {
                <PackAssistedReviewPanel IdPrefix="change-pack"
                                         Disabled="@Vm.AnyBusy"
                                         Review="@Vm.AssistedReview"
                                         JarOrder="@Vm.PackJarOrder"
                                         FreezeBlockReason="@Vm.PackFreezeBlockReason"
                                         LooksLikeLauncherInstance="@Vm.PackLooksLikeLauncherInstance"
                                         IsSkipped="@Vm.IsOperatorSkipped"
                                         SkipChanged="Vm.OnAssistedSkipChanged" />
            }
            @if (ShowPackSummaryPre || Vm.ShowPackConfirmChecks)
            {
                <div class="mcm-change-pack-confirm @(ShowPackSummaryPre ? "" : "is-checks-only")">
                    @if (ShowPackSummaryPre)
                    {
                        <pre class="mcm-wizard-log mcm-wizard-mono mcm-slim-scroll mcm-pack-summary">@Vm.PackSummary</pre>
                    }
                    @if (Vm.ShowPackConfirmChecks)
                    {
                        <div class="mcm-change-pack-checks">
                            <label class="mcm-checkbox-row">
                                <input type="checkbox"
                                       disabled="@Vm.AnyBusy"
                                       @bind="Vm.PackConfirmed" />
                                <span>@Vm.PackConfirmLabel</span>
                            </label>
                            <label class="mcm-checkbox-row">
                                <input type="checkbox"
                                       disabled="@Vm.AnyBusy"
                                       @bind="Vm.WipeWorld" />
                                <span>@Vm.WipeWorldLabel</span>
                            </label>
                        </div>
                    }
                </div>
            }
            @if (Vm.IsModdedServer)
            {
                <div class="mcm-mods-installed">
                    @if (!string.IsNullOrWhiteSpace(Vm.PackIdentityDisplay))
                    {
                        <p style="margin:0 0 8px;font-size:13px;">@Vm.PackIdentityDisplay</p>
                    }
                    @if (!Vm.HasLocalPackArchive)
                    {
                        <p style="margin:0 0 8px;font-size:13px;color:var(--text-muted);">@Vm.MissingArchiveMessage</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Vm.ModdingHint))
                    {
                        <p style="margin:0 0 8px;font-size:13px;color:var(--text-muted);">@Vm.ModdingHint</p>
                    }
                    @if (Vm.HasQuarantinedMods)
                    {
                        <div class="mcm-pack-list-warning" role="status">
                            <p class="mcm-wizard-kicker">Set aside after a crash</p>
                            @foreach (var entry in Vm.QuarantinedMods)
                            {
                                <p>@Vm.FormatQuarantineCopy(entry)</p>
                                <div class="mcm-quarantine-actions">
                                    <button type="button"
                                            class="mcm-primary"
                                            disabled="@(!Vm.CanActOnQuarantine)"
                                            title="Skip this mod on future installs of this same pack file."
                                            @onclick="() => Vm.KeepExcludedAsync(entry)">
                                        Keep excluded
                                    </button>
                                    <button type="button"
                                            disabled="@(!Vm.CanActOnQuarantine)"
                                            title="Move the jar back into mods/ and restart Minecraft."
                                            @onclick="() => Vm.PutBackAsync(entry)">
                                        Put back
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    <div class="mcm-mods-advanced">
                        <div class="mcm-mods-advanced-head">
                            <span class="mcm-mods-advanced-title">Advanced</span>
                            <div class="mcm-server-actions">
                                <button type="button"
                                        disabled="@(!Vm.CanUploadMod)"
                                        title="@Vm.UploadModTitle"
                                        @onclick="Vm.UploadModAsync">
                                    <i class="ti ti-upload" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                                    Add jar
                                </button>
                                <button type="button"
                                        disabled="@Vm.AnyBusy"
                                        title="List server-side mods on the game VM. Requires the VM running."
                                        @onclick="Vm.RefreshLiveModsAsync">
                                    <i class="ti ti-refresh" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                                    Refresh list
                                </button>
                            </div>
                        </div>
                        <aside class="mcm-pack-list-warning" role="note">
                            <p>@Vm.AdvancedJarWarning</p>
                        </aside>
                        <details class="mcm-expander">
                            <summary>
                                <span class="mcm-expander-title">@ModListSummary</span>
                            </summary>
                            @if (Vm.ModFiles.Count > 0)
                            {
                                <div class="mcm-mod-list mcm-slim-scroll">
                                    @foreach (var name in Vm.ModFiles)
                                    {
                                        <div class="mcm-mod-row" style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
                                            <span>@name</span>
                                            @if (Vm.IsSafeModJarName(name))
                                            {
                                                <button type="button"
                                                        disabled="@(!Vm.CanUploadMod)"
                                                        title="Delete this mod jar and restart Minecraft."
                                                        @onclick="() => Vm.DeleteModAsync(name)">
                                                    Delete
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="mcm-expander-empty">Refresh list to load server-side mods. Requires the VM running.</p>
                            }
                        </details>
                    </div>
                </div>
            }
        </div>
    }
    else if (IsPane("plugins") && Vm.ShowPluginsTab)
    {
        <div class="mcm-section-card"
             id="mcm-server-pane-plugins"
             role="tabpanel"
             aria-labelledby="mcm-server-tab-plugins">
            <div class="mcm-server-pane-head">
                <div class="mcm-server-pane-title">
                    <span>Plugins</span>
                    <button type="button"
                            class="mcm-help"
                            title="@Vm.PluginsHelpTitle">
                        <i class="ti ti-help" aria-hidden="true"></i>
                        <span class="sr-only">About Plugins</span>
                    </button>
                </div>
                <div class="mcm-server-actions">
                    <button type="button"
                            disabled="@(!Vm.CanUploadPlugin)"
                            title="@Vm.UploadPluginTitle"
                            @onclick="Vm.UploadPluginAsync">
                        <i class="ti ti-upload" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                        Upload plugin
                    </button>
                    <button type="button"
                            disabled="@Vm.AnyBusy"
                            title="List Paper plugins on the game VM. Requires the VM running."
                            @onclick="Vm.RefreshLivePluginsAsync">
                        <i class="ti ti-refresh" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                        Refresh list
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Vm.ModdingHint))
            {
                <p style="margin:0 0 8px;font-size:13px;color:var(--text-muted);">@Vm.ModdingHint</p>
            }
            else if (Vm.PluginFiles.Count == 0)
            {
                <p style="margin:0 0 8px;font-size:13px;color:var(--text-muted);">@Vm.VanillaEmptyState</p>
            }
            <details class="mcm-expander">
                <summary>
                    <span class="mcm-expander-title">@PluginListSummary</span>
                </summary>
                @if (Vm.PluginFiles.Count > 0)
                {
                    <div class="mcm-mod-list mcm-slim-scroll">
                        @foreach (var name in Vm.PluginFiles)
                        {
                            <div class="mcm-mod-row" style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
                                <span>@name</span>
                                <button type="button"
                                        disabled="@(!Vm.CanUploadPlugin)"
                                        title="Delete this plugin jar and restart Minecraft."
                                        @onclick="() => Vm.DeletePluginAsync(name)">
                                    Delete
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="mcm-expander-empty">Refresh list to load Paper plugins. Requires the VM running.</p>
                }
            </details>
        </div>
    }
</div>

@if (Vm.ChangeType.ModalOpen)
{
    <div class="mcm-modal-overlay open"
         role="dialog"
         aria-modal="true"
         aria-labelledby="mcm-change-type-title"
         tabindex="-1"
         @onclick="OnChangeTypeOverlayClick"
         @onkeydown="OnChangeTypeKeyDown">
        <div class="mcm-modal-card is-wide mcm-change-type-card" @onclick:stopPropagation="true">
            <h2 id="mcm-change-type-title" class="mcm-modal-title">@ChangeServerTypeUx.ModalTitle</h2>
            <p class="mcm-settings-note">
                Now @Vm.ChangeType.CurrentKindLabel · Minecraft @Vm.ChangeType.CurrentVersionLabel.
            </p>
            <fieldset class="mcm-wizard-fieldset" style="margin:10px 0 8px;border:0;padding:0;">
                <legend class="sr-only">Server type</legend>
                <div class="mcm-radio-row @(Vm.ChangeType.TargetChoice == ChangeServerTypeUx.ChoiceDefaultVanilla ? "is-selected" : null)">
                    <label class="mcm-check-hit">
                        <input type="radio"
                               name="mcm-change-type"
                               disabled="@Vm.ChangeType.IsBusy"
                               checked="@(Vm.ChangeType.TargetChoice == ChangeServerTypeUx.ChoiceDefaultVanilla)"
                               @onchange="@(() => Vm.ChangeType.TargetChoice = ChangeServerTypeUx.ChoiceDefaultVanilla)" />
                        <span>@ChangeServerTypeUx.LabelDefaultVanilla</span>
                    </label>
                    <WizardHelp Title="@Vm.ChangeType.DefaultVanillaHelp" AriaLabel="About Default Vanilla" />
                </div>
                <div class="mcm-radio-row @(Vm.ChangeType.IsPaperTarget ? "is-selected" : null)">
                    <label class="mcm-check-hit">
                        <input type="radio"
                               name="mcm-change-type"
                               disabled="@Vm.ChangeType.IsBusy"
                               checked="@Vm.ChangeType.IsPaperTarget"
                               @onchange="@(() => Vm.ChangeType.TargetChoice = ChangeServerTypeUx.ChoicePaper)" />
                        <span>@ChangeServerTypeUx.LabelPaper</span>
                    </label>
                    <WizardHelp Title="@Vm.ChangeType.PaperHelp" AriaLabel="About Paper" />
                </div>
                <div class="mcm-radio-row @(Vm.ChangeType.IsModdedTarget ? "is-selected" : null)">
                    <label class="mcm-check-hit">
                        <input type="radio"
                               name="mcm-change-type"
                               disabled="@Vm.ChangeType.IsBusy"
                               checked="@Vm.ChangeType.IsModdedTarget"
                               @onchange="@(() => Vm.ChangeType.TargetChoice = ChangeServerTypeUx.ChoiceModded)" />
                        <span>@ChangeServerTypeUx.LabelModded</span>
                    </label>
                    <WizardHelp Title="@Vm.ChangeType.ModdedHelp" AriaLabel="About Modded" />
                </div>
            </fieldset>
            @if (Vm.ChangeType.ShowVersionDropdown)
            {
                @if (Vm.ChangeType.ShowSnapshotToggle)
                {
                    <label class="mcm-checkbox-row">
                        <input type="checkbox"
                               disabled="@Vm.ChangeType.IsBusy"
                               @bind="Vm.ChangeType.IncludeSnapshots" />
                        <span>Advanced: include snapshots</span>
                    </label>
                }
                <div class="mcm-field">
                    <label for="mcm-change-type-version">Minecraft version</label>
                    <select id="mcm-change-type-version"
                            disabled="@(Vm.ChangeType.IsBusy || Vm.ChangeType.VersionIds.Count == 0)"
                            @bind="Vm.ChangeType.MinecraftVersion">
                        @if (!string.IsNullOrWhiteSpace(Vm.ChangeType.MinecraftVersion)
                             && !Vm.ChangeType.VersionIds.Contains(Vm.ChangeType.MinecraftVersion))
                        {
                            <option value="@Vm.ChangeType.MinecraftVersion">@Vm.ChangeType.MinecraftVersion</option>
                        }
                        @foreach (var id in Vm.ChangeType.VersionIds)
                        {
                            <option value="@id">@id</option>
                        }
                    </select>
                </div>
                <p class="mcm-wizard-hint">@Vm.ChangeType.VersionCatalogNotes</p>
            }
            @if (Vm.ChangeType.ShowPackDrop)
            {
                <p class="mcm-wizard-hint">Minecraft version comes from the pack.</p>
                <div class="mcm-pack-drop @(Vm.ChangeType.IsAnalyzingPack ? "is-busy" : "")"
                     aria-label="@PackReplaceUx.DropTitle">
                    <InputFile class="mcm-pack-drop-input"
                               OnChange="OnChangeTypePackInputAsync"
                               accept=".mrpack,.zip"
                               disabled="@(Vm.ChangeType.IsBusy || Vm.ChangeType.IsAnalyzingPack)" />
                    <i class="ti ti-file-zip" aria-hidden="true"></i>
                    <p class="mcm-pack-drop-title">@PackReplaceUx.DropTitle</p>
                    <p class="mcm-change-pack-drop-sub">@PackReplaceUx.DropFormats</p>
                </div>
                <div class="mcm-wizard-actions" style="margin:8px 0;">
                    <button type="button"
                            disabled="@(Vm.ChangeType.IsBusy || Vm.ChangeType.IsAnalyzingPack)"
                            @onclick="Vm.ChangeType.PickPackAsync">
                        Choose pack file…
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(Vm.ChangeType.PackBlockReason))
                {
                    <p class="mcm-settings-error">@Vm.ChangeType.PackBlockReason</p>
                }
                @if (Vm.ChangeType.ShowPackChecks)
                {
                    <pre class="mcm-wizard-log mcm-wizard-mono mcm-slim-scroll mcm-pack-summary">@Vm.ChangeType.PackSummary</pre>
                    <label class="mcm-checkbox-row">
                        <input type="checkbox"
                               disabled="@Vm.ChangeType.IsBusy"
                               @bind="Vm.ChangeType.PackConfirmed" />
                        <span>@Vm.ChangeType.PackConfirmLabel</span>
                    </label>
                }
                @if (Vm.ChangeType.ShowReviewOnMods)
                {
                    <p class="mcm-prefix-warn">@ChangeServerTypeUx.PackNeedsReview</p>
                    <button type="button"
                            disabled="@Vm.ChangeType.IsBusy"
                            @onclick="ReviewPackOnModsAsync">
                        Review on Mods
                    </button>
                }
            }
            <label class="mcm-checkbox-row">
                <input type="checkbox"
                       disabled="@Vm.ChangeType.IsBusy"
                       @bind="Vm.ChangeType.WipeWorld" />
                <span>@Vm.ChangeType.WipeWorldLabel</span>
            </label>
            @if (Vm.ChangeType.ShowDirectionWarning || Vm.ChangeType.ShowSaveCompatibilityWarning)
            {
                <div class="mcm-change-pack-warnings">
                    @if (Vm.ChangeType.ShowDirectionWarning)
                    {
                        <aside class="mcm-pack-list-warning" role="status">
                            <p>@Vm.ChangeType.DirectionWarning</p>
                        </aside>
                    }
                    @if (Vm.ChangeType.ShowSaveCompatibilityWarning)
                    {
                        <aside class="mcm-pack-list-warning" role="status">
                            <p>@Vm.ChangeType.SaveCompatibilityWarning</p>
                        </aside>
                    }
                </div>
            }
            <p class="mcm-settings-note">@Vm.ChangeType.ConfirmHint</p>
            @if (!string.IsNullOrWhiteSpace(Vm.ChangeType.StatusMessage))
            {
                <p style="margin:8px 0 0;font-size:13px;color:var(--text-secondary);white-space:pre-wrap;">@Vm.ChangeType.StatusMessage</p>
            }
            <div class="mcm-modal-actions">
                <button type="button"
                        disabled="@Vm.ChangeType.IsBusy"
                        @onclick="Vm.ChangeType.CloseModal">
                    Cancel
                </button>
                <button type="button"
                        class="mcm-primary"
                        disabled="@(!Vm.ChangeType.CanSubmit)"
                        title="@(Vm.ChangeType.CanSubmit ? Vm.ChangeType.ConfirmHint : Vm.ChangeType.SubmitDisabledReason)"
                        @onclick="Vm.ChangeType.ApplyAsync">
                    @ChangeServerTypeUx.PrimaryAction
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool IsPane(string id) => Vm.IsServerPane(id);

    private string PaneClass(string id) => IsPane(id) ? "is-active" : "";

    private void SelectPane(string pane) => Vm.SelectServerPane(pane);

    private bool ShowPackSummaryPre =>
        Vm.ShowPackSummary
        && !Vm.ShowPackAssistedReview
        && !string.IsNullOrWhiteSpace(Vm.PackSummary);

    private string ModListSummary
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Vm.ModdingSummary))
                return Vm.ModdingSummary;
            if (Vm.ModFiles.Count > 0)
                return $"{Vm.ModFiles.Count} server mods";
            return "Server mods";
        }
    }

    private string PluginListSummary
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Vm.ModdingSummary))
                return Vm.ModdingSummary;
            if (Vm.PluginFiles.Count > 0)
                return $"{Vm.PluginFiles.Count} plugins";
            return "Paper plugins";
        }
    }

    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnVmChanged;
        Vm.ChangeType.PropertyChanged += OnVmChanged;
        Vm.Backups.CollectionChanged += OnBackupsChanged;
        Vm.ModFiles.CollectionChanged += OnModsChanged;
        Vm.PluginFiles.CollectionChanged += OnPluginsChanged;
        Vm.ChatTemplates.CollectionChanged += OnChatChanged;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _ = Vm.EnsureOpenedAsync();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnVmChanged;
        Vm.ChangeType.PropertyChanged -= OnVmChanged;
        Vm.Backups.CollectionChanged -= OnBackupsChanged;
        Vm.ChatTemplates.CollectionChanged -= OnChatChanged;
        Vm.ModFiles.CollectionChanged -= OnModsChanged;
        Vm.PluginFiles.CollectionChanged -= OnPluginsChanged;
    }

    private Task OpenChangeTypeAsync() =>
        Vm.ChangeType.OpenAsync(Vm.CurrentServerKind, Vm.CurrentMinecraftVersion);

    private async Task ReviewPackOnModsAsync()
    {
        var path = Vm.ChangeType.PackPath;
        var wipe = Vm.ChangeType.WipeWorld;
        Vm.ChangeType.CloseModal();
        await Vm.HandoffChangePackAsync(path, wipe);
    }

    private void OnChangeTypeOverlayClick()
    {
        if (!Vm.ChangeType.IsBusy)
            Vm.ChangeType.CloseModal();
    }

    private void OnChangeTypeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !Vm.ChangeType.IsBusy)
            Vm.ChangeType.CloseModal();
    }

    private async Task OnChangeTypePackInputAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        try
        {
            await using var stream = file.OpenReadStream(PackReplaceUx.PackDropMaxBytes);
            await Vm.ChangeType.ImportDroppedPackAsync(file.Name, stream);
        }
        catch (IOException ex)
        {
            Vm.ChangeType.StatusMessage = "Could not read the dropped file. Use Choose pack file. " + ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            Vm.ChangeType.StatusMessage = "Drop failed. Use Choose pack file. " + ex.Message;
        }
    }

    private async Task OnPackInputAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        try
        {
            await using var stream = file.OpenReadStream(PackReplaceUx.PackDropMaxBytes);
            await Vm.ImportDroppedPackAsync(file.Name, stream);
        }
        catch (IOException ex)
        {
            Vm.StatusMessage = "Could not read the dropped file. Use Choose pack file. " + ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            Vm.StatusMessage = "Drop failed. Use Choose pack file. " + ex.Message;
        }
    }

    private void OnVmChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnBackupsChanged(object? sender, NotifyCollectionChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnModsChanged(object? sender, NotifyCollectionChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnPluginsChanged(object? sender, NotifyCollectionChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnChatChanged(object? sender, NotifyCollectionChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);
}
