@using McManager.Hybrid.Components.Tabs.Overview
@using McManager.Hybrid.Components.Tabs.Whitelist
@using McManager.Hybrid.Components.Tabs.Usage
@using McManager.Hybrid.Components.Tabs.ServerManagement
@using McManager.Hybrid.Components.Tabs.Console
@using McManager.Hybrid.Components.Tabs.Advanced
@using McManager.Hybrid.Components.Tabs.Troubleshooting
@inject MainViewModel Vm
@inject ChromeViewModel Chrome
@inject NotificationCenterViewModel Notices
@inject ActionBannerViewModel Banner
@inject ServerManagementViewModel Server
@inject IJSRuntime JS
@implements IDisposable

<div class="mcm-app mcm-app-manage @(ShowChangePackDockOverlay ? "has-progress-dock" : null) @(ShowChangePackDockOverlay && Server.ShowPackJobProgress ? "is-dock-busy" : null)">
    <CaptionBar>
        <AppActions>
            <div class="mcm-bell">
                <button type="button"
                        class="mcm-chrome-btn @(Notices.PanelOpen ? "is-open" : null)"
                        title="Notifications"
                        aria-label="@Notices.BellAriaLabel"
                        aria-haspopup="dialog"
                        aria-expanded="@(Notices.PanelOpen ? "true" : "false")"
                        aria-controls="mcm-notice-panel"
                        @onclick="ToggleBell"
                        @onclick:stopPropagation="true">
                    <i class="ti ti-bell" aria-hidden="true"></i>
                    @if (Notices.HasUnread)
                    {
                        <span class="mcm-bell-badge" aria-hidden="true"></span>
                    }
                </button>
                @if (Notices.PanelOpen)
                {
                    <div class="mcm-notice-panel"
                         id="mcm-notice-panel"
                         role="dialog"
                         aria-labelledby="mcm-notice-title"
                         tabindex="-1"
                         @ref="_noticePanel"
                         @onclick:stopPropagation="true"
                         @onkeydown="OnChromeKeyDown">
                        <div class="mcm-notice-head">
                            <h2 id="mcm-notice-title" class="mcm-notice-title">Notifications</h2>
                            @if (!Notices.IsEmpty)
                            {
                                <button type="button"
                                        class="mcm-notice-clear"
                                        @onclick="Notices.DismissAll">
                                    Dismiss all
                                </button>
                            }
                        </div>
                        @if (Notices.IsEmpty)
                        {
                            <p class="mcm-notice-empty">@NotificationCenterViewModel.EmptyState</p>
                        }
                        else
                        {
                            <ul class="mcm-notice-list mcm-slim-scroll">
                                @foreach (var item in Notices.Items)
                                {
                                    <li class="mcm-notice-item @NotificationCenterViewModel.SeverityClass(item)">
                                        <i class="@NotificationCenterViewModel.SeverityIcon(item)" aria-hidden="true"></i>
                                        <div class="mcm-notice-copy">
                                            <div class="mcm-notice-item-head">
                                                <span class="mcm-notice-item-title">@item.Title</span>
                                                <time class="mcm-notice-stamp" datetime="@item.CreatedAt.ToString("o")">
                                                    @NotificationCenterViewModel.FormatStamp(item)
                                                </time>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(item.Body))
                                            {
                                                <p class="mcm-notice-body">@item.Body</p>
                                            }
                                        </div>
                                        <button type="button"
                                                class="mcm-notice-dismiss"
                                                title="Dismiss"
                                                aria-label="Dismiss @item.Title"
                                                @onclick="@(() => Notices.Dismiss(item.Id))">
                                            <i class="ti ti-x" aria-hidden="true"></i>
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
            <button type="button"
                    class="mcm-chrome-btn"
                    title="Program settings"
                    aria-label="Program settings"
                    @onclick="OpenSettings">
                <i class="ti ti-settings" aria-hidden="true"></i>
            </button>
        </AppActions>
    </CaptionBar>

    <aside class="mcm-sidebar" aria-label="Server controls">
        <div class="mcm-sidebar-chrome">
        <section class="mcm-status-card" aria-label="Server status">
            <div class="mcm-srow">
                <span class="mcm-slabel">Status</span>
                <span class="mcm-sval @(StatusClass)" aria-live="polite">
                    <span class="mcm-dot @(StatusDotClass)" aria-hidden="true"></span>
                    @Vm.Status
                </span>
            </div>
            <div class="mcm-srow">
                <span class="mcm-slabel">Play IP</span>
                <span class="mcm-sval @(Vm.HasPlayIp ? null : "is-placeholder")">
                    <span class="mcm-play-ip">@Vm.PlayIp</span>
                    <button type="button"
                            class="mcm-copy-inline"
                            disabled="@(!Vm.HasPlayIp)"
                            title="@CopyPlayIpTitle"
                            aria-label="@CopyPlayIpTitle"
                            @onclick="Vm.CopyPlayIpAsync">
                        <i class="ti ti-copy" aria-hidden="true"></i>
                    </button>
                </span>
            </div>
            <div class="mcm-srow">
                <span class="mcm-slabel">Players</span>
                <span class="mcm-sval @(IsPlaceholder(Vm.PlayersDisplay) ? "is-placeholder" : null)">@Vm.PlayersDisplay</span>
            </div>
        </section>

        <div class="mcm-power-row">
            <span class="mcm-power-wrap mcm-power-wrap-primary" title="@Vm.PrimaryPowerToolTip">
                <button type="button"
                        class="@Vm.PrimaryPowerButtonClass"
                        disabled="@(!Vm.CanPrimaryPower)"
                        @onclick="Vm.PrimaryPowerAsync">
                    <i class="@Vm.PrimaryPowerIconClass" aria-hidden="true"></i>
                    @Vm.PrimaryPowerLabel
                </button>
            </span>
            <span class="mcm-power-wrap mcm-power-wrap-restart" title="@Vm.RestartToolTip">
                <button type="button"
                        class="mcm-action-btn mcm-action-btn-restart"
                        disabled="@(!Vm.CanRestart)"
                        @onclick="Vm.RestartAsync">
                    <i class="ti ti-refresh" aria-hidden="true"></i>
                    @Vm.RestartButtonLabel
                </button>
            </span>
        </div>
        </div>

        <div class="mcm-pins-slot">
            <div class="mcm-pins">
            <div class="mcm-statcard">
                <div class="mcm-stat-label">
                    <span class="mcm-stat-label-text">Today's uptime</span>
                    <button type="button" class="mcm-help" title="@Vm.PinTodayHelp">
                        <i class="ti ti-help" aria-hidden="true"></i>
                        <span class="sr-only">About today's uptime</span>
                    </button>
                </div>
                <div class="mcm-stat-line">
                    <span class="mcm-stat-value @(IsPlaceholder(Vm.PinTodayValue) ? "is-placeholder" : null)">@Vm.PinTodayValue</span>
                    @if (!string.IsNullOrWhiteSpace(Vm.PinTodayHint))
                    {
                        <span class="mcm-stat-hint">@Vm.PinTodayHint</span>
                    }
                </div>
                <div class="mcm-mini-bar" aria-hidden="true">
                    <div class="mcm-mini-bar-fill" style="width: @ToPercent(Vm.PinTodayFraction)"></div>
                </div>
            </div>
            <div class="mcm-statcard">
                <div class="mcm-stat-label">
                    <span class="mcm-stat-label-text">This month</span>
                    <button type="button" class="mcm-help" title="@Vm.PinMonthHelp">
                        <i class="ti ti-help" aria-hidden="true"></i>
                        <span class="sr-only">About this month</span>
                    </button>
                </div>
                <div class="mcm-stat-line">
                    <span class="mcm-stat-value @(IsPlaceholder(Vm.PinMonthValue) ? "is-placeholder" : null)">@Vm.PinMonthValue</span>
                </div>
                <div class="mcm-mini-bar" aria-hidden="true">
                    <div class="mcm-mini-bar-fill" style="width: @ToPercent(Vm.PinMonthFraction)"></div>
                </div>
            </div>
            <div class="mcm-statcard">
                <div class="mcm-stat-label">
                    <span class="mcm-stat-label-text">Rollover bank</span>
                    <button type="button" class="mcm-help" title="@Vm.PinRolloverHelp">
                        <i class="ti ti-help" aria-hidden="true"></i>
                        <span class="sr-only">About rollover bank</span>
                    </button>
                </div>
                <div class="mcm-stat-line">
                    <span class="mcm-stat-value @(RolloverValueClass)">@Vm.PinRolloverValue</span>
                </div>
            </div>
            </div>
            <div class="mcm-sidebar-gap" aria-hidden="true"></div>
        </div>

        <nav class="mcm-tabs" role="tablist" aria-label="Manager sections" aria-orientation="vertical">
            <div class="mcm-tab-stack">
            <button type="button"
                    role="tab"
                    class="mcm-tab @TabClass("overview")"
                    aria-selected="@(IsTab("overview") ? "true" : "false")"
                    @onclick="@(() => SelectTabAsync("overview"))">
                <i class="ti ti-layout-dashboard" aria-hidden="true"></i>
                Overview
            </button>
            <div class="mcm-tab-gap" aria-hidden="true"></div>
            <button type="button"
                    role="tab"
                    class="mcm-tab @TabClass("whitelist")"
                    aria-selected="@(IsTab("whitelist") ? "true" : "false")"
                    @onclick="@(() => SelectTabAsync("whitelist"))">
                <i class="ti ti-list-check" aria-hidden="true"></i>
                Whitelist
            </button>
            <div class="mcm-tab-gap" aria-hidden="true"></div>
            <button type="button"
                    role="tab"
                    class="mcm-tab @TabClass("server")"
                    aria-selected="@(IsTab("server") ? "true" : "false")"
                    @onclick="@(() => SelectTabAsync("server"))">
                <i class="ti ti-server" aria-hidden="true"></i>
                Server
            </button>
            <div class="mcm-tab-gap" aria-hidden="true"></div>
            <button type="button"
                    role="tab"
                    class="mcm-tab @TabClass("console")"
                    aria-selected="@(IsTab("console") ? "true" : "false")"
                    @onclick="@(() => SelectTabAsync("console"))">
                <i class="ti ti-terminal-2" aria-hidden="true"></i>
                Console
            </button>
            <div class="mcm-tab-gap" aria-hidden="true"></div>
            <button type="button"
                    role="tab"
                    class="mcm-tab @TabClass("usage")"
                    aria-selected="@(IsTab("usage") ? "true" : "false")"
                    @onclick="@(() => SelectTabAsync("usage"))">
                <i class="ti ti-chart-bar" aria-hidden="true"></i>
                Usage
            </button>
            <div class="mcm-tab-gap" aria-hidden="true"></div>
            <button type="button"
                    role="tab"
                    class="mcm-tab @TabClass("advanced")"
                    aria-selected="@(IsTab("advanced") ? "true" : "false")"
                    @onclick="@(() => SelectTabAsync("advanced"))">
                <i class="ti ti-adjustments-horizontal" aria-hidden="true"></i>
                Advanced
            </button>
            <div class="mcm-tab-gap" aria-hidden="true"></div>
            <button type="button"
                    role="tab"
                    class="mcm-tab @TabClass("troubleshooting")"
                    aria-selected="@(IsTab("troubleshooting") ? "true" : "false")"
                    @onclick="@(() => SelectTabAsync("troubleshooting"))">
                <i class="ti ti-tool" aria-hidden="true"></i>
                Troubleshooting
            </button>
            <div class="mcm-tab-gap" aria-hidden="true"></div>
            <button type="button"
                    role="tab"
                    class="mcm-tab @TabClass("about")"
                    aria-selected="@(IsTab("about") ? "true" : "false")"
                    @onclick="@(() => SelectTabAsync("about"))">
                <i class="ti ti-info-circle" aria-hidden="true"></i>
                About
            </button>
            </div>
            <div class="mcm-tab-rest" aria-hidden="true"></div>
        </nav>
    </aside>

    <main @ref="_tabBody"
          class="mcm-tab-body mcm-slim-scroll @(IsTab("console") ? "is-console" : null)"
          role="tabpanel">
        <div class="mcm-tab-body-inner">
            @if (!IsTab("server"))
            {
                @switch (_tab)
                {
                    case "overview":
                        <OverviewTab OnOpenTab="SelectTabAsync" />
                        break;
                    case "about":
                        <div class="mcm-about">
                            <h2 class="mcm-about-name">@Chrome.AppName</h2>
                            <p class="mcm-about-version">Version @Chrome.AppVersion</p>
                            <p class="mcm-about-lede">A Windows app for a private Minecraft server on Oracle Always Free. Friends connect to one play IP. Access is an IP allowlist — this is not a public server.</p>
                            <div class="mcm-about-actions">
                                <button type="button"
                                        class="mcm-primary"
                                        title="Open the MC Manager source repository"
                                        @onclick="Chrome.OpenGitHub">
                                    <i class="ti ti-brand-github" aria-hidden="true"></i>
                                    Source on GitHub
                                </button>
                            </div>
                        </div>
                        break;
                    case "usage":
                        <UsageTab />
                        break;
                    case "console":
                        <ConsoleTab />
                        break;
                    case "advanced":
                        <AdvancedTab />
                        break;
                    case "troubleshooting":
                        <TroubleshootingTab />
                        break;
                    default:
                        <WhitelistTab />
                        break;
                }
            }
            @if (_serverTabCreated)
            {
                <div class="mcm-tab-keep" hidden="@(!IsTab("server"))">
                    <ServerManagementTab />
                </div>
            }
        </div>
    </main>

    <ProgressDock IsOpen="@ShowChangePackDockOverlay"
                  AnimateEnter="true"
                  AriaLabel="Change pack"
                  Status="@Server.DockStatus"
                  ShowProgress="@Server.ShowPackJobProgress"
                  Indeterminate="true"
                  ElapsedDisplay="@(Server.ShowPackElapsed ? Server.PackElapsedDisplay : null)">
        <button type="button"
                disabled="@(Server.AnyBusy)"
                title="Close Change pack without installing."
                @onclick="Server.CancelChangePack">
            Cancel
        </button>
        @if (Server.ShowPackConfirmChecks)
        {
            <button type="button"
                    class="mcm-primary"
                    disabled="@(!Server.CanInstallPack)"
                    title="@Server.InstallPackTitle"
                    @onclick="Server.InstallPackReplaceAsync">
                Install this pack
            </button>
        }
    </ProgressDock>

    @if (Banner.IsVisible)
    {
        <div class="mcm-action-banner @Banner.SeverityClass @(Banner.IsLeaving ? "is-leaving" : null)"
             role="@Banner.LiveRole"
             aria-live="@Banner.AriaLive">
            <div class="mcm-action-banner-inner">
                <i class="@Banner.SeverityIcon mcm-action-banner-icon" aria-hidden="true"></i>
                <span class="sr-only">@Banner.SeverityName</span>
                <p class="mcm-action-banner-copy mcm-slim-scroll">@Banner.Message</p>
                <button type="button"
                        class="mcm-action-banner-dismiss"
                        title="Dismiss"
                        aria-label="Dismiss"
                        @onclick="Banner.Dismiss">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    }

    @if (Notices.PanelOpen)
    {
        <div class="mcm-overflow-catch"
             @onclick="CloseFlyouts"
             @onkeydown="OnChromeKeyDown"></div>
    }

    @if (Chrome.SettingsOpen)
    {
        <div class="mcm-modal-overlay open"
             role="dialog"
             aria-modal="true"
             aria-labelledby="mcm-settings-title"
             tabindex="-1"
             @ref="_chromeOverlay"
             @onclick="CloseSettings"
             @onkeydown="OnChromeKeyDown">
            <div class="mcm-modal-card is-wide mcm-settings-card" @onclick:stopPropagation="true">
                <h2 id="mcm-settings-title" class="mcm-modal-title">Program settings</h2>
                <p class="mcm-modal-body">These are settings for this PC, not the Minecraft server.</p>

                <div class="mcm-settings-section">
                    <h3 class="mcm-settings-heading">Paths</h3>
                    @if (Chrome.HasConfigDirOverride)
                    {
                        <p class="mcm-settings-note">Data folder is overridden by MCMANAGER_CONFIG_DIR.</p>
                    }
                    <ul class="mcm-path-list">
                        @foreach (var row in Chrome.Paths)
                        {
                            <li class="mcm-path-row">
                                <div class="mcm-path-copy">
                                    <span class="mcm-path-label">@row.Label</span>
                                    <span class="mcm-path-hint">@row.Hint</span>
                                    <code class="mcm-path-value @(row.Exists ? null : "is-missing")">
                                        @(string.IsNullOrWhiteSpace(row.Path) ? "—" : row.Path)
                                    </code>
                                </div>
                                <div class="mcm-path-actions">
                                    <button type="button"
                                            disabled="@(string.IsNullOrWhiteSpace(row.Path))"
                                            title="Copy path"
                                            @onclick="@(() => Chrome.CopyPathAsync(row.Id))">
                                        Copy
                                    </button>
                                    <button type="button"
                                            disabled="@(string.IsNullOrWhiteSpace(row.Path))"
                                            title="Open in File Explorer"
                                            @onclick="@(() => Chrome.OpenPath(row.Id))">
                                        Open
                                    </button>
                                </div>
                            </li>
                        }
                    </ul>
                    @if (!string.IsNullOrWhiteSpace(Chrome.CopyFeedback))
                    {
                        <p class="mcm-settings-note" role="status">@Chrome.CopyFeedback</p>
                    }
                </div>

                <div class="mcm-settings-section">
                    <h3 class="mcm-settings-heading">Updates</h3>
                    <label class="mcm-checkbox-row" style="margin:0;" for="mcm-check-updates">
                        <input id="mcm-check-updates"
                               type="checkbox"
                               @bind="Chrome.CheckForUpdates" />
                        Check for updates when Manager opens
                    </label>
                    <p class="mcm-settings-note">When this is on, Manager asks GitHub Releases once as it opens. If a newer version is published, you get the release notes and a download link. Manager never installs an update by itself.</p>
                    @if (!string.IsNullOrWhiteSpace(Chrome.SaveError))
                    {
                        <p class="mcm-settings-error" role="alert">@Chrome.SaveError</p>
                    }
                </div>

                <div class="mcm-modal-actions">
                    <button type="button" class="mcm-primary" @onclick="CloseSettings">Close</button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private string _tab = "overview";
    private bool _serverTabCreated;
    private ElementReference _chromeOverlay;
    private ElementReference _noticePanel;
    private ElementReference _tabBody;
    private bool _noticeFocusPending;
    private bool _tabScrollRestorePending;
    private readonly Dictionary<string, double> _tabScrollPositions = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnVmChanged;
        Chrome.PropertyChanged += OnVmChanged;
        Notices.PropertyChanged += OnVmChanged;
        Banner.PropertyChanged += OnVmChanged;
        Server.PropertyChanged += OnVmChanged;
        Vm.StartChrome();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (_tabScrollRestorePending)
            {
                _tabScrollRestorePending = false;
                var top = _tabScrollPositions.TryGetValue(_tab, out var saved) ? saved : 0;
                await JS.InvokeVoidAsync("mcmTabScroll.set", _tabBody, top);
            }

            if (Chrome.SettingsOpen)
            {
                await _chromeOverlay.FocusAsync();
            }
            else if (_noticeFocusPending && Notices.PanelOpen)
            {
                _noticeFocusPending = false;
                await _noticePanel.FocusAsync();
            }
        }
        catch (InvalidOperationException)
        {
            // Element not in the tree yet.
        }
        catch (JSException)
        {
            // Helper missing in a test host.
        }
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnVmChanged;
        Chrome.PropertyChanged -= OnVmChanged;
        Notices.PropertyChanged -= OnVmChanged;
        Banner.PropertyChanged -= OnVmChanged;
        Server.PropertyChanged -= OnVmChanged;
    }

    private void ToggleBell()
    {
        Chrome.ClosePanels();
        var opening = !Notices.PanelOpen;
        Notices.Toggle();
        if (opening && Notices.PanelOpen)
            _noticeFocusPending = true;
    }

    private void OpenSettings()
    {
        Notices.Close();
        Chrome.OpenSettings();
    }

    private void CloseSettings() => Chrome.CloseSettings();

    private void CloseFlyouts() => Notices.Close();

    private void OnChromeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
            return;
        Chrome.ClosePanels();
        Notices.Close();
        Banner.Dismiss();
    }

    private void OnVmChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private async Task SelectTabAsync(string tab)
    {
        if (IsTab(tab))
            return;

        try
        {
            var scrollTop = await JS.InvokeAsync<double>("mcmTabScroll.get", _tabBody);
            _tabScrollPositions[_tab] = scrollTop;
        }
        catch (InvalidOperationException)
        {
            // WebView not ready.
        }
        catch (JSException)
        {
            // Helper missing in a test host.
        }

        if (string.Equals(tab, "server", StringComparison.Ordinal))
            _serverTabCreated = true;

        _tab = tab;
        _tabScrollRestorePending = true;
    }

    private bool IsTab(string tab) => string.Equals(_tab, tab, StringComparison.Ordinal);

    private bool ShowChangePackDockOverlay =>
        Server.ShowChangePackDock(IsTab("server"));

    private string TabClass(string tab) => IsTab(tab) ? "is-active" : string.Empty;

    private string CopyPlayIpTitle =>
        !Vm.HasPlayIp
            ? "No play IP to copy."
            : string.Equals(Vm.CopyPlayIpLabel, "copied", StringComparison.Ordinal)
                ? "Play IP copied"
                : "Copy play IP";

    private static bool IsPlaceholder(string value) =>
        string.IsNullOrWhiteSpace(value) || value == MainViewModel.Placeholder;

    private string StatusClass
    {
        get
        {
            if (IsPlaceholder(Vm.Status))
                return "is-placeholder";
            if (Vm.StatusIsBusy)
                return "is-busy";
            return Vm.StatusIsRunning ? "is-running" : "is-stopped";
        }
    }

    private string StatusDotClass
    {
        get
        {
            if (IsPlaceholder(Vm.Status))
                return string.Empty;
            if (Vm.StatusIsBusy)
                return "is-busy";
            return Vm.StatusIsRunning ? "is-running" : "is-stopped";
        }
    }

    private string RolloverValueClass
    {
        get
        {
            if (IsPlaceholder(Vm.PinRolloverValue))
                return "is-placeholder";
            return Vm.PinRolloverPositive ? "is-positive" : string.Empty;
        }
    }

    private static string ToPercent(double fraction) =>
        $"{Math.Clamp(fraction, 0, 1) * 100:0.#}%";
}
