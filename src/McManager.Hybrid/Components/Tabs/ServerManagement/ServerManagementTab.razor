@inject ServerManagementViewModel Vm
@implements IDisposable

<div>
    <nav class="mcm-subtabs" role="tablist" aria-label="Server sections">
        <button type="button"
                role="tab"
                class="mcm-subtab @PaneClass("identity")"
                aria-selected="@(IsPane("identity") ? "true" : "false")"
                aria-controls="mcm-server-pane-identity"
                id="mcm-server-tab-identity"
                @onclick="@(() => SelectPane("identity"))">
            Identity
        </button>
        <button type="button"
                role="tab"
                class="mcm-subtab @PaneClass("world")"
                aria-selected="@(IsPane("world") ? "true" : "false")"
                aria-controls="mcm-server-pane-world"
                id="mcm-server-tab-world"
                @onclick="@(() => SelectPane("world"))">
            World
        </button>
        <button type="button"
                role="tab"
                class="mcm-subtab @PaneClass("modding")"
                aria-selected="@(IsPane("modding") ? "true" : "false")"
                aria-controls="mcm-server-pane-modding"
                id="mcm-server-tab-modding"
                @onclick="@(() => SelectPane("modding"))">
            Modding
        </button>
        <button type="button"
                role="tab"
                class="mcm-subtab @PaneClass("pack")"
                aria-selected="@(IsPane("pack") ? "true" : "false")"
                aria-controls="mcm-server-pane-pack"
                id="mcm-server-tab-pack"
                @onclick="@(() => SelectPane("pack"))">
            Change pack
        </button>
    </nav>

    @if (IsPane("identity"))
    {
        <div class="mcm-section-card"
             id="mcm-server-pane-identity"
             role="tabpanel"
             aria-labelledby="mcm-server-tab-identity">
            <div class="mcm-server-pane-head">
                <div class="mcm-server-pane-title">
                    <span>Name, icon, and messages</span>
                    <button type="button"
                            class="mcm-help"
                            title="@Vm.IdentityHelpTitle">
                        <i class="ti ti-help" aria-hidden="true"></i>
                        <span class="sr-only">About name, icon, and messages</span>
                    </button>
                </div>
                <button type="button"
                        class="mcm-primary"
                        disabled="@(!Vm.CanSaveIdentity)"
                        title="Writes the shared copy. Restart Minecraft (or Start) to apply name, icon, and chat lines."
                        @onclick="Vm.SaveIdentityAsync">
                    Save
                </button>
            </div>
            <p class="mcm-server-facts">
                        Minecraft @Vm.MinecraftVersionDisplay. Friends see the name, description, and in-game icon in their server list while the game is running. Highlight text in the name or description and use the toolbar to format the list MOTD, or paste a generator <code>motd=</code> string. Offline / starting / unavailable icons show on the doorbell while the server is off.
            </p>
            <div class="mcm-identity-grid">
                <div>
                    <MotdEditor IdPrefix="mcm-server"
                                Disabled="@Vm.AnyBusy"
                                @bind-ServerName="Vm.IdentityName"
                                @bind-Description="Vm.IdentityDescription" />
                </div>
                <div>
                    <ServerIconPreviewStrip ColorUrl="@Vm.IconPreviewDataUrl"
                                            IdleUrl="@Vm.IdleIconPreviewDataUrl"
                                            StartingUrl="@Vm.StartingIconPreviewDataUrl"
                                            ExhaustedUrl="@Vm.ExhaustedIconPreviewDataUrl" />
                    <div class="mcm-server-actions" style="align-items:center;">
                        <button type="button"
                                disabled="@Vm.AnyBusy"
                                title="Any PNG. Manager fits it to 64×64."
                                @onclick="Vm.PickIconAsync">
                            Choose icon
                        </button>
                        <button type="button"
                                disabled="@(!Vm.CanClearIcon)"
                                @onclick="Vm.ClearIcon">
                            Use default
                        </button>
                        <button type="button"
                                class="mcm-help"
                                title="@Vm.IconStatesHelp">
                            <i class="ti ti-help" aria-hidden="true"></i>
                            <span class="sr-only">About doorbell list icons</span>
                        </button>
                    </div>
                    <p style="margin:6px 0 0;font-size:12px;color:var(--text-muted);">PNG — fitted to 64×64</p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Vm.IdentityStatus))
            {
                <p style="margin:0 0 8px;font-size:13px;color:var(--text-secondary);white-space:pre-wrap;">@Vm.IdentityStatus</p>
            }
            <button type="button"
                    class="mcm-advanced-toggle"
                    @onclick="() => Vm.ShowChatTemplates = !Vm.ShowChatTemplates">
                @(Vm.ShowChatTemplates ? "Hide automated chat" : "Automated chat")
            </button>
            @if (Vm.ShowChatTemplates)
            {
                <p style="margin:0 0 10px;font-size:12px;color:var(--text-muted);">
                    These lines are sent in-game before an idle or budget stop. Keep the placeholders such as <code>{minutes}</code> if the line uses them.
                </p>
                <div class="mcm-chat-templates">
                    @foreach (var row in Vm.ChatTemplates)
                    {
                        <div class="mcm-field">
                            <label>
                                @row.Label
                                @if (!string.IsNullOrWhiteSpace(row.Placeholders))
                                {
                                    <span style="font-weight:400;color:var(--text-muted);"> @row.Placeholders</span>
                                }
                            </label>
                            <textarea rows="2"
                                      disabled="@Vm.AnyBusy"
                                      @bind="row.Text"
                                      @bind:event="oninput"></textarea>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (IsPane("world"))
    {
        <div class="mcm-section-card"
             id="mcm-server-pane-world"
             role="tabpanel"
             aria-labelledby="mcm-server-tab-world">
            <div class="mcm-server-pane-head">
                <div class="mcm-server-pane-title">
                    <span>World backups</span>
                    <button type="button"
                            class="mcm-help"
                            title="@Vm.WorldBackupsHelpTitle">
                        <i class="ti ti-help" aria-hidden="true"></i>
                        <span class="sr-only">About World backups</span>
                    </button>
                </div>
                <div class="mcm-server-actions">
                    <button type="button"
                            disabled="@Vm.AnyBusy"
                            title="Store a zip in cloud storage. This does not replace the live world until you use Replace."
                            @onclick="Vm.UploadAsync">
                        <i class="ti ti-upload" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                        Upload backup
                    </button>
                    <button type="button"
                            disabled="@Vm.AnyBusy"
                            title="@Vm.DownloadLatestTitle"
                            @onclick="Vm.DownloadLatestAsync">
                        <i class="ti ti-download" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                        @Vm.DownloadLatestButtonLabel
                    </button>
                    <button type="button"
                            class="mcm-danger-btn"
                            disabled="@Vm.AnyBusy"
                            title="Stops Minecraft, deletes the live world on the game VM, then starts it again. Cloud backups, mods, and server.properties stay. Requires the server running. Download a world save first if you might want this world back."
                            @onclick="Vm.WipeWorldAsync">
                        Wipe world
                    </button>
                    <button type="button"
                            disabled="@Vm.AnyBusy"
                            title="Requires the server to be running. Stops Minecraft, replaces the world, then starts it again."
                            @onclick="Vm.ReplaceWorldAsync">
                        Replace world
                    </button>
                </div>
            </div>
            <p class="mcm-server-facts">
                Last backup @Vm.LastBackupDisplay · Backup storage @Vm.BackupStorageDisplay
            </p>

            @if (!string.IsNullOrWhiteSpace(Vm.OversizedBanner))
            {
                <div class="mcm-oversized-banner" role="status">
                    <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                    <p>@Vm.OversizedBanner</p>
                </div>
            }

            <div class="mcm-bk-list mcm-slim-scroll">
                @foreach (var backup in Vm.Backups)
                {
                    <div class="mcm-bk-row">
                        <div>
                            <div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@backup.FileName</div>
                            <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">@backup.TimeDisplayLocal</div>
                        </div>
                        <div style="color:var(--text-muted);">@backup.SizeDisplay</div>
                        <div class="mcm-bk-actions">
                            <button type="button"
                                    style="font-size:12px;padding:3px 8px;"
                                    disabled="@Vm.AnyBusy"
                                    @onclick="@(() => Vm.DownloadBackupAsync(backup))">
                                Download
                            </button>
                        </div>
                    </div>
                }
            </div>

            @if (Vm.HasObjectStorage && !string.IsNullOrWhiteSpace(Vm.SoftCapDisplay) && Vm.SoftCapDisplay != "—")
            {
                <p style="margin:10px 0 0;font-size:12px;color:var(--text-muted);">@Vm.SoftCapDisplay</p>
            }
            <p style="margin:12px 0 0;font-size:12px;color:var(--text-muted);">
                Replace and Wipe world need the server running. Wipe deletes only the live save — cloud backups stay. Download a world save first if you might want this world back. Upload while stopped only stores a zip — Start, then Replace to apply it. If a world is too large for cloud backup, Download latest copies the live world over SSH instead.
            </p>
        </div>
    }
    else if (IsPane("modding"))
    {
        <div class="mcm-section-card"
             id="mcm-server-pane-modding"
             role="tabpanel"
             aria-labelledby="mcm-server-tab-modding">
            <div class="mcm-server-pane-head">
                <div class="mcm-server-pane-title">
                    <span>Modding</span>
                    <button type="button"
                            class="mcm-help"
                            title="@Vm.ModdingHelpTitle">
                        <i class="ti ti-help" aria-hidden="true"></i>
                        <span class="sr-only">About Modding</span>
                    </button>
                </div>
                <div class="mcm-server-actions">
                    <button type="button"
                            disabled="@(!Vm.CanPickPack)"
                            title="@Vm.ChangePackTitle"
                            @onclick="OpenChangePack">
                        <i class="ti ti-package" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                        Change pack
                    </button>
                    @if (Vm.IsModdedServer)
                    {
                        <button type="button"
                                disabled="@(!Vm.CanDownloadPack)"
                                title="@Vm.DownloadPackTitle"
                                @onclick="Vm.DownloadPackAsync">
                            <i class="ti ti-download" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                            Download pack
                        </button>
                        <button type="button"
                                disabled="@Vm.AnyBusy"
                                title="List server-side mods on the game VM. Requires the VM running."
                                @onclick="Vm.RefreshLiveModsAsync">
                            <i class="ti ti-refresh" style="font-size:14px;vertical-align:-2px;margin-right:4px;" aria-hidden="true"></i>
                            Refresh list
                        </button>
                    }
                </div>
            </div>

            @if (!Vm.IsModdedServer)
            {
                <p style="margin:0;font-size:13px;color:var(--text-muted);">@Vm.VanillaEmptyState</p>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(Vm.PackIdentityDisplay))
                {
                    <p style="margin:0 0 8px;font-size:13px;">@Vm.PackIdentityDisplay</p>
                }
                @if (!Vm.HasLocalPackArchive)
                {
                    <p style="margin:0 0 8px;font-size:13px;color:var(--text-muted);">@Vm.MissingArchiveMessage</p>
                }
                @if (!string.IsNullOrWhiteSpace(Vm.ModdingHint))
                {
                    <p style="margin:0 0 8px;font-size:13px;color:var(--text-muted);">@Vm.ModdingHint</p>
                }
                @if (Vm.HasQuarantinedMods)
                {
                    <div class="mcm-pack-list-warning" role="status">
                        <p class="mcm-wizard-kicker">Set aside after a crash</p>
                        @foreach (var entry in Vm.QuarantinedMods)
                        {
                            <p>@Vm.FormatQuarantineCopy(entry)</p>
                            <div class="mcm-quarantine-actions">
                                <button type="button"
                                        class="mcm-primary"
                                        disabled="@(!Vm.CanActOnQuarantine)"
                                        title="Skip this mod on future installs of this same pack file."
                                        @onclick="() => Vm.KeepExcludedAsync(entry)">
                                    Keep excluded
                                </button>
                                <button type="button"
                                        disabled="@(!Vm.CanActOnQuarantine)"
                                        title="Move the jar back into mods/ and restart Minecraft."
                                        @onclick="() => Vm.PutBackAsync(entry)">
                                    Put back
                                </button>
                            </div>
                        }
                    </div>
                }
                <details class="mcm-expander">
                    <summary>
                        <span class="mcm-expander-title">@ModListSummary</span>
                    </summary>
                    @if (Vm.ModFiles.Count > 0)
                    {
                        <div class="mcm-mod-list mcm-slim-scroll">
                            @foreach (var name in Vm.ModFiles)
                            {
                                <div class="mcm-mod-row">@name</div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="mcm-expander-empty">Refresh list to load server-side mods. Requires the VM running.</p>
                    }
                </details>
            }
        </div>
    }
    else
    {
        <div class="mcm-section-card mcm-change-pack"
             id="mcm-server-pane-pack"
             role="tabpanel"
             aria-labelledby="mcm-server-tab-pack">
            <p class="mcm-change-pack-friends" role="note">@Vm.FriendsNeedOneLiner</p>
            <div class="mcm-change-pack-ingest">
                <div class="mcm-pack-drop @(Vm.IsAnalyzingPack ? "is-busy" : "")"
                     aria-label="@PackReplaceUx.DropTitle">
                    <InputFile class="mcm-pack-drop-input"
                               OnChange="OnPackInputAsync"
                               accept=".mrpack,.zip"
                               disabled="@(!Vm.CanPickPack || Vm.IsAnalyzingPack)" />
                    <i class="ti ti-file-zip" aria-hidden="true"></i>
                    <p class="mcm-pack-drop-title">@PackReplaceUx.DropTitle</p>
                    <p class="mcm-change-pack-drop-sub">@PackReplaceUx.DropFormats</p>
                    <p class="mcm-change-pack-drop-sub">@PackReplaceUx.DropLargeHint</p>
                </div>
                <div class="mcm-change-pack-ingest-actions">
                    <button type="button"
                            disabled="@(!Vm.CanPickPack || Vm.IsAnalyzingPack)"
                            title="@Vm.ChangePackTitle"
                            @onclick="Vm.PickPackAsync">
                        Choose pack file…
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Vm.PackFileNameDisplay))
                    {
                        <p class="mcm-wizard-hint mcm-wizard-mono mcm-change-pack-file">@Vm.PackFileNameDisplay</p>
                    }
                </div>
            </div>
            @if (Vm.ShowPackSummary)
            {
                @if (!string.IsNullOrWhiteSpace(Vm.PackBlockReason))
                {
                    <p class="mcm-wizard-error">@Vm.PackBlockReason</p>
                }
                @if (Vm.ShowOverrideListWarning || Vm.ShowSaveCompatibilityWarning)
                {
                    <div class="mcm-change-pack-warnings">
                        @if (Vm.ShowOverrideListWarning)
                        {
                            <aside class="mcm-pack-list-warning" role="status">
                                <p>@Vm.SkipWarningBody</p>
                            </aside>
                        }
                        @if (Vm.ShowSaveCompatibilityWarning)
                        {
                            <aside class="mcm-pack-list-warning" role="status">
                                <p>@Vm.SaveCompatibilityWarning</p>
                            </aside>
                        }
                    </div>
                }
            }
            @if (Vm.ShowPackIdentityFields)
            {
                <PackIdentityFields IdPrefix="change-pack"
                                    Disabled="@Vm.AnyBusy"
                                    @bind-MinecraftVersion="Vm.PackMinecraftVersion"
                                    @bind-Loader="Vm.PackLoader"
                                    @bind-LoaderVersion="Vm.PackLoaderVersion"
                                    @bind-JavaMajorText="Vm.PackJavaMajorText"
                                    ShowDetectionMismatch="@Vm.ShowDetectionMismatch"
                                    DetectionMismatchWarning="@Vm.DetectionMismatchWarning" />
            }
            @if (Vm.ShowPackAssistedReview)
            {
                <PackAssistedReviewPanel IdPrefix="change-pack"
                                         Disabled="@Vm.AnyBusy"
                                         Review="@Vm.AssistedReview"
                                         JarOrder="@Vm.PackJarOrder"
                                         FreezeBlockReason="@Vm.PackFreezeBlockReason"
                                         LooksLikeLauncherInstance="@Vm.PackLooksLikeLauncherInstance"
                                         IsSkipped="@Vm.IsOperatorSkipped"
                                         SkipChanged="Vm.OnAssistedSkipChanged" />
            }
            @if (ShowPackSummaryPre || Vm.ShowPackConfirmChecks)
            {
                <div class="mcm-change-pack-confirm @(ShowPackSummaryPre ? "" : "is-checks-only")">
                    @if (ShowPackSummaryPre)
                    {
                        <pre class="mcm-wizard-log mcm-wizard-mono mcm-slim-scroll mcm-pack-summary">@Vm.PackSummary</pre>
                    }
                    @if (Vm.ShowPackConfirmChecks)
                    {
                        <div class="mcm-change-pack-checks">
                            <label class="mcm-checkbox-row">
                                <input type="checkbox"
                                       disabled="@Vm.AnyBusy"
                                       @bind="Vm.PackConfirmed" />
                                <span>@Vm.PackConfirmLabel</span>
                            </label>
                            <label class="mcm-checkbox-row">
                                <input type="checkbox"
                                       disabled="@Vm.AnyBusy"
                                       @bind="Vm.ClientPackAcknowledged" />
                                <span>@Vm.ClientPackAckLabel</span>
                            </label>
                            <label class="mcm-checkbox-row">
                                <input type="checkbox"
                                       disabled="@Vm.AnyBusy"
                                       @bind="Vm.WipeWorld" />
                                <span>@Vm.WipeWorldLabel</span>
                            </label>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private bool IsPane(string id) => Vm.IsServerPane(id);

    private string PaneClass(string id) => IsPane(id) ? "is-active" : "";

    private void SelectPane(string pane) => Vm.SelectServerPane(pane);

    private void OpenChangePack() => SelectPane(ServerManagementViewModel.PaneChangePack);

    private bool ShowPackSummaryPre =>
        Vm.ShowPackSummary
        && !Vm.ShowPackAssistedReview
        && !string.IsNullOrWhiteSpace(Vm.PackSummary);

    private string ModListSummary
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Vm.ModdingSummary))
                return Vm.ModdingSummary;
            if (Vm.ModFiles.Count > 0)
                return $"{Vm.ModFiles.Count} server mods";
            return "Server mods";
        }
    }

    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnVmChanged;
        Vm.Backups.CollectionChanged += OnBackupsChanged;
        Vm.ModFiles.CollectionChanged += OnModsChanged;
        Vm.ChatTemplates.CollectionChanged += OnChatChanged;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _ = Vm.EnsureOpenedAsync();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnVmChanged;
        Vm.Backups.CollectionChanged -= OnBackupsChanged;
        Vm.ChatTemplates.CollectionChanged -= OnChatChanged;
        Vm.ModFiles.CollectionChanged -= OnModsChanged;
    }

    private async Task OnPackInputAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        try
        {
            await using var stream = file.OpenReadStream(PackReplaceUx.PackDropMaxBytes);
            await Vm.ImportDroppedPackAsync(file.Name, stream);
        }
        catch (IOException ex)
        {
            Vm.StatusMessage = "Could not read the dropped file. Use Choose pack file. " + ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            Vm.StatusMessage = "Drop failed. Use Choose pack file. " + ex.Message;
        }
    }

    private void OnVmChanged(object? sender, PropertyChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnBackupsChanged(object? sender, NotifyCollectionChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnModsChanged(object? sender, NotifyCollectionChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnChatChanged(object? sender, NotifyCollectionChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);
}
